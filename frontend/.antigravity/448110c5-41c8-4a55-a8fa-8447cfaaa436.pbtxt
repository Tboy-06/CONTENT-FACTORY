      target_content: "  // Workflow graph specification\n  const [nodes, setNodes] = useState<WorkflowNode[]>([]);\n  const [edges, setEdges] = useState<WorkflowEdge[]>([]);\n  const [isLoadingSpec, setIsLoadingSpec] = useState(true);\n\n  // Pan & Zoom\n  const [zoom, setZoom] = useState(0.88);\n  const [pan, setPan] = useState({ x: 30, y: 10 });\n  const [isPanning, setIsPanning] = useState(false);\n  const [startPan, setStartPan] = useState({ x: 0, y: 0 });\n\n  // Selected Node for NodeInspectorModal\n  const [inspectedNode, setInspectedNode] = useState<WorkflowNode | null>(null);\n\n  // Free Tier Reference Modal\n  const [isFreeTierModalOpen, setIsFreeTierModalOpen] = useState(false);\n\n  // Live Workflow Execution State\n  const [isExecutingWorkflow, setIsExecutingWorkflow] = useState(false);\n  const [executionMessage, setExecutionMessage] = useState<string | null>(null);\n\n  // Quick Chat / Prompt Drawer\n  const [quickPrompt, setQuickPrompt] = useState(\"AI Productivity Hacks\");\n  const [showPromptBar, setShowPromptBar] = useState(false);\n\n  // Workflow Active Toggle Switch\n  const [isWorkflowActive, setIsWorkflowActive] = useState(true);\n\n  // Fetch Workflow Graph Spec from backend\n  const fetchWorkflowSpec = async () => {\n    try {\n      const res = await fetch(\"/api/workflow/spec\");\n      if (res.ok) {\n        const data = await res.json();\n        setNodes(data.workflow.nodes || []);\n        setEdges(data.workflow.edges || []);\n      }\n    } catch (e) {\n      console.error(\"Failed to load workflow spec:\", e);\n    } finally {\n      setIsLoadingSpec(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchWorkflowSpec();\n  }, []);\n\n  // Run the full workflow execution with real backend pipeline\n  const handleExecuteWorkflow = async (nicheToRun?: string) => {\n    const targetNiche = nicheToRun || quickPrompt || selectedJob?.niche || \"AI Productivity Hacks\";\n    setIsExecutingWorkflow(true);\n    setExecutionMessage(`Executing pipeline for \"${targetNiche}\"...`);\n    try {\n      const res = await fetch(\"/api/workflow/run\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          niche: targetNiche,\n          triggerType: \"MANUAL_TEST\"\n        })\n      });\n      if (res.ok) {\n        const result = await res.json();\n        setExecutionMessage(`Execution successful (${(result.execution.durationMs / 1000).toFixed(2)}s). Job #${result.job.id} created!`);\n        if (result.job) {\n          onSelectJob(result.job);\n        }\n        setTimeout(() => setExecutionMessage(null), 5000);\n      }\n    } catch (e) {\n      console.error(\"Workflow execution error:\", e);\n      setExecutionMessage(\"Execution failed. Check backend logs.\");\n    } finally {\n      setIsExecutingWorkflow(false);\n    }\n  };"
      replacement_content: "  // Workflow graph specification\n  const [nodes, setNodes] = useState<WorkflowNode[]>(DEFAULT_WORKFLOW_NODES);\n  const [edges, setEdges] = useState<WorkflowEdge[]>(DEFAULT_WORKFLOW_EDGES);\n  const [isLoadingSpec, setIsLoadingSpec] = useState(true);\n\n  // Hover and Selection state for Node Functionality Under Canvas\n  const [hoveredNodeId, setHoveredNodeId] = useState<string | null>(null);\n  const [selectedNode, setSelectedNode] = useState<WorkflowNode | null>(\n    DEFAULT_WORKFLOW_NODES.find(n => n.id === \"node-voice-gen\") || DEFAULT_WORKFLOW_NODES[0]\n  );\n\n  // Bottom Dock state (Drawer under the canvas)\n  const [isBottomDockOpen, setIsBottomDockOpen] = useState(true);\n  const [dockHeight, setDockHeight] = useState(310);\n  const [executionSteps, setExecutionSteps] = useState<WorkflowExecutionStep[]>([]);\n\n  // Pan & Zoom with comfortable default view\n  const [zoom, setZoom] = useState(0.72);\n  const [pan, setPan] = useState({ x: 40, y: 30 });\n  const [isPanning, setIsPanning] = useState(false);\n  const [startPan, setStartPan] = useState({ x: 0, y: 0 });\n\n  // Selected Node for NodeInspectorModal\n  const [inspectedNode, setInspectedNode] = useState<WorkflowNode | null>(null);\n\n  // Free Tier Reference Modal\n  const [isFreeTierModalOpen, setIsFreeTierModalOpen] = useState(false);\n\n  // Live Workflow Execution State\n  const [isExecutingWorkflow, setIsExecutingWorkflow] = useState(false);\n  const [executionMessage, setExecutionMessage] = useState<string | null>(null);\n\n  // Quick Chat / Prompt Drawer\n  const [quickPrompt, setQuickPrompt] = useState(\"AI Productivity Hacks\");\n  const [showPromptBar, setShowPromptBar] = useState(false);\n\n  // Workflow Active Toggle Switch\n  const [isWorkflowActive, setIsWorkflowActive] = useState(true);\n\n  // Functional summary for node hover tooltips\n  const getNodeFunctionalitySummary = (node: WorkflowNode) => {\n    switch (node.id) {\n      case \"node-trigger\":\n        return \"Manual or Webhook trigger: Launches autonomous multi-agent video production pipeline.\";\n      case \"node-edit-fields\":\n        return \"Configures target niche, 9:16 vertical 1080x1920 constraints, and distribution platforms.\";\n      case \"node-ai-agent\":\n        return \"gemini-3.6-flash Director: Architect of viral 3-act retention loops and structured script JSON.\";\n      case \"node-model-gemini-flash\":\n        return \"Google AI Studio Free Tier (15 RPM / 1,500 RPD): Zero-cost high-speed script generation.\";\n      case \"node-think-prompt\":\n        return \"Director System Prompt: Enforces 0-3s hook, tension build, value reveal, and looping CTA.\";\n      case \"node-vault-memory\":\n        return \"SQLite window buffer: Enforces visual DNA consistency and references viral hook formulas.\";\n      case \"node-json-split\":\n        return \"Payload splitter: Dispatches parallel voice audio generation and visual storyboard prompts.\";\n      case \"node-voice-gen\":\n        return \"Edge-TTS (100% Free): Generates natural neural voice narration (en-US-AriaNeural) with SSML.\";\n      case \"node-image-prompt\":\n        return \"gemini-3.7-flash (10 RPM): Generates 4-shot cinematic storyboard prompts with lens specs.\";\n      case \"node-image-gen\":\n        return \"Pexels API (20,000 req/mo Free): Selects and retrieves 9:16 vertical 1080x1920 stock video cuts.\";\n      case \"node-merge\":\n        return \"Stream synchronization: Aligns narration duration with visual cuts for dynamic pacing.\";\n      case \"node-render-video\":\n        return \"FFmpeg local engine: Encodes 1080x1920 60FPS video, -14 LUFS loudness, and yellow subtitles.\";\n      case \"node-wait\":\n        return \"QC & HITL Gate: Verifies safe-zones, audio clipping, and originality score (98.4%).\";\n      case \"node-download\":\n        return \"Vault Packaging: Archives master MP4, narration MP3, SRT captions, and manifest JSON.\";\n      case \"node-upload\":\n        return \"Social Gateway: Uploads published video directly to YouTube Shorts and social schedules.\";\n      case \"node-subagent-research\":\n        return \"Research Agent: Dispatches YouTube Data API and Tavily search for viral topic intel.\";\n      case \"node-tool-youtube\":\n        return \"YouTube Data API v3 (10k units/day): Evaluates competitor views, retention benchmarks, and tags.\";\n      case \"node-tool-tavily\":\n        return \"Tavily Search: Extracts clean, structured markdown research citations for script writing.\";\n      case \"node-append-vault\":\n        return \"SQLite Vault Logger: Records job metadata, execution metrics, and cost tallies ($0.00).\";\n      case \"node-telegram-response\":\n        return \"Telegram Bot Dispatch: Pushes instant completion alert with direct video preview to mobile.\";\n      default:\n        return `${node.label}: ${node.subtitle || \"Autonomous pipeline component.\"}`;\n    }\n  };\n\n  // Fetch Workflow Graph Spec from backend\n  const fetchWorkflowSpec = async () => {\n    try {\n      const res = await fetch(\"/api/workflow/spec\");\n      if (res.ok) {\n        const data = await res.json();\n        const incomingNodes: WorkflowNode[] = data.workflow?.nodes || [];\n        // If incoming nodes have generous coordinates matching our spec, use them, otherwise use DEFAULT_WORKFLOW_NODES\n        if (incomingNodes.length > 0 && incomingNodes.some(n => n.id === \"node-trigger\" || n.id === \"node-ai-agent\")) {\n          const isCompressed = incomingNodes.some(n => n.id === \"node-edit-fields\" && n.x < 300);\n          if (isCompressed) {\n            setNodes(DEFAULT_WORKFLOW_NODES);\n            setEdges(DEFAULT_WORKFLOW_EDGES);\n          } else {\n            setNodes(incomingNodes);\n            setEdges(data.workflow.edges || DEFAULT_WORKFLOW_EDGES);\n          }\n        } else {\n          setNodes(DEFAULT_WORKFLOW_NODES);\n          setEdges(DEFAULT_WORKFLOW_EDGES);\n        }\n      } else {\n        setNodes(DEFAULT_WORKFLOW_NODES);\n        setEdges(DEFAULT_WORKFLOW_EDGES);\n      }\n    } catch (e) {\n      console.error(\"Failed to load workflow spec:\", e);\n      setNodes(DEFAULT_WORKFLOW_NODES);\n      setEdges(DEFAULT_WORKFLOW_EDGES);\n    } finally {\n      setIsLoadingSpec(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchWorkflowSpec();\n  }, []);\n\n  // Run the full workflow execution with real backend pipeline\n  const handleExecuteWorkflow = async (nicheToRun?: string) => {\n    const targetNiche = nicheToRun || quickPrompt || selectedJob?.niche || \"AI Productivity Hacks\";\n    setIsExecutingWorkflow(true);\n    setIsBottomDockOpen(true);\n    setExecutionMessage(`Executing autonomous pipeline for \"${targetNiche}\"...`);\n    try {\n      const res = await fetch(\"/api/workflow/run\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          niche: targetNiche,\n          triggerType: \"MANUAL_TEST\"\n        })\n      });\n      if (res.ok) {\n        const result = await res.json();\n        setExecutionMessage(`Execution successful (${(result.execution.durationMs / 1000).toFixed(2)}s). Job #${result.job.id} created!`);\n        if (result.execution?.steps) {\n          setExecutionSteps(result.execution.steps);\n        }\n        if (result.job) {\n          onSelectJob(result.job);\n        }\n        setTimeout(() => setExecutionMessage(null), 5000);\n      }\n    } catch (e) {\n      console.error(\"Workflow execution error:\", e);\n      setExecutionMessage(\"Execution failed. Check backend logs.\");\n    } finally {\n      setIsExecutingWorkflow(false);\n    }\n  };"
    }
