  file_change {
    absolute_path_uri: "file:///src/components/NodeInspectorModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  X, \n  Play, \n  CheckCircle2, \n  AlertCircle, \n  Copy, \n  Check, \n  ExternalLink, \n  Sliders, \n  Database, \n  Info, \n  Sparkles,\n  Zap,\n  Code,\n  Volume2,\n  Video\n} from \"lucide-react\";\nimport { WorkflowNode } from \"../types\";\n\ninterface NodeInspectorModalProps {\n  node: WorkflowNode | null;\n  onClose: () => void;\n}\n\nexport const NodeInspectorModal: React.FC<NodeInspectorModalProps> = ({\n  node,\n  onClose\n}) => {\n  const [activeTab, setActiveTab] = useState<\"params\" | \"freetier\" | \"test\" | \"json\">(\"test\");\n  const [isExecuting, setIsExecuting] = useState(false);\n  const [executionResult, setExecutionResult] = useState<any>(null);\n  const [copied, setCopied] = useState(false);\n  const [testQuery, setTestQuery] = useState(\"AI Productivity Hacks\");\n  const [testVoiceText, setTestVoiceText] = useState(\"Wait. If you think you know AI prompting, this 1 habit will break your brain.\");\n\n  if (!node) return null;\n\n  const handleExecuteNode = async () => {\n    setIsExecuting(true);\n    setExecutionResult(null);\n    try {\n      const res = await fetch(\"/api/tools/execute-node\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          nodeId: node.id,\n          params: {\n            niche: testQuery,\n            query: testQuery,\n            text: testVoiceText,\n            prompt: `Generate viral 3-act retention outline for short video on: \"${testQuery}\".`\n          }\n        })\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setExecutionResult(data);\n      }\n    } catch (e) {\n      console.error(\"Node execution error:\", e);\n    } finally {\n      setIsExecuting(false);\n    }\n  };\n\n  const handleCopyJson = () => {\n    navigator.clipboard.writeText(JSON.stringify(executionResult || node, null, 2));\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div \n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-150 select-none\"\n      onClick={onClose}\n    >\n      <div \n        className=\"bg-[#10141e] border border-[#232e42] rounded-2xl w-full max-w-4xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden text-slate-100 font-sans\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Modal Top Header (n8n node style) */}\n        <div className=\"px-6 py-4 border-b border-[#232e42] flex items-center justify-between bg-[#141a29]/70 shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-sky-400 font-bold\">\n              {node.name.slice(0, 2).toUpperCase()}\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h2 className=\"text-base font-bold text-white\">\n                  {node.label}\n                </h2>\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300\">\n                  {node.category}\n                </span>\n                {node.freeTierInfo?.isConfigured && (\n                  <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-medium flex items-center gap-1\">\n                    <CheckCircle2 className=\"w-3 h-3\" />\n                    Active\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-slate-400 font-mono\">\n                nodeId: {node.id} \342\200\242 {node.subtitle}\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"px-6 py-2 bg-[#0e1320] border-b border-[#1b2537] flex items-center gap-2 shrink-0\">\n          <button\n            onClick={() => setActiveTab(\"test\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n              activeTab === \"test\" ? \"bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Play className=\"w-3.5 h-3.5 fill-current\" />\n            Test Step (Live Output)\n          </button>\n          <button\n            onClick={() => setActiveTab(\"params\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n              activeTab === \"params\" ? \"bg-sky-500/15 text-sky-300 border border-sky-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Sliders className=\"w-3.5 h-3.5\" />\n            Parameters\n          </button>\n          {node.freeTierInfo && (\n            <button\n              onClick={() => setActiveTab(\"freetier\")}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n                activeTab === \"freetier\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n              }`}\n            >\n              <Zap className=\"w-3.5 h-3.5\" />\n              Free Tier Specs\n            </button>\n          )}\n          <button\n            onClick={() => setActiveTab(\"json\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n              activeTab === \"json\" ? \"bg-slate-700 text-white\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Code className=\"w-3.5 h-3.5\" />\n            Raw JSON\n          </button>\n        </div>\n\n        {/* Tab Body */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6\">\n          {/* TAB 1: TEST STEP / LIVE EXECUTION */}\n          {activeTab === \"test\" && (\n            <div className=\"space-y-4\">\n              <div className=\"p-4 rounded-xl bg-[#0b1019] border border-[#1b2537] space-y-3\">\n                <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                  <div>\n                    <h3 className=\"text-sm font-bold text-white\">\n                      Live Node Runner\n                    </h3>\n                    <p className=\"text-xs text-slate-400\">\n                      Execute this step using real backend functions, models, or cached intelligence.\n                    </p>\n                  </div>\n                  <button\n                    onClick={handleExecuteNode}\n                    disabled={isExecuting}\n                    className=\"px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold shadow-lg transition flex items-center gap-2 cursor-pointer disabled:opacity-50 shrink-0\"\n                  >\n                    <Play className={`w-3.5 h-3.5 fill-current ${isExecuting ? \"animate-pulse\" : \"\"}`} />\n                    {isExecuting ? \"Executing node...\" : \"Execute Step\"}\n                  </button>\n                </div>\n\n                {/* Optional input parameter overrides */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n                  <div>\n                    <label className=\"text-[11px] font-semibold text-slate-400 block mb-1\">\n                      Query / Niche Input:\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={testQuery}\n                      onChange={e => setTestQuery(e.target.value)}\n                      className=\"w-full bg-[#121927] border border-[#233148] rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-sky-500\"\n                      placeholder=\"e.g. AI Productivity Hacks\"\n                    />\n                  </div>\n\n                  {node.id.includes(\"edge-tts\") && (\n                    <div>\n                      <label className=\"text-[11px] font-semibold text-slate-400 block mb-1\">\n                        Speech Narration Text:\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={testVoiceText}\n                        onChange={e => setTestVoiceText(e.target.value)}\n                        className=\"w-full bg-[#121927] border border-[#233148] rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-sky-500\"\n                      />\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Execution Result Box */}\n              {executionResult ? (\n                <div className=\"border border-[#1f2b3e] rounded-xl overflow-hidden bg-[#0a0e17] space-y-3 p-4\">\n                  <div className=\"flex items-center justify-between border-b border-[#1b2537] pb-3\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n                      <span className=\"text-xs font-bold text-emerald-400 uppercase tracking-wider\">\n                        Execution Output (Status: {executionResult.status || \"SUCCESS\"})\n                      </span>\n                    </div>\n                    <button\n                      onClick={handleCopyJson}\n                      className=\"text-xs text-slate-400 hover:text-white flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-800 transition cursor-pointer\"\n                    >\n                      {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                      {copied ? \"Copied\" : \"Copy Payload\"}\n                    </button>\n                  </div>\n\n                  {/* Rich Preview if YouTube, Pexels, or Edge-TTS */}\n                  {executionResult.output?.trending_benchmark && (\n                    <div className=\"space-y-2\">\n                      <h4 className=\"text-xs font-semibold text-sky-400\">\n                        Real YouTube Video Intel:\n                      </h4>\n                      <div className=\"grid grid-cols-1 gap-2\">\n                        {executionResult.output.trending_benchmark.map((yt: any, idx: number) => (\n                          <div key={idx} className=\"p-2.5 rounded-lg bg-[#111724] border border-[#1e2738] flex items-center justify-between text-xs\">\n                            <div className=\"space-y-0.5\">\n                              <p className=\"font-semibold text-white\">{yt.title}</p>\n                              <p className=\"text-[11px] text-slate-400\">{yt.channel} \342\200\242 {yt.views}</p>\n                            </div>\n                            <span className=\"px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px]\">\n                              Retention: {yt.retention_first_3s}\n                            </span>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {executionResult.output?.clips && (\n                    <div className=\"space-y-2\">\n                      <h4 className=\"text-xs font-semibold text-purple-400\">\n                        Verified 9:16 Vertical Video Clips (Pexels):\n                      </h4>\n                      <div className=\"grid grid-cols-2 gap-3\">\n                        {executionResult.output.clips.map((clip: any, idx: number) => (\n                          <div key={idx} className=\"p-2.5 rounded-lg bg-[#111724] border border-[#1e2738] space-y-1 text-xs\">\n                            <img \n                              src={clip.thumbnail} \n                              alt={clip.title}\n                              className=\"w-full h-24 object-cover rounded border border-slate-700\" \n                            />\n                            <p className=\"font-bold text-white truncate\">{clip.title}</p>\n                            <p className=\"text-[10px] text-slate-400 font-mono\">{clip.resolution} \342\200\242 {clip.duration}s</p>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {executionResult.output?.ssml_payload && (\n                    <div className=\"p-3 rounded-lg bg-[#101726] border border-[#1e2a40] space-y-2\">\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-semibold text-sky-300 flex items-center gap-1.5\">\n                          <Volume2 className=\"w-4 h-4 text-sky-400\" />\n                          Edge-TTS Neural Audio Synthesizer\n                        </span>\n                        <span className=\"text-[10px] text-emerald-400 font-mono\">\n                          {executionResult.output.cost}\n                        </span>\n                      </div>\n                      <p className=\"text-xs text-slate-300 font-mono bg-slate-950 p-2 rounded border border-slate-800 overflow-x-auto\">\n                        {executionResult.output.ssml_payload}\n                      </p>\n                    </div>\n                  )}\n\n                  <pre className=\"text-[11px] font-mono text-slate-300 bg-slate-950/80 p-3 rounded-lg border border-slate-800 overflow-x-auto max-h-64 leading-relaxed\">\n                    {JSON.stringify(executionResult.output, null, 2)}\n                  </pre>\n                </div>\n              ) : (\n                <div className=\"p-8 border border-dashed border-[#232e42] rounded-xl flex flex-col items-center justify-center text-center text-slate-500 text-xs\">\n                  <Play className=\"w-8 h-8 text-slate-600 mb-2\" />\n                  Click <strong>\"Execute Step\"</strong> above to run this node and stream real data.\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: PARAMETERS */}\n          {activeTab === \"params\" && (\n            <div className=\"space-y-4 text-xs\">\n              <div className=\"p-4 rounded-xl bg-[#0b1019] border border-[#1b2537] space-y-3\">\n                <h3 className=\"text-sm font-bold text-white\">\n                  Node Configuration Parameters\n                </h3>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"text-slate-400 font-semibold block mb-1\">Node Display Name</label>\n                    <input \n                      type=\"text\" \n                      readOnly \n                      value={node.name} \n                      className=\"w-full bg-[#121927] border border-[#233148] rounded-lg px-3 py-1.5 text-white font-mono\" \n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-slate-400 font-semibold block mb-1\">Category & Mode</label>\n                    <input \n                      type=\"text\" \n                      readOnly \n                      value={`${node.category.toUpperCase()} (Autonomous Pipeline Mode)`} \n                      className=\"w-full bg-[#121927] border border-[#233148] rounded-lg px-3 py-1.5 text-white font-mono\" \n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-slate-400 font-semibold block mb-1\">Associated Sub-Agents / Tools</label>\n                    <p className=\"text-slate-300 leading-relaxed bg-[#121927] p-3 rounded-lg border border-[#233148]\">\n                      Integrates with CONTENT-FACTORY 9-agent ecosystem. Respects daily budget and free tier token ceilings.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: FREE TIER SPECS */}\n          {activeTab === \"freetier\" && node.freeTierInfo && (\n            <div className=\"space-y-4 text-xs\">\n              <div className=\"p-4 rounded-xl bg-[#0b1019] border border-[#1b2537] space-y-3\">\n                <div className=\"flex items-center gap-2 text-amber-400\">\n                  <Zap className=\"w-4 h-4\" />\n                  <h3 className=\"text-sm font-bold text-white\">\n                    Free Tier Limits & Architecture\n                  </h3>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                  <div className=\"p-3 rounded-lg bg-[#121927] border border-[#233148]\">\n                    <span className=\"text-[10px] text-slate-400 font-semibold uppercase tracking-wider block mb-1\">\n                      Tier / Provider\n                    </span>\n                    <span className=\"text-sm font-bold text-white\">\n                      {node.freeTierInfo.tierName}\n                    </span>\n                  </div>\n\n                  <div className=\"p-3 rounded-lg bg-[#121927] border border-[#233148]\">\n                    <span className=\"text-[10px] text-slate-400 font-semibold uppercase tracking-wider block mb-1\">\n                      Free Rate Limits\n                    </span>\n                    <span className=\"text-sm font-mono font-bold text-amber-300\">\n                      {node.freeTierInfo.quotaLimit}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"p-3 rounded-lg bg-[#121927] border border-[#233148] space-y-1\">\n                  <span className=\"text-[10px] text-slate-400 font-semibold uppercase tracking-wider block\">\n                    Why This Component Was Chosen\n                  </span>\n                  <p className=\"text-slate-300 leading-relaxed\">\n                    {node.freeTierInfo.whyChosen}\n                  </p>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2\">\n                  <span className=\"text-slate-400 font-mono\">\n                    Environment Key: <strong className=\"text-sky-400\">{node.freeTierInfo.apiKeyName}</strong>\n                  </span>\n                  {node.freeTierInfo.docUrl && (\n                    <a\n                      href={node.freeTierInfo.docUrl}\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                      className=\"text-xs text-sky-400 hover:text-sky-300 flex items-center gap-1 font-semibold\"\n                    >\n                      Get Free API Key <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: RAW JSON */}\n          {activeTab === \"json\" && (\n            <div className=\"space-y-3\">\n              <pre className=\"text-[11px] font-mono text-slate-300 bg-slate-950 p-4 rounded-xl border border-slate-800 overflow-x-auto max-h-96 leading-relaxed\">\n                {JSON.stringify(node, null, 2)}\n              </pre>\n            </div>\n          )}\n        </div>\n\n        {/* Modal Bottom Bar */}\n        <div className=\"px-6 py-3 border-t border-[#232e42] bg-[#141a29]/70 flex items-center justify-between shrink-0\">\n          <span className=\"text-[11px] text-slate-400 font-mono\">\n            Status: {node.status.toUpperCase()}\n          </span>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition cursor-pointer\"\n          >\n            Close Inspector\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
