  file_change {
    absolute_path_uri: "file:///src/components/FreeTierReferenceModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { \n  Cpu, \n  Video, \n  Image as ImageIcon, \n  Volume2, \n  Layers, \n  Globe, \n  Send, \n  Database, \n  Sparkles, \n  CheckCircle2, \n  AlertCircle, \n  ExternalLink,\n  X,\n  Zap,\n  Info\n} from \"lucide-react\";\n\ninterface FreeTierReferenceModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const FreeTierReferenceModal: React.FC<FreeTierReferenceModalProps> = ({\n  isOpen,\n  onClose\n}) => {\n  const [data, setData] = useState<any>(null);\n  const [activeCategory, setActiveCategory] = useState<\"all\" | \"llm\" | \"search\" | \"media\" | \"ops\">(\"all\");\n\n  useEffect(() => {\n    if (isOpen) {\n      fetch(\"/api/free-tier-reference\")\n        .then(res => res.json())\n        .then(resData => setData(resData))\n        .catch(err => console.error(\"Error loading free tier reference:\", err));\n    }\n  }, [isOpen]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-150\">\n      <div \n        className=\"bg-[#10141e] border border-[#232e42] rounded-2xl w-full max-w-5xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden text-slate-100 font-sans\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-[#232e42] flex items-center justify-between bg-[#141a29]/60 shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500/20 to-orange-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400\">\n              <Zap className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-white flex items-center gap-2\">\n                CONTENT-FACTORY: Free Tier APIs & Models Reference\n                <span className=\"text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-medium\">\n                  Zero Marginal Cost\n                </span>\n              </h2>\n              <p className=\"text-xs text-slate-400\">\n                Architectural limits, daily quotas, and model selections powering the autonomous media pipeline.\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Filter Navigation */}\n        <div className=\"px-6 py-2.5 bg-[#0e1320] border-b border-[#1b2537] flex items-center gap-2 shrink-0\">\n          <button\n            onClick={() => setActiveCategory(\"all\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              activeCategory === \"all\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            All Services & Models\n          </button>\n          <button\n            onClick={() => setActiveCategory(\"llm\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              activeCategory === \"llm\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            LLM & Vision (Google AI Studio)\n          </button>\n          <button\n            onClick={() => setActiveCategory(\"search\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              activeCategory === \"search\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            Video Search & Research\n          </button>\n          <button\n            onClick={() => setActiveCategory(\"media\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              activeCategory === \"media\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            Media, TTS & Video Assembly\n          </button>\n          <button\n            onClick={() => setActiveCategory(\"ops\")}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              activeCategory === \"ops\" ? \"bg-amber-500/15 text-amber-300 border border-amber-500/30\" : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            Social Posting & Operations\n          </button>\n        </div>\n\n        {/* Scrollable Content */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-8\">\n          {/* Section 1: LLM & Vision */}\n          {(activeCategory === \"all\" || activeCategory === \"llm\") && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Cpu className=\"w-4 h-4 text-blue-400\" />\n                <h3 className=\"text-sm font-bold text-white uppercase tracking-wider\">\n                  1. LLM & Vision (Google AI Studio)\n                </h3>\n              </div>\n              <div className=\"border border-[#202c42] rounded-xl overflow-hidden bg-[#0d121d]\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#141b29] text-slate-400 border-b border-[#202c42] uppercase text-[10px] tracking-wider font-semibold\">\n                    <tr>\n                      <th className=\"py-2.5 px-4\">Model</th>\n                      <th className=\"py-2.5 px-4\">Pipeline Purpose</th>\n                      <th className=\"py-2.5 px-4\">Free Tier Limits</th>\n                      <th className=\"py-2.5 px-4\">Why This Model</th>\n                      <th className=\"py-2.5 px-4\">Key / Setup</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#1b2537]\">\n                    {data?.models?.map((item: any, idx: number) => (\n                      <tr key={idx} className=\"hover:bg-[#151e30] transition\">\n                        <td className=\"py-3 px-4 font-mono font-bold text-sky-400 whitespace-nowrap\">\n                          {item.model}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-300\">\n                          {item.purpose}\n                        </td>\n                        <td className=\"py-3 px-4 font-mono text-amber-300 font-semibold whitespace-nowrap\">\n                          {item.limits}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400 leading-relaxed\">\n                          {item.why}\n                        </td>\n                        <td className=\"py-3 px-4 whitespace-nowrap\">\n                          <span className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-medium ${\n                            item.isConfigured ? \"bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\" : \"bg-slate-800 text-slate-400\"\n                          }`}>\n                            {item.isConfigured ? <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" /> : <Info className=\"w-3 h-3\" />}\n                            {item.isConfigured ? \"Active\" : item.keyName}\n                          </span>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {/* Section 2: Video Search & Trends */}\n          {(activeCategory === \"all\" || activeCategory === \"search\") && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Video className=\"w-4 h-4 text-rose-400\" />\n                <h3 className=\"text-sm font-bold text-white uppercase tracking-wider\">\n                  2. Video Search & Research Intelligence\n                </h3>\n              </div>\n              <div className=\"border border-[#202c42] rounded-xl overflow-hidden bg-[#0d121d]\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#141b29] text-slate-400 border-b border-[#202c42] uppercase text-[10px] tracking-wider font-semibold\">\n                    <tr>\n                      <th className=\"py-2.5 px-4\">Service / API</th>\n                      <th className=\"py-2.5 px-4\">Pipeline Purpose</th>\n                      <th className=\"py-2.5 px-4\">Free Tier Quota</th>\n                      <th className=\"py-2.5 px-4\">Why Selected</th>\n                      <th className=\"py-2.5 px-4\">Status</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#1b2537]\">\n                    {data?.videoSearch?.map((item: any, idx: number) => (\n                      <tr key={idx} className=\"hover:bg-[#151e30] transition\">\n                        <td className=\"py-3 px-4 font-bold text-white whitespace-nowrap\">\n                          {item.api}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-300\">\n                          {item.purpose}\n                        </td>\n                        <td className=\"py-3 px-4 font-mono text-emerald-300 font-semibold whitespace-nowrap\">\n                          {item.freeTier}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400 leading-relaxed\">\n                          {item.why}\n                        </td>\n                        <td className=\"py-3 px-4 whitespace-nowrap\">\n                          <span className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-medium ${\n                            item.isConfigured ? \"bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\" : \"bg-slate-800 text-slate-400\"\n                          }`}>\n                            {item.isConfigured ? <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" /> : <Info className=\"w-3 h-3\" />}\n                            {item.isConfigured ? \"Ready\" : item.keyName}\n                          </span>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {/* Section 3: Media, TTS, & Assembly */}\n          {(activeCategory === \"all\" || activeCategory === \"media\") && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Volume2 className=\"w-4 h-4 text-purple-400\" />\n                <h3 className=\"text-sm font-bold text-white uppercase tracking-wider\">\n                  3. Media, TTS & Video Assembly Stack\n                </h3>\n              </div>\n              <div className=\"border border-[#202c42] rounded-xl overflow-hidden bg-[#0d121d]\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#141b29] text-slate-400 border-b border-[#202c42] uppercase text-[10px] tracking-wider font-semibold\">\n                    <tr>\n                      <th className=\"py-2.5 px-4\">Tool / Library</th>\n                      <th className=\"py-2.5 px-4\">Pipeline Purpose</th>\n                      <th className=\"py-2.5 px-4\">Cost / Limits</th>\n                      <th className=\"py-2.5 px-4\">Why Selected</th>\n                      <th className=\"py-2.5 px-4\">Integration</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#1b2537]\">\n                    {data?.media?.map((item: any, idx: number) => (\n                      <tr key={idx} className=\"hover:bg-[#151e30] transition\">\n                        <td className=\"py-3 px-4 font-bold text-white whitespace-nowrap\">\n                          {item.service}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-300\">\n                          {item.purpose}\n                        </td>\n                        <td className=\"py-3 px-4 font-mono text-purple-300 font-semibold whitespace-nowrap\">\n                          {item.freeTier}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400 leading-relaxed\">\n                          {item.why}\n                        </td>\n                        <td className=\"py-3 px-4 whitespace-nowrap\">\n                          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\">\n                            <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" />\n                            {item.keyName === \"NONE\" || item.keyName === \"LOCAL\" ? \"Zero Config\" : \"API Ready\"}\n                          </span>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {/* Section 4: Social Posting & Operations */}\n          {(activeCategory === \"all\" || activeCategory === \"ops\") && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Globe className=\"w-4 h-4 text-emerald-400\" />\n                <h3 className=\"text-sm font-bold text-white uppercase tracking-wider\">\n                  4. Social Distribution, Approvals & Database\n                </h3>\n              </div>\n              <div className=\"border border-[#202c42] rounded-xl overflow-hidden bg-[#0d121d]\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#141b29] text-slate-400 border-b border-[#202c42] uppercase text-[10px] tracking-wider font-semibold\">\n                    <tr>\n                      <th className=\"py-2.5 px-4\">Component</th>\n                      <th className=\"py-2.5 px-4\">Pipeline Role</th>\n                      <th className=\"py-2.5 px-4\">Free Tier Allowance</th>\n                      <th className=\"py-2.5 px-4\">Architecture Rationale</th>\n                      <th className=\"py-2.5 px-4\">Status</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#1b2537]\">\n                    {data?.socialAndOps?.map((item: any, idx: number) => (\n                      <tr key={idx} className=\"hover:bg-[#151e30] transition\">\n                        <td className=\"py-3 px-4 font-bold text-white whitespace-nowrap\">\n                          {item.service}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-300\">\n                          {item.purpose}\n                        </td>\n                        <td className=\"py-3 px-4 font-mono text-cyan-300 font-semibold whitespace-nowrap\">\n                          {item.freeTier}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400 leading-relaxed\">\n                          {item.why}\n                        </td>\n                        <td className=\"py-3 px-4 whitespace-nowrap\">\n                          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\">\n                            <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" />\n                            Active\n                          </span>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {/* Bottom Guidance Card */}\n          <div className=\"p-4 rounded-xl bg-gradient-to-r from-blue-950/40 to-slate-900 border border-blue-800/40 flex items-start gap-3\">\n            <Info className=\"w-5 h-5 text-blue-400 shrink-0 mt-0.5\" />\n            <div className=\"text-xs text-slate-300 space-y-1\">\n              <p className=\"font-semibold text-white\">Daily Operational Ceiling:</p>\n              <p className=\"leading-relaxed\">\n                Under the free tier constraints, CONTENT-FACTORY can generate up to <strong className=\"text-amber-300\">3-5 full-production vertical shorts per day</strong> entirely within free rate limits (15 RPM Gemini flash, 10k YouTube search units, 200 Pexels video queries/hr, zero-cost Edge-TTS narration, and local FFmpeg rendering).\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-3 border-t border-[#232e42] bg-[#141a29]/60 flex items-center justify-between shrink-0\">\n          <div className=\"text-xs text-slate-400 flex items-center gap-2\">\n            <span>Primary Model:</span>\n            <span className=\"font-mono text-sky-400 bg-sky-950/40 px-2 py-0.5 rounded border border-sky-800/40\">\n              gemini-3.6-flash\n            </span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition cursor-pointer\"\n          >\n            Close Reference\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
