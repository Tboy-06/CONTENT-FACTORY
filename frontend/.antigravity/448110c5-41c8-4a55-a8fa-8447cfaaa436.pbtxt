          text: "    if (!selectedJob) return \"pending\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (selectedJob.status === \"COMPLETED\") return \"completed\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Map job current_stage to virtual index"
