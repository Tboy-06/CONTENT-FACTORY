      replacement_content: "import React, { useState } from \"react\";\nimport { Send, Bot, Terminal, Shield, Sparkles, CornerDownLeft, Play } from \"lucide-react\";\n\ninterface Message {\n  id: number;\n  sender: \"user\" | \"bot\";\n  text: string;\n  time: string;\n}\n\ninterface TelegramSimulatorProps {\n  onCommandRun: (cmd: string) => Promise<string>;\n}\n\nconst COMMAND_CHIPS = [\n  { cmd: \"/status\", label: \"/status\", desc: \"View all active jobs\" },\n  { cmd: \"/pending\", label: \"/pending\", desc: \"Jobs waiting for approval\" },\n  { cmd: \"/approve 101\", label: \"/approve 101\", desc: \"Approve stage on job 101\" },\n  { cmd: \"/reject 101 Hook needs more urgency\", label: \"/reject\", desc: \"Reject stage with notes\" },\n  { cmd: \"/variants 101\", label: \"/variants\", desc: \"3 script hook variants\" },\n  { cmd: \"/preview 101\", label: \"/preview\", desc: \"Preview generated assets\" },\n  { cmd: \"/premium 101\", label: \"/premium\", desc: \"Enable Veo 3.1 4K Mode\" },\n  { cmd: \"/upload_premium 101\", label: \"/upload_premium\", desc: \"Attach 4K Veo render\" },\n  { cmd: \"/post 101\", label: \"/post\", desc: \"Publish via Postiz\" },\n  { cmd: \"/analyze 101\", label: \"/analyze\", desc: \"Virality analytics\" },\n  { cmd: \"/cost\", label: \"/cost\", desc: \"Token spend ledger\" },\n  { cmd: \"/report\", label: \"/report\", desc: \"Executive daily summary\" },\n  { cmd: \"/goal Cyberpunk Tech Alpha\", label: \"/goal <niche>\", desc: \"Create new pipeline\" },\n  { cmd: \"/help\", label: \"/help\", desc: \"Command documentation\" }\n];\n\nexport const TelegramSimulator: React.FC<TelegramSimulatorProps> = ({ onCommandRun }) => {\n  const [input, setInput] = useState(\"\");\n  const [isLoading, setIsLoading] = useState(false);\n  const [messages, setMessages] = useState<Message[]>([\n    {\n      id: 1,\n      sender: \"bot\",\n      text: \"\360\237\244\226 CONTENT-FACTORY HITL Bot Online\\nAuthorized Admin ID: 123456789\\nType /help or use the quick command chips below to manage autonomous pipelines.\",\n      time: new Date(Date.now() - 1000 * 60 * 5).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n    }\n  ]);\n\n  const handleSend = async (cmdToSend?: string) => {\n    const command = (cmdToSend || input).trim();\n    if (!command || isLoading) return;\n\n    const userMsg: Message = {\n      id: Date.now(),\n      sender: \"user\",\n      text: command,\n      time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n    };\n\n    setMessages(prev => [...prev, userMsg]);\n    setInput(\"\");\n    setIsLoading(true);\n\n    try {\n      const reply = await onCommandRun(command);\n      const botMsg: Message = {\n        id: Date.now() + 1,\n        sender: \"bot\",\n        text: reply,\n        time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n      };\n      setMessages(prev => [...prev, botMsg]);\n    } catch (e: any) {\n      const errorMsg: Message = {\n        id: Date.now() + 1,\n        sender: \"bot\",\n        text: `Error executing command: ${e.message || \"Failed to contact Telegram bridge\"}`,\n        time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n      };\n      setMessages(prev => [...prev, errorMsg]);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-5\">\n      {/* Header Info Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400\">\n            <Send className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2\">\n              Telegram HITL Console Emulator\n              <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30\">\n                AUTH OK\n              </span>\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Interactive test console for python-telegram-bot v21. Control approvals, premium renders, and posting.\n            </p>\n          </div>\n        </div>\n        <div className=\"text-xs text-slate-400 font-mono bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800\">\n          Allowed User: <span className=\"text-cyan-400\">123456789</span>\n        </div>\n      </div>\n\n      {/* Quick Command Chips */}\n      <div className=\"bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4\">\n        <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2.5 flex items-center gap-1.5\">\n          <Terminal className=\"w-3.5 h-3.5 text-cyan-400\" />\n          14 Registered HITL Bot Commands\n        </div>\n        <div className=\"flex flex-wrap gap-1.5\">\n          {COMMAND_CHIPS.map((chip, idx) => (\n            <button\n              key={idx}\n              onClick={() => handleSend(chip.cmd)}\n              disabled={isLoading}\n              title={chip.desc}\n              className=\"text-xs font-mono px-2.5 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950/60 hover:border-cyan-500/50 hover:text-cyan-300 text-slate-300 border border-slate-700/60 transition-all cursor-pointer\"\n            >\n              {chip.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Chat Terminal Window */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl flex flex-col h-[520px]\">\n        {/* Terminal Title Bar */}\n        <div className=\"bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-3 h-3 rounded-full bg-rose-500/80\" />\n            <span className=\"w-3 h-3 rounded-full bg-amber-500/80\" />\n            <span className=\"w-3 h-3 rounded-full bg-emerald-500/80\" />\n            <span className=\"ml-2 font-mono text-slate-400\">@content_factory_hitl_bot</span>\n          </div>\n          <span className=\"text-[11px] text-slate-500 font-mono\">APScheduler \342\200\242 Long Polling</span>\n        </div>\n\n        {/* Message Feed */}\n        <div className=\"flex-1 overflow-y-auto p-4 space-y-3.5 bg-slate-950/50\">\n          {messages.map((msg) => (\n            <div\n              key={msg.id}\n              className={`flex ${msg.sender === \"user\" ? \"justify-end\" : \"justify-start\"}`}\n            >\n              <div\n                className={`max-w-[85%] rounded-2xl px-4 py-3 text-xs leading-relaxed ${\n                  msg.sender === \"user\"\n                    ? \"bg-cyan-600 text-white font-mono rounded-tr-none shadow-md\"\n                    : \"bg-slate-800/90 border border-slate-700/80 text-slate-200 rounded-tl-none shadow-sm\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between gap-4 mb-1 text-[10px] opacity-75\">\n                  <span className=\"font-bold\">{msg.sender === \"user\" ? \"You (Admin)\" : \"ContentFactoryBot\"}</span>\n                  <span>{msg.time}</span>\n                </div>\n                <pre className=\"whitespace-pre-wrap font-sans break-words text-xs\">\n                  {msg.text}\n                </pre>\n              </div>\n            </div>\n          ))}\n          {isLoading && (\n            <div className=\"flex justify-start\">\n              <div className=\"bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-cyan-300 font-mono flex items-center gap-2\">\n                <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-ping\" />\n                <span>Bot processing command via Gemini / Vault...</span>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Command Input Field */}\n        <div className=\"p-3 bg-slate-950 border-t border-slate-800 flex items-center gap-2\">\n          <input\n            id=\"telegram-cmd-input\"\n            type=\"text\"\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n            onKeyDown={(e) => {\n              if (e.key === \"Enter\") handleSend();\n            }}\n            placeholder=\"Type a command (e.g. /status, /approve 101, /cost, /report)...\"\n            className=\"flex-1 bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 font-mono focus:outline-none focus:border-cyan-500\"\n          />\n          <button\n            id=\"telegram-send-btn\"\n            onClick={() => handleSend()}\n            disabled={isLoading || !input.trim()}\n            className=\"bg-cyan-500 hover:bg-cyan-400 disabled:bg-slate-800 disabled:text-slate-600 text-white font-bold p-2.5 rounded-xl transition cursor-pointer\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
