          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <p className=\"text-xs font-bold text-[#fafafa]\">{agent.role}</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <p className=\"text-[10px] text-zinc-500 mt-0.5 font-mono\">{agent.status}</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ))}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <div className=\"mt-5 pt-4 border-t border-[#27272a] flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 font-mono gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <div className=\"flex items-center gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <span>Telegram Webhook Connected: @content_factory_hitl_bot</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <span>Polling: 1000ms \342\200\242 APScheduler Active</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Update PipelineBoard jobs list, details view, logs, assets, and add Fleet Status bento card"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Main Grid: Jobs List (Left) + Detail View (Right) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: Jobs List */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-md\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h3 className=\"font-bold text-white text-sm\">Pipeline Vault Queue</h3>\n              <div className=\"flex bg-slate-950 rounded-lg p-0.5 border border-slate-800 text-[11px]\">\n                <button\n                  onClick={() => setFilter(\"ALL\")}\n                  className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${filter === \"ALL\" ? \"bg-slate-800 text-white\" : \"text-slate-400\"}`}\n                >\n                  All ({jobs.length})\n                </button>\n                <button\n                  onClick={() => setFilter(\"PENDING\")}\n                  className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${filter === \"PENDING\" ? \"bg-slate-800 text-white\" : \"text-slate-400\"}`}\n                >\n                  Active\n                </button>\n                <button\n                  onClick={() => setFilter(\"COMPLETED\")}\n                  className={`px-2.5 py-1 rounded-md font-medium transition cursor-pointer ${filter === \"COMPLETED\" ? \"bg-slate-800 text-white\" : \"text-slate-400\"}`}\n                >\n                  Done\n                </button>\n              </div>\n            </div>\n\n            {/* Jobs Card List */}\n            <div className=\"space-y-2.5 max-h-[620px] overflow-y-auto pr-1\">\n              {filteredJobs.map(job => {\n                const isSelected = selectedJob?.id === job.id;\n                return (\n                  <div\n                    key={job.id}\n                    onClick={() => onSelectJob(job)}\n                    className={`p-3.5 rounded-xl border transition-all cursor-pointer ${\n                      isSelected\n                        ? \"border-cyan-500 bg-cyan-950/20 shadow-md shadow-cyan-500/10\"\n                        : \"border-slate-800/80 bg-slate-950/40 hover:border-slate-700 hover:bg-slate-900/50\"\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between gap-2\">\n                      <div>\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className=\"text-xs font-mono font-bold text-cyan-400\">#{job.id}</span>\n                          <h4 className=\"text-xs font-bold text-white leading-tight line-clamp-1\">{job.niche}</h4>\n                        </div>\n                        <div className=\"text-[11px] text-slate-400 mt-1 flex items-center gap-2\">\n                          <span>Stage: <strong className=\"text-slate-200\">{job.current_stage}</strong></span>\n                          <span>\342\200\242</span>\n                          <span>{job.config.format || \"9:16 Short\"}</span>\n                        </div>\n                      </div>\n                      <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase border shrink-0 ${\n                        job.status === \"COMPLETED\"\n                          ? \"bg-emerald-500/10 text-emerald-400 border-emerald-500/30\"\n                          : job.status === \"AWAITING_APPROVAL\"\n                          ? \"bg-amber-500/10 text-amber-300 border-amber-500/30 animate-pulse\"\n                          : job.status === \"AWAITING_PREMIUM\"\n                          ? \"bg-purple-500/10 text-purple-300 border-purple-500/30\"\n                          : \"bg-blue-500/10 text-blue-300 border-blue-500/30\"\n                      }`}>\n                        {job.status.replace(\"_\", \" \")}\n                      </span>\n                    </div>\n\n                    {/* Progress Bar */}\n                    <div className=\"mt-3\">\n                      <div className=\"flex justify-between text-[10px] text-slate-400 mb-1 font-mono\">\n                        <span>{job.stages.length}/10 Stages</span>\n                        <span>{Math.round((job.stages.length / 10) * 100)}%</span>\n                      </div>\n                      <div className=\"w-full bg-slate-800 rounded-full h-1 overflow-hidden\">\n                        <div \n                          className={`h-full rounded-full transition-all duration-300 ${\n                            job.status === \"COMPLETED\" ? \"bg-emerald-400\" : \"bg-cyan-500\"\n                          }`}\n                          style={{ width: `${(job.stages.length / 10) * 100}%` }}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Selected Job Details & Stage Actions */}\n        <div className=\"lg:col-span-8 space-y-5\">\n          {selectedJob ? (\n            <>\n              {/* Job Banner with Controls */}\n              <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800/80\">\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-mono font-bold text-cyan-400 bg-cyan-950/60 border border-cyan-800/60 px-2 py-0.5 rounded\">\n                        JOB #{selectedJob.id}\n                      </span>\n                      <h2 className=\"text-lg font-extrabold text-white\">{selectedJob.niche}</h2>\n                    </div>\n                    <div className=\"flex flex-wrap items-center gap-3 text-xs text-slate-400 mt-1.5\">\n                      <span>Format: <strong className=\"text-slate-200\">{selectedJob.config.format || \"9:16\"}</strong></span>\n                      <span>\342\200\242</span>\n                      <span>Target: <strong className=\"text-slate-200\">TikTok, Reels, Shorts</strong></span>\n                      {selectedJob.config.premium && (\n                        <span className=\"px-2 py-0.2 rounded bg-purple-500/20 text-purple-300 border border-purple-500/40 font-semibold\">\n                          PREMIUM VEO 3.1 MODE\n                        </span>\n                      )}\n                    </div>\n                  </div>\n\n                  {/* Stage Advance / Trigger Button */}\n                  <div className=\"flex items-center gap-2\">\n                    {selectedJob.status !== \"COMPLETED\" && (\n                      <button\n                        id=\"advance-stage-btn\"\n                        onClick={() => onAdvanceStage(selectedJob.id)}\n                        disabled={isAdvancing || selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\"}\n                        className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs shadow-lg transition-all cursor-pointer ${\n                          selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\"\n                            ? \"bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700\"\n                            : \"bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white shadow-cyan-500/20\"\n                        }`}\n                      >\n                        {isAdvancing ? (\n                          <>\n                            <RotateCcw className=\"w-4 h-4 animate-spin\" />\n                            <span>Agent Executing...</span>\n                          </>\n                        ) : (\n                          <>\n                            <Play className=\"w-4 h-4 fill-white\" />\n                            <span>Run Next Stage ({STAGES[Math.min(STAGES.length - 1, STAGES.findIndex(s => s.key === selectedJob.current_stage) + 1)]?.name})</span>\n                          </>\n                        )}\n                      </button>\n                    )}\n                  </div>\n                </div>\n\n                {/* HITL Approval Gate Action Box (if paused at SCRIPT, QC1, QC2) */}\n                {selectedJob.status === \"AWAITING_APPROVAL\" && (\n                  <div className=\"mt-4 p-4 rounded-xl bg-amber-950/30 border border-amber-500/40 text-amber-200 space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <ShieldCheck className=\"w-5 h-5 text-amber-400\" />\n                        <div>\n                          <h4 className=\"font-bold text-xs text-amber-300 uppercase tracking-wide\">\n                            Human-In-The-Loop Approval Gate: {selectedJob.current_stage}\n                          </h4>\n                          <p className=\"text-xs text-slate-300\">\n                            The autonomous pipeline is paused awaiting your review before proceeding.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          id=\"approve-stage-btn\"\n                          onClick={() => onApproveStage(selectedJob.id)}\n                          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition cursor-pointer\"\n                        >\n                          <Check className=\"w-4 h-4\" />\n                          <span>Approve & Continue</span>\n                        </button>\n                        <button\n                          id=\"reject-stage-toggle\"\n                          onClick={() => setShowRejectInput(!showRejectInput)}\n                          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-600/80 hover:bg-rose-600 text-white font-bold text-xs transition cursor-pointer\"\n                        >\n                          <X className=\"w-4 h-4\" />\n                          <span>Reject / Revise</span>\n                        </button>\n                      </div>\n                    </div>\n\n                    {showRejectInput && (\n                      <div className=\"flex items-center gap-2 pt-2 border-t border-amber-500/20\">\n                        <input\n                          type=\"text\"\n                          value={rejectReason}\n                          onChange={(e) => setRejectReason(e.target.value)}\n                          placeholder=\"Reason for revision (e.g., Hook needs more urgency)...\"\n                          className=\"flex-1 bg-slate-900 border border-slate-700 text-white text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-amber-400\"\n                        />\n                        <button\n                          onClick={() => {\n                            onRejectStage(selectedJob.id, rejectReason);\n                            setRejectReason(\"\");\n                            setShowRejectInput(false);\n                          }}\n                          className=\"px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-lg cursor-pointer\"\n                        >\n                          Submit Revision\n                        </button>\n                      </div>\n                    )}\n                  </div>\n                )}\n\n                {/* AWAITING_PREMIUM Gate Box */}\n                {selectedJob.status === \"AWAITING_PREMIUM\" && (\n                  <div className=\"mt-4 p-4 rounded-xl bg-purple-950/30 border border-purple-500/40 text-purple-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex items-center gap-2.5\">\n                      <UploadCloud className=\"w-5 h-5 text-purple-400\" />\n                      <div>\n                        <h4 className=\"font-bold text-xs text-purple-300 uppercase tracking-wide\">\n                          Premium Video Generation Required (Veo 3.1 / Flow)\n                        </h4>\n                        <p className=\"text-xs text-slate-300\">\n                          Attach 4K high-bitrate video render to satisfy premium production specs.\n                        </p>\n                      </div>\n                    </div>\n                    <button\n                      id=\"upload-premium-btn\"\n                      onClick={() => onUploadPremium(selectedJob.id)}\n                      className=\"flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs shadow-md transition cursor-pointer\"\n                    >\n                      <Video className=\"w-4 h-4\" />\n                      <span>Attach 4K Veo Render</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Stage Outputs Timeline */}\n              <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h3 className=\"text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2\">\n                    <Clock className=\"w-4 h-4 text-cyan-400\" />\n                    Stage Execution Output Log\n                  </h3>\n                  <span className=\"text-xs text-slate-400 font-mono\">\n                    {selectedJob.stages.length} Completed Stages\n                  </span>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {selectedJob.stages.map((st, i) => (\n                    <div key={st.id || i} className=\"p-4 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-2\">\n                      <div className=\"flex items-center justify-between\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 font-mono text-xs flex items-center justify-center font-bold\">\n                            {i + 1}\n                          </span>\n                          <span className=\"font-bold text-xs text-white uppercase tracking-wide\">{st.stage}</span>\n                          <span className=\"text-[11px] text-slate-400 font-mono\">\n                            {new Date(st.timestamp).toLocaleTimeString()}\n                          </span>\n                        </div>\n                        <span className=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30\">\n                          SUCCESS\n                        </span>\n                      </div>\n\n                      {/* Render formatted preview depending on stage */}\n                      {st.stage === \"IDEA\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <p><strong>Target Audience:</strong> {st.output.target_audience}</p>\n                          <p><strong>Core Mission:</strong> {st.output.core_mission}</p>\n                          {st.output.ai_directive && (\n                            <p className=\"p-2 rounded bg-slate-900 text-cyan-300 border border-slate-800 italic\">\n                              \"{st.output.ai_directive}\"\n                            </p>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"RESEARCH\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-semibold\">Virality Score:</span>\n                            <span className=\"px-2 py-0.2 rounded bg-cyan-500/20 text-cyan-300 font-mono font-bold\">\n                              {st.output.virality_score || 93.4}/100\n                            </span>\n                          </div>\n                          <p><strong>Selected Angle:</strong> {st.output.selected_angle}</p>\n                          {st.output.insights && (\n                            <p className=\"p-2 rounded bg-slate-900 text-slate-300 border border-slate-800 whitespace-pre-line text-[11px]\">\n                              {st.output.insights}\n                            </p>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"SCRIPT\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1.5\">\n                          <div className=\"p-2.5 rounded-lg bg-cyan-950/40 border border-cyan-800/60 text-cyan-200\">\n                            <strong>\342\232\241 3-Second Hook:</strong> \"{st.output.hook}\"\n                          </div>\n                          {st.output.full_script && (\n                            <pre className=\"p-2.5 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 text-[11px] whitespace-pre-wrap font-sans\">\n                              {st.output.full_script}\n                            </pre>\n                          )}\n                          {st.output.hashtags && (\n                            <div className=\"flex flex-wrap gap-1 mt-1\">\n                              {st.output.hashtags.map((h: string, hi: number) => (\n                                <span key={hi} className=\"text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-cyan-400 font-mono\">\n                                  {h}\n                                </span>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"STYLE\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <p><strong>Archetype:</strong> {st.output.archetype || st.output.visual_archetype}</p>\n                          <div className=\"flex items-center gap-2\">\n                            <span>Palette:</span>\n                            {(st.output.palette || [\"#0F172A\", \"#38BDF8\", \"#F59E0B\"]).map((c: string, ci: number) => (\n                              <span \n                                key={ci} \n                                className=\"w-5 h-5 rounded-md border border-slate-700 inline-block\" \n                                style={{ backgroundColor: c }} \n                                title={c} \n                              />\n                            ))}\n                          </div>\n                          <p><strong>Cut Pacing:</strong> {st.output.cut_pacing_sec || \"Every 1.8s\"}</p>\n                          <p><strong>Audio:</strong> {st.output.bg_music || \"118 BPM Tension Synth\"}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"ART\" && (\n                        <div className=\"text-xs text-slate-300 space-y-2\">\n                          <p className=\"font-semibold text-slate-200\">Veo 3.1 & Nano-Banana Shot Storyboard:</p>\n                          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                            {(st.output.veo_prompts || [\n                              \"Shot 1: Extreme close up holographic interface\",\n                              \"Shot 2: Modern dark workspace neon overlays\"\n                            ]).map((prompt: string, pi: number) => (\n                              <div key={pi} className=\"p-2 rounded bg-slate-900 border border-slate-800 text-[11px]\">\n                                <span className=\"font-bold text-cyan-400\">Shot {pi + 1}: </span>\n                                {prompt}\n                              </div>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n\n                      {st.stage === \"VIDEO\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <p><strong>Assembly Engine:</strong> {st.output.engine}</p>\n                          <p><strong>Resolution:</strong> {st.output.resolution || \"1080x1920 60FPS\"}</p>\n                          <p><strong>Pacing Score:</strong> {st.output.pacing_score || 96.4}%</p>\n                          <p className=\"font-mono text-[11px] text-cyan-400\">Master Path: {st.output.video_url || \"/vault/renders/final.mp4\"}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"QC1\" || st.stage === \"QC2\" ? (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <p><strong>Audit Status:</strong> <span className=\"text-emerald-400 font-bold\">PASSED</span></p>\n                          <p><strong>Originality:</strong> {st.output.originality_score || 98.4}%</p>\n                          {st.output.av_sync_offset_ms !== undefined && (\n                            <p><strong>AV Sync Offset:</strong> {st.output.av_sync_offset_ms}ms (Perfect)</p>\n                          )}\n                        </div>\n                      ) : null}\n\n                      {st.stage === \"POST\" && (\n                        <div className=\"text-xs text-slate-300 space-y-1\">\n                          <p><strong>Postiz Status:</strong> {st.output.status}</p>\n                          <p><strong>Dispatched To:</strong> {(st.output.platforms || [\"TikTok\", \"IG Reels\", \"YT Shorts\"]).join(\", \")}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"ANALYZE\" && (\n                        <div className=\"text-xs text-slate-300 space-y-2\">\n                          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1\">\n                            <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                              <div className=\"text-slate-400 text-[10px]\">VIEWS</div>\n                              <div className=\"text-sm font-bold text-cyan-400 font-mono\">\n                                {selectedJob.analytics?.views.toLocaleString() || \"148,200\"}\n                              </div>\n                            </div>\n                            <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                              <div className=\"text-slate-400 text-[10px]\">RETENTION</div>\n                              <div className=\"text-sm font-bold text-emerald-400 font-mono\">\n                                {selectedJob.analytics?.retention_rate || 76.4}%\n                              </div>\n                            </div>\n                            <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                              <div className=\"text-slate-400 text-[10px]\">SHARES</div>\n                              <div className=\"text-sm font-bold text-amber-400 font-mono\">\n                                {selectedJob.analytics?.shares.toLocaleString() || \"2,840\"}\n                              </div>\n                            </div>\n                            <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                              <div className=\"text-slate-400 text-[10px]\">CREATOR REWARD</div>\n                              <div className=\"text-sm font-bold text-emerald-400 font-mono\">\n                                ${selectedJob.analytics?.revenue.toFixed(2) || \"64.20\"}\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Assets & Token Costs Dual Panel */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {/* Assets List */}\n                <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-md\">\n                  <h4 className=\"font-bold text-xs text-white uppercase tracking-wider mb-3 flex items-center gap-1.5\">\n                    <Video className=\"w-4 h-4 text-cyan-400\" />\n                    Registered Vault Assets ({selectedJob.assets.length})\n                  </h4>\n                  <div className=\"space-y-2 max-h-48 overflow-y-auto\">\n                    {selectedJob.assets.map(a => (\n                      <div key={a.id} className=\"p-2.5 rounded-lg bg-slate-950 border border-slate-800 flex items-center justify-between text-xs\">\n                        <div className=\"flex items-center gap-2\">\n                          {a.type === \"SCRIPT\" && <FileText className=\"w-4 h-4 text-cyan-400\" />}\n                          {a.type === \"AUDIO\" && <Music className=\"w-4 h-4 text-amber-400\" />}\n                          {a.type === \"VIDEO\" && <Video className=\"w-4 h-4 text-emerald-400\" />}\n                          {a.type === \"IMAGE\" && <ImageIcon className=\"w-4 h-4 text-purple-400\" />}\n                          <div>\n                            <div className=\"font-semibold text-white\">{a.description}</div>\n                            <div className=\"text-[10px] text-slate-500 font-mono\">{a.path}</div>\n                          </div>\n                        </div>\n                        <span className=\"text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300\">\n                          {a.type}\n                        </span>\n                      </div>\n                    ))}\n                    {selectedJob.assets.length === 0 && (\n                      <div className=\"text-xs text-slate-500 text-center py-4\">No assets generated yet.</div>\n                    )}\n                  </div>\n                </div>\n\n                {/* Per-Agent Cost Breakdown */}\n                <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-md\">\n                  <h4 className=\"font-bold text-xs text-white uppercase tracking-wider mb-3 flex items-center gap-1.5\">\n                    <Coins className=\"w-4 h-4 text-emerald-400\" />\n                    Agent Cost Ledger ({selectedJob.costs.reduce((acc, c) => acc + c.usd_estimate, 0).toFixed(4)} USD)\n                  </h4>\n                  <div className=\"space-y-1.5 max-h-48 overflow-y-auto\">\n                    {selectedJob.costs.map((c, idx) => (\n                      <div key={idx} className=\"flex items-center justify-between text-xs p-2 rounded bg-slate-950 border border-slate-800/80\">\n                        <span className=\"font-semibold text-slate-300\">{c.agent_name}</span>\n                        <div className=\"flex items-center gap-3 font-mono text-[11px]\">\n                          <span className=\"text-slate-400\">{c.tokens} toks</span>\n                          <span className=\"text-emerald-400 font-bold\">${c.usd_estimate.toFixed(4)}</span>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </>\n          ) : (\n            <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-12 text-center text-slate-400\">\n              <Sparkles className=\"w-8 h-8 text-cyan-400 mx-auto mb-3 opacity-60\" />\n              <h3 className=\"font-bold text-white text-base\">Select a Job from Queue</h3>\n              <p className=\"text-xs text-slate-400 max-w-sm mx-auto mt-1\">\n                Choose an active or completed job on the left to inspect stage history, approve gates, or trigger the next agent.\n              </p>\n            </div>\n          )}\n        </div>\n      </div>"
        replacement_content: "      {/* Main Grid: Jobs List (Left) + Detail View (Right) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: Jobs List Bento Card */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"text-sm font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2\">\n                <span className=\"w-2 h-2 rounded-full bg-indigo-500\"></span>\n                Active Pipeline\n              </h3>\n              <div className=\"flex bg-[#09090b] rounded-full p-0.5 border border-[#27272a] text-[10px]\">\n                <button\n                  onClick={() => setFilter(\"ALL\")}\n                  className={`px-2.5 py-1 rounded-full font-medium transition cursor-pointer ${filter === \"ALL\" ? \"bg-zinc-800 text-white\" : \"text-zinc-400 hover:text-zinc-200\"}`}\n                >\n                  All ({jobs.length})\n                </button>\n                <button\n                  onClick={() => setFilter(\"PENDING\")}\n                  className={`px-2.5 py-1 rounded-full font-medium transition cursor-pointer ${filter === \"PENDING\" ? \"bg-zinc-800 text-white\" : \"text-zinc-400 hover:text-zinc-200\"}`}\n                >\n                  Active\n                </button>\n                <button\n                  onClick={() => setFilter(\"COMPLETED\")}\n                  className={`px-2.5 py-1 rounded-full font-medium transition cursor-pointer ${filter === \"COMPLETED\" ? \"bg-zinc-800 text-white\" : \"text-zinc-400 hover:text-zinc-200\"}`}\n                >\n                  Done\n                </button>\n              </div>\n            </div>\n\n            {/* Jobs Card List */}\n            <div className=\"space-y-3 max-h-[620px] overflow-y-auto pr-1\">\n              {filteredJobs.map(job => {\n                const isSelected = selectedJob?.id === job.id;\n                return (\n                  <div\n                    key={job.id}\n                    onClick={() => onSelectJob(job)}\n                    className={`p-4 rounded-2xl border transition-all cursor-pointer ${\n                      isSelected\n                        ? \"border-indigo-500/60 bg-[#09090b] shadow-[0_0_15px_rgba(79,70,229,0.15)] ring-1 ring-indigo-500/30\"\n                        : \"border-[#27272a] bg-[#09090b] hover:border-zinc-700\"\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between gap-2\">\n                      <div>\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"text-xs font-mono font-bold text-indigo-400\">#{job.id}</span>\n                          <h4 className=\"text-xs font-bold text-[#fafafa] leading-tight line-clamp-1\">{job.niche}</h4>\n                        </div>\n                        <div className=\"text-[11px] text-zinc-400 mt-1 flex items-center gap-2\">\n                          <span>Stage: <strong className=\"text-zinc-200\">{job.current_stage}</strong></span>\n                          <span>\342\200\242</span>\n                          <span>{job.config.format || \"9:16 Short\"}</span>\n                        </div>\n                      </div>\n                      <span className={`text-[10px] font-bold px-2 py-0.5 rounded-md uppercase border shrink-0 ${\n                        job.status === \"COMPLETED\"\n                          ? \"bg-emerald-500/10 text-emerald-400 border-emerald-500/30\"\n                          : job.status === \"AWAITING_APPROVAL\"\n                          ? \"bg-amber-500/10 text-amber-300 border-amber-500/30 animate-pulse shadow-[0_0_8px_rgba(245,158,11,0.2)]\"\n                          : job.status === \"AWAITING_PREMIUM\"\n                          ? \"bg-purple-500/10 text-purple-300 border-purple-500/30\"\n                          : \"bg-indigo-500/10 text-indigo-300 border-indigo-500/30\"\n                      }`}>\n                        {job.status.replace(\"_\", \" \")}\n                      </span>\n                    </div>\n\n                    {/* Progress Bar */}\n                    <div className=\"mt-3.5\">\n                      <div className=\"flex justify-between text-[10px] text-zinc-400 mb-1.5 font-mono\">\n                        <span>{job.stages.length}/10 Stages</span>\n                        <span>{Math.round((job.stages.length / 10) * 100)}%</span>\n                      </div>\n                      <div className=\"w-full bg-[#18181b] border border-[#27272a] rounded-full h-1.5 overflow-hidden\">\n                        <div \n                          className={`h-full rounded-full transition-all duration-300 ${\n                            job.status === \"COMPLETED\" ? \"bg-emerald-400\" : \"bg-indigo-500\"\n                          }`}\n                          style={{ width: `${(job.stages.length / 10) * 100}%` }}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Selected Job Details & Stage Actions */}\n        <div className=\"lg:col-span-8 space-y-5\">\n          {selectedJob ? (\n            <>\n              {/* Job Banner with Controls */}\n              <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#27272a]\">\n                  <div>\n                    <div className=\"flex items-center gap-2.5\">\n                      <span className=\"text-xs font-mono font-bold text-indigo-400 bg-[#09090b] border border-[#27272a] px-2.5 py-1 rounded-lg\">\n                        JOB #{selectedJob.id}\n                      </span>\n                      <h2 className=\"text-lg font-bold text-[#fafafa]\">{selectedJob.niche}</h2>\n                    </div>\n                    <div className=\"flex flex-wrap items-center gap-3 text-xs text-zinc-400 mt-2\">\n                      <span>Format: <strong className=\"text-zinc-200\">{selectedJob.config.format || \"9:16\"}</strong></span>\n                      <span>\342\200\242</span>\n                      <span>Target: <strong className=\"text-zinc-200\">TikTok, Reels, Shorts</strong></span>\n                      {selectedJob.config.premium && (\n                        <span className=\"px-2 py-0.5 rounded-md bg-purple-500/10 text-purple-300 border border-purple-500/30 font-semibold text-[11px]\">\n                          PREMIUM VEO 3.1 MODE\n                        </span>\n                      )}\n                    </div>\n                  </div>\n\n                  {/* Stage Advance / Trigger Button */}\n                  <div className=\"flex items-center gap-2\">\n                    {selectedJob.status !== \"COMPLETED\" && (\n                      <button\n                        id=\"advance-stage-btn\"\n                        onClick={() => onAdvanceStage(selectedJob.id)}\n                        disabled={isAdvancing || selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\"}\n                        className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all cursor-pointer ${\n                          selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\"\n                            ? \"bg-zinc-800 text-zinc-500 cursor-not-allowed border border-zinc-700\"\n                            : \"bg-indigo-600 hover:bg-indigo-500 text-white shadow-[0_0_15px_rgba(79,70,229,0.3)]\"\n                        }`}\n                      >\n                        {isAdvancing ? (\n                          <>\n                            <RotateCcw className=\"w-4 h-4 animate-spin\" />\n                            <span>Agent Executing...</span>\n                          </>\n                        ) : (\n                          <>\n                            <Play className=\"w-4 h-4 fill-white\" />\n                            <span>Run Next Stage ({STAGES[Math.min(STAGES.length - 1, STAGES.findIndex(s => s.key === selectedJob.current_stage) + 1)]?.name})</span>\n                          </>\n                        )}\n                      </button>\n                    )}\n                  </div>\n                </div>\n\n                {/* HITL Approval Gate Action Box (if paused at SCRIPT, QC1, QC2) */}\n                {selectedJob.status === \"AWAITING_APPROVAL\" && (\n                  <div className=\"mt-5 p-4 bg-indigo-500/5 border border-indigo-500/20 rounded-2xl text-zinc-200 space-y-3\">\n                    <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0\">\n                          <ShieldCheck className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"font-bold text-xs text-amber-300 uppercase tracking-wide\">\n                            Approval Gate: {selectedJob.current_stage} Review Required\n                          </h4>\n                          <p className=\"text-xs text-zinc-400\">\n                            The autonomous pipeline is paused awaiting your review before proceeding.\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          id=\"approve-stage-btn\"\n                          onClick={() => onApproveStage(selectedJob.id)}\n                          className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-[0_0_10px_rgba(79,70,229,0.3)] transition cursor-pointer\"\n                        >\n                          <Check className=\"w-3.5 h-3.5\" />\n                          <span>APPROVE</span>\n                        </button>\n                        <button\n                          id=\"reject-stage-toggle\"\n                          onClick={() => setShowRejectInput(!showRejectInput)}\n                          className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 font-semibold text-xs transition cursor-pointer\"\n                        >\n                          <X className=\"w-3.5 h-3.5\" />\n                          <span>REJECT</span>\n                        </button>\n                      </div>\n                    </div>\n\n                    {showRejectInput && (\n                      <div className=\"flex items-center gap-2 pt-3 border-t border-indigo-500/10\">\n                        <input\n                          type=\"text\"\n                          value={rejectReason}\n                          onChange={(e) => setRejectReason(e.target.value)}\n                          placeholder=\"Reason for revision (e.g., Hook needs more urgency)...\"\n                          className=\"flex-1 bg-[#09090b] border border-[#27272a] text-white text-xs rounded-xl px-3.5 py-2 focus:outline-none focus:border-indigo-500\"\n                        />\n                        <button\n                          onClick={() => {\n                            onRejectStage(selectedJob.id, rejectReason);\n                            setRejectReason(\"\");\n                            setShowRejectInput(false);\n                          }}\n                          className=\"px-3.5 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-xl cursor-pointer\"\n                        >\n                          Submit Revision\n                        </button>\n                      </div>\n                    )}\n                  </div>\n                )}\n\n                {/* AWAITING_PREMIUM Gate Box */}\n                {selectedJob.status === \"AWAITING_PREMIUM\" && (\n                  <div className=\"mt-5 p-4 rounded-2xl bg-amber-500/5 border border-amber-500/20 text-zinc-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex items-center gap-2.5\">\n                      <div className=\"w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0\">\n                        <UploadCloud className=\"w-4 h-4\" />\n                      </div>\n                      <div>\n                        <h4 className=\"font-bold text-xs text-amber-300 uppercase tracking-wide\">\n                          Premium Video Generation Required (Veo 3.1 / Flow)\n                        </h4>\n                        <p className=\"text-xs text-zinc-400\">\n                          Attach 4K high-bitrate video render to satisfy premium production specs.\n                        </p>\n                      </div>\n                    </div>\n                    <button\n                      id=\"upload-premium-btn\"\n                      onClick={() => onUploadPremium(selectedJob.id)}\n                      className=\"flex items-center gap-2 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-[0_0_15px_rgba(79,70,229,0.3)] transition cursor-pointer shrink-0\"\n                    >\n                      <Video className=\"w-4 h-4\" />\n                      <span>Attach 4K Veo Render</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Stage Outputs Timeline */}\n              <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h3 className=\"text-sm font-semibold text-zinc-300 uppercase tracking-wider flex items-center gap-2\">\n                    <Clock className=\"w-4 h-4 text-indigo-400\" />\n                    Stage Execution Output Log\n                  </h3>\n                  <span className=\"text-xs text-zinc-400 font-mono\">\n                    {selectedJob.stages.length} Completed Stages\n                  </span>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {selectedJob.stages.map((st, i) => (\n                    <div key={st.id || i} className=\"p-4 rounded-2xl bg-[#09090b] border border-[#27272a] space-y-2.5\">\n                      <div className=\"flex items-center justify-between\">\n                        <div className=\"flex items-center gap-2.5\">\n                          <span className=\"w-6 h-6 rounded-full bg-indigo-500/10 text-indigo-400 font-mono text-xs flex items-center justify-center font-bold border border-indigo-500/20\">\n                            {i + 1}\n                          </span>\n                          <span className=\"font-bold text-xs text-[#fafafa] uppercase tracking-wide\">{st.stage}</span>\n                          <span className=\"text-[11px] text-zinc-500 font-mono\">\n                            {new Date(st.timestamp).toLocaleTimeString()}\n                          </span>\n                        </div>\n                        <span className=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20\">\n                          SUCCESS\n                        </span>\n                      </div>\n\n                      {/* Render formatted preview depending on stage */}\n                      {st.stage === \"IDEA\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-1\">\n                          <p><strong>Target Audience:</strong> {st.output.target_audience}</p>\n                          <p><strong>Core Mission:</strong> {st.output.core_mission}</p>\n                          {st.output.ai_directive && (\n                            <p className=\"p-2.5 rounded-xl bg-[#18181b] text-indigo-300 border border-[#27272a] italic\">\n                              \"{st.output.ai_directive}\"\n                            </p>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"RESEARCH\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-1.5\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-semibold\">Virality Score:</span>\n                            <span className=\"px-2 py-0.5 rounded-md bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 font-mono font-bold text-[11px]\">\n                              {st.output.virality_score || 93.4}/100\n                            </span>\n                          </div>\n                          <p><strong>Selected Angle:</strong> {st.output.selected_angle}</p>\n                          {st.output.insights && (\n                            <p className=\"p-2.5 rounded-xl bg-[#18181b] text-zinc-300 border border-[#27272a] whitespace-pre-line text-[11px]\">\n                              {st.output.insights}\n                            </p>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"SCRIPT\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-2\">\n                          <div className=\"p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-200\">\n                            <strong>\342\232\241 3-Second Hook:</strong> \"{st.output.hook}\"\n                          </div>\n                          {st.output.full_script && (\n                            <pre className=\"p-3 rounded-xl bg-[#18181b] text-zinc-300 border border-[#27272a] text-[11px] whitespace-pre-wrap font-sans\">\n                              {st.output.full_script}\n                            </pre>\n                          )}\n                          {st.output.hashtags && (\n                            <div className=\"flex flex-wrap gap-1 mt-1\">\n                              {st.output.hashtags.map((h: string, hi: number) => (\n                                <span key={hi} className=\"text-[10px] px-2 py-0.5 rounded-md bg-[#18181b] border border-[#27272a] text-indigo-400 font-mono\">\n                                  {h}\n                                </span>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      )}\n\n                      {st.stage === \"STYLE\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-1.5\">\n                          <p><strong>Archetype:</strong> {st.output.archetype || st.output.visual_archetype}</p>\n                          <div className=\"flex items-center gap-2\">\n                            <span>Palette:</span>\n                            {(st.output.palette || [\"#09090b\", \"#4f46e5\", \"#10b981\"]).map((c: string, ci: number) => (\n                              <span \n                                key={ci} \n                                className=\"w-5 h-5 rounded-md border border-zinc-700 inline-block\" \n                                style={{ backgroundColor: c }} \n                                title={c} \n                              />\n                            ))}\n                          </div>\n                          <p><strong>Cut Pacing:</strong> {st.output.cut_pacing_sec || \"Every 1.8s\"}</p>\n                          <p><strong>Audio:</strong> {st.output.bg_music || \"118 BPM Tension Synth\"}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"ART\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-2\">\n                          <p className=\"font-semibold text-zinc-200\">Veo 3.1 & Nano-Banana Shot Storyboard:</p>\n                          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                            {(st.output.veo_prompts || [\n                              \"Shot 1: Extreme close up holographic interface\",\n                              \"Shot 2: Modern dark workspace neon overlays\"\n                            ]).map((prompt: string, pi: number) => (\n                              <div key={pi} className=\"p-2.5 rounded-xl bg-[#18181b] border border-[#27272a] text-[11px]\">\n                                <span className=\"font-bold text-indigo-400\">Shot {pi + 1}: </span>\n                                {prompt}\n                              </div>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n\n                      {st.stage === \"VIDEO\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-1\">\n                          <p><strong>Assembly Engine:</strong> {st.output.engine}</p>\n                          <p><strong>Resolution:</strong> {st.output.resolution || \"1080x1920 60FPS\"}</p>\n                          <p><strong>Pacing Score:</strong> {st.output.pacing_score || 96.4}%</p>\n                          <p className=\"font-mono text-[11px] text-indigo-400\">Master Path: {st.output.video_url || \"/vault/renders/final.mp4\"}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"QC1\" || st.stage === \"QC2\" ? (\n                        <div className=\"text-xs text-zinc-300 space-y-1\">\n                          <p><strong>Audit Status:</strong> <span className=\"text-emerald-400 font-bold\">PASSED</span></p>\n                          <p><strong>Originality:</strong> {st.output.originality_score || 98.4}%</p>\n                          {st.output.av_sync_offset_ms !== undefined && (\n                            <p><strong>AV Sync Offset:</strong> {st.output.av_sync_offset_ms}ms (Perfect)</p>\n                          )}\n                        </div>\n                      ) : null}\n\n                      {st.stage === \"POST\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-1\">\n                          <p><strong>Postiz Status:</strong> {st.output.status}</p>\n                          <p><strong>Dispatched To:</strong> {(st.output.platforms || [\"TikTok\", \"IG Reels\", \"YT Shorts\"]).join(\", \")}</p>\n                        </div>\n                      )}\n\n                      {st.stage === \"ANALYZE\" && (\n                        <div className=\"text-xs text-zinc-300 space-y-2\">\n                          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-1\">\n                            <div className=\"p-3 rounded-xl bg-[#18181b] border border-[#27272a] text-center\">\n                              <div className=\"text-zinc-500 text-[10px] font-semibold uppercase\">VIEWS</div>\n                              <div className=\"text-base font-bold text-indigo-400 font-mono mt-0.5\">\n                                {selectedJob.analytics?.views.toLocaleString() || \"148,200\"}\n                              </div>\n                            </div>\n                            <div className=\"p-3 rounded-xl bg-[#18181b] border border-[#27272a] text-center\">\n                              <div className=\"text-zinc-500 text-[10px] font-semibold uppercase\">RETENTION</div>\n                              <div className=\"text-base font-bold text-emerald-400 font-mono mt-0.5\">\n                                {selectedJob.analytics?.retention_rate || 76.4}%\n                              </div>\n                            </div>\n                            <div className=\"p-3 rounded-xl bg-[#18181b] border border-[#27272a] text-center\">\n                              <div className=\"text-zinc-500 text-[10px] font-semibold uppercase\">SHARES</div>\n                              <div className=\"text-base font-bold text-amber-400 font-mono mt-0.5\">\n                                {selectedJob.analytics?.shares.toLocaleString() || \"2,840\"}\n                              </div>\n                            </div>\n                            <div className=\"p-3 rounded-xl bg-[#18181b] border border-[#27272a] text-center\">\n                              <div className=\"text-zinc-500 text-[10px] font-semibold uppercase\">REVENUE</div>\n                              <div className=\"text-base font-bold text-emerald-400 font-mono mt-0.5\">\n                                ${selectedJob.analytics?.revenue.toFixed(2) || \"64.20\"}\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Assets & Token Costs Dual Bento Panel */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {/* Assets List Bento */}\n                <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 shadow-sm\">\n                  <h4 className=\"font-bold text-xs text-white uppercase tracking-wider mb-3.5 flex items-center gap-1.5\">\n                    <Video className=\"w-4 h-4 text-indigo-400\" />\n                    Registered Vault Assets ({selectedJob.assets.length})\n                  </h4>\n                  <div className=\"space-y-2 max-h-48 overflow-y-auto pr-1\">\n                    {selectedJob.assets.map(a => (\n                      <div key={a.id} className=\"p-3 rounded-xl bg-[#09090b] border border-[#27272a] flex items-center justify-between text-xs\">\n                        <div className=\"flex items-center gap-2.5\">\n                          {a.type === \"SCRIPT\" && <FileText className=\"w-4 h-4 text-indigo-400\" />}\n                          {a.type === \"AUDIO\" && <Music className=\"w-4 h-4 text-amber-400\" />}\n                          {a.type === \"VIDEO\" && <Video className=\"w-4 h-4 text-emerald-400\" />}\n                          {a.type === \"IMAGE\" && <ImageIcon className=\"w-4 h-4 text-purple-400\" />}\n                          <div>\n                            <div className=\"font-semibold text-white\">{a.description}</div>\n                            <div className=\"text-[10px] text-zinc-500 font-mono\">{a.path}</div>\n                          </div>\n                        </div>\n                        <span className=\"text-[10px] font-mono font-semibold px-2 py-0.5 rounded-md bg-[#18181b] border border-[#27272a] text-zinc-300\">\n                          {a.type}\n                        </span>\n                      </div>\n                    ))}\n                    {selectedJob.assets.length === 0 && (\n                      <div className=\"text-xs text-zinc-500 text-center py-4\">No assets generated yet.</div>\n                    )}\n                  </div>\n                </div>\n\n                {/* Per-Agent Cost Breakdown Bento */}\n                <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 shadow-sm\">\n                  <h4 className=\"font-bold text-xs text-white uppercase tracking-wider mb-3.5 flex items-center gap-1.5\">\n                    <Coins className=\"w-4 h-4 text-emerald-400\" />\n                    Agent Cost Ledger ({selectedJob.costs.reduce((acc, c) => acc + c.usd_estimate, 0).toFixed(4)} USD)\n                  </h4>\n                  <div className=\"space-y-2 max-h-48 overflow-y-auto pr-1\">\n                    {selectedJob.costs.map((c, idx) => (\n                      <div key={idx} className=\"flex items-center justify-between text-xs p-2.5 rounded-xl bg-[#09090b] border border-[#27272a]\">\n                        <span className=\"font-semibold text-zinc-300\">{c.agent_name}</span>\n                        <div className=\"flex items-center gap-3 font-mono text-[11px]\">\n                          <span className=\"text-zinc-500\">{c.tokens} toks</span>\n                          <span className=\"text-emerald-400 font-bold\">${c.usd_estimate.toFixed(4)}</span>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </>\n          ) : (\n            <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-12 text-center text-zinc-400\">\n              <Sparkles className=\"w-8 h-8 text-indigo-400 mx-auto mb-3 opacity-60\" />\n              <h3 className=\"font-bold text-white text-base\">Select a Job from Queue</h3>\n              <p className=\"text-xs text-zinc-400 max-w-sm mx-auto mt-1\">\n                Choose an active or completed job on the left to inspect stage history, approve gates, or trigger the next agent.\n              </p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Bento Card: Fleet Status row matching design */}\n      <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm\">\n        <div className=\"flex justify-between items-center mb-5\">\n          <h2 className=\"text-sm font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n            Fleet Status\n          </h2>\n          <span className=\"text-[10px] text-zinc-500 uppercase tracking-widest font-mono\">9 Autonomous Agents</span>\n        </div>\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-3.5\">\n          {[\n            { role: \"MANAGER\", name: \"ManagerAgent\", status: \"ONLINE\", busy: false },\n            { role: \"RESEARCHER\", name: \"ResearcherAgent\", status: \"SEARCHING\", busy: true },\n            { role: \"SCRIPTWRITER\", name: \"ScriptwriterAgent\", status: \"IDLE\", busy: false },\n            { role: \"ART DIRECTOR\", name: \"ArtDirectorAgent\", status: \"IDLE\", busy: false },\n            { role: \"QUALITY CONTROL\", name: \"QualityControlAgent\", status: \"ONLINE\", busy: false }\n          ].map((agent, i) => (\n            <div \n              key={i} \n              className={`bg-[#09090b] p-4 rounded-2xl border text-center transition-all ${\n                agent.busy \n                  ? \"border-indigo-500/40 ring-1 ring-indigo-500/20 shadow-[0_0_12px_rgba(79,70,229,0.15)]\" \n                  : \"border-[#27272a]\"\n              }`}\n            >\n              <div className=\"w-8 h-8 mx-auto mb-2.5 rounded-full bg-emerald-500/10 flex items-center justify-center\">\n                <div className={`w-2 h-2 rounded-full ${agent.busy ? \"bg-indigo-400 animate-ping\" : \"bg-emerald-500\"}`} />\n              </div>\n              <p className=\"text-xs font-bold text-[#fafafa]\">{agent.role}</p>\n              <p className=\"text-[10px] text-zinc-500 mt-0.5 font-mono\">{agent.status}</p>\n            </div>\n          ))}\n        </div>\n        <div className=\"mt-5 pt-4 border-t border-[#27272a] flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 font-mono gap-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n            <span>Telegram Webhook Connected: @content_factory_hitl_bot</span>\n          </div>\n          <span>Polling: 1000ms \342\200\242 APScheduler Active</span>\n        </div>\n      </div>"
      }
      num_matches: 1
    }
  }
}
