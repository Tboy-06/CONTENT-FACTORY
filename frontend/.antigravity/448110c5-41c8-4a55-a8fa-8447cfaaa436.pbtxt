  file_change {
    absolute_path_uri: "file:///src/components/AgentsStudio.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  Bot, \n  Cpu, \n  Sparkles, \n  Wrench, \n  Video, \n  CheckCircle, \n  Search, \n  Palette, \n  FileText, \n  BarChart3, \n  Send \n} from \"lucide-react\";\n\ninterface AgentDef {\n  id: string;\n  name: string;\n  role: string;\n  model: string;\n  phase: string;\n  tools: string[];\n  description: string;\n  inputFormat: string;\n  outputFormat: string;\n}\n\nconst AGENTS: AgentDef[] = [\n  {\n    id: \"manager\",\n    name: \"ManagerAgent\",\n    role: \"Strategic Executive Director\",\n    model: \"gemini-3.7-flash\",\n    phase: \"Phase 1: Brain\",\n    tools: [\"Vault Repository\", \"Telegram Dispatcher\"],\n    description: \"Translates high-level niche goals into deterministic 10-stage execution plans, sets retention benchmarks, and coordinates agent handoffs.\",\n    inputFormat: \"{ niche: string, config: { format, platforms, premium } }\",\n    outputFormat: \"{ target_audience, core_mission, target_duration, goal_views }\"\n  },\n  {\n    id: \"researcher\",\n    name: \"ResearcherAgent\",\n    role: \"Virality Intelligence Scout\",\n    model: \"gemini-3.7-flash\",\n    phase: \"Phase 1: Brain\",\n    tools: [\"YouTube Data API v3\", \"Tavily Search\", \"SerpAPI\", \"Firecrawl\"],\n    description: \"Scrapes competitor breakout videos, detects emerging search queries, and scores niche virality angles from 0-100.\",\n    inputFormat: \"{ niche: string, top_results_limit: 5 }\",\n    outputFormat: \"{ virality_score, selected_angle, competitor_benchmarks, synthesis }\"\n  },\n  {\n    id: \"scriptwriter\",\n    name: \"ScriptwriterAgent\",\n    role: \"Retention & Hook Architect\",\n    model: \"gemini-2.5-pro\",\n    phase: \"Phase 1: Brain\",\n    tools: [\"HookFormula Vault\", \"Character Bible\"],\n    description: \"Constructs 35-40 second vertical scripts with a 3-second psychological hook, 3-act tension loop, and high-converting CTA.\",\n    inputFormat: \"{ niche: string, selected_angle: string }\",\n    outputFormat: \"{ hook, act_1, act_2, act_3, cta, hashtags, platform_variants }\"\n  },\n  {\n    id: \"style_analyst\",\n    name: \"StyleAnalystAgent\",\n    role: \"Visual DNA & Aesthetic Engine\",\n    model: \"gemini-vision\",\n    phase: \"Phase 2: Creative\",\n    tools: [\"Gemini Vision Frame Extractor\", \"StyleGuide Vault\"],\n    description: \"Analyzes top-performing reference videos to synthesize visual DNA: color palettes, cut frequencies (e.g. 1.8s), and background music genres.\",\n    inputFormat: \"{ reference_frames: string[], niche: string }\",\n    outputFormat: \"{ visual_archetype, primary_color, accent_neon, cut_frequency, bg_music }\"\n  },\n  {\n    id: \"art_director\",\n    name: \"ArtDirectorAgent\",\n    role: \"Prompt Pack & Storyboard Designer\",\n    model: \"gemini-2.5-pro\",\n    phase: \"Phase 2: Creative\",\n    tools: [\"Veo Prompt Generator\", \"Character Bible Vault\"],\n    description: \"Creates detailed 5-shot prompt packs for Veo 3.1 & Nano-Banana image generation with consistent character bibles and camera moves.\",\n    inputFormat: \"{ script: string, style_dna: object }\",\n    outputFormat: \"{ shot_list: Array<{ veo_prompt, camera_motion, audio_cue }>, character_bible }\"\n  },\n  {\n    id: \"video_editor\",\n    name: \"VideoEditorAgent\",\n    role: \"Assembly & Pacing Engineer\",\n    model: \"veo-3.1 / Edge-TTS\",\n    phase: \"Phase 2: Creative\",\n    tools: [\"FFmpeg Complex Filtergraph\", \"Edge-TTS\", \"ASS Subtitle Generator\"],\n    description: \"Assembles narration, B-roll, dynamic pop-in captions, and audio ducking. Escalates to AWAITING_PREMIUM if high-end render is required.\",\n    inputFormat: \"{ script: object, prompt_pack: object, audio_track: string }\",\n    outputFormat: \"{ video_path, resolution: 1080x1920, fps: 60, pacing_score }\"\n  },\n  {\n    id: \"quality_control\",\n    name: \"QualityControlAgent\",\n    role: \"Automated Policy & AV Sync Auditor\",\n    model: \"gemini-3.7-flash\",\n    phase: \"Phases 1 & 2 (Gates QC1 & QC2)\",\n    tools: [\"Jina Similarity\", \"FFmpeg EBU R128 Loudness Audit\"],\n    description: \"Verifies originality (Jina), platform policy compliance, audio loudness (-14 LUFS), and TikTok UI margin safe zones.\",\n    inputFormat: \"{ script_or_video: object, stage: \'QC1\' | \'QC2\' }\",\n    outputFormat: \"{ passed: boolean, originality_score, loudness_lufs, av_sync_offset_ms }\"\n  },\n  {\n    id: \"poster\",\n    name: \"PosterAgent\",\n    role: \"Multi-Platform Social Dispatcher\",\n    model: \"gemini-3.7-flash\",\n    phase: \"Phase 3: Distribution\",\n    tools: [\"Postiz API Client\", \"Schedule Optimizer\"],\n    description: \"Connects to Postiz API to upload final 1080x1920 MP4 files, applies platform-optimized captions/hashtags, and schedules peak time dispatch.\",\n    inputFormat: \"{ video_path: string, captions: object, platforms: string[] }\",\n    outputFormat: \"{ postiz_id, scheduled_time, live_urls }\"\n  },\n  {\n    id: \"analyst\",\n    name: \"AnalystAgent\",\n    role: \"Performance & Feedback Loop\",\n    model: \"gemini-3.7-flash\",\n    phase: \"Phase 4: Intelligence\",\n    tools: [\"Postiz Analytics API\", \"Retention Curve Analyzer\"],\n    description: \"Measures 3-second dropoff, total views, creator rewards, and feeds winning hook formulas back into the StyleGuide vault.\",\n    inputFormat: \"{ post_id: string, job_id: number }\",\n    outputFormat: \"{ viral_score, retention_curve, creator_reward_usd, feedback_learnings }\"\n  }\n];\n\nexport const AgentsStudio: React.FC = () => {\n  const [selectedAgent, setSelectedAgent] = useState<AgentDef>(AGENTS[0]);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Overview Card */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2\">\n              <Bot className=\"w-4 h-4 text-cyan-400\" />\n              9 Autonomous Production Agents & Integrated Tools\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Each specialized agent operates autonomously with dedicated LLM prompts, input/output schemas, and toolchains.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 text-xs\">\n            <span className=\"px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-mono\">\n              9 Agents Active\n            </span>\n            <span className=\"px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono\">\n              Server-Side Only\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Agents Grid & Detail View */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left: Agent Selection List */}\n        <div className=\"lg:col-span-5 space-y-2.5\">\n          {AGENTS.map((agent) => {\n            const isSelected = selectedAgent.id === agent.id;\n            return (\n              <div\n                key={agent.id}\n                onClick={() => setSelectedAgent(agent)}\n                className={`p-3.5 rounded-xl border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"border-cyan-500 bg-cyan-950/30 shadow-md shadow-cyan-500/10\"\n                    : \"border-slate-800/80 bg-slate-900/50 hover:border-slate-700 hover:bg-slate-800/40\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div className=\"w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-cyan-400 font-bold text-xs\">\n                      {agent.name.slice(0, 2)}\n                    </div>\n                    <div>\n                      <h4 className=\"font-bold text-xs text-white\">{agent.name}</h4>\n                      <p className=\"text-[11px] text-slate-400\">{agent.role}</p>\n                    </div>\n                  </div>\n                  <span className=\"text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-800 text-cyan-300\">\n                    {agent.model}\n                  </span>\n                </div>\n                <div className=\"flex items-center gap-2 mt-2 text-[10px] text-slate-500\">\n                  <span>{agent.phase}</span>\n                  <span>\342\200\242</span>\n                  <span>{agent.tools.length} Tools</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right: Selected Agent Deep Dive */}\n        <div className=\"lg:col-span-7 space-y-5\">\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-5\">\n            <div className=\"flex items-start justify-between border-b border-slate-800/80 pb-4\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"text-base font-extrabold text-white\">{selectedAgent.name}</h3>\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\">\n                    {selectedAgent.phase}\n                  </span>\n                </div>\n                <p className=\"text-xs text-cyan-400 font-medium mt-0.5\">{selectedAgent.role}</p>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-[10px] text-slate-400 block font-mono\">PRIMARY ENGINE</span>\n                <span className=\"text-xs font-bold text-emerald-400 font-mono\">{selectedAgent.model}</span>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-300 leading-relaxed\">\n              {selectedAgent.description}\n            </p>\n\n            {/* Tools Integrated */}\n            <div>\n              <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <Wrench className=\"w-3.5 h-3.5 text-cyan-400\" />\n                Integrated Tools & External APIs\n              </h4>\n              <div className=\"flex flex-wrap gap-2\">\n                {selectedAgent.tools.map((tool, ti) => (\n                  <span key={ti} className=\"text-xs px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-slate-200 font-mono\">\n                    {tool}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            {/* Input / Output Contracts */}\n            <div className=\"space-y-3 pt-2\">\n              <div>\n                <span className=\"text-[11px] font-mono text-slate-400 block mb-1\">INPUT SCHEMA CONTRACT</span>\n                <pre className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-cyan-300 overflow-x-auto\">\n                  {selectedAgent.inputFormat}\n                </pre>\n              </div>\n              <div>\n                <span className=\"text-[11px] font-mono text-slate-400 block mb-1\">OUTPUT PAYLOAD CONTRACT</span>\n                <pre className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-emerald-300 overflow-x-auto\">\n                  {selectedAgent.outputFormat}\n                </pre>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
