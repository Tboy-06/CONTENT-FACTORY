    absolute_path_uri: "file:///src/components/N8nWorkflowCanvas.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \"react\";\nimport { \n  Job, \n  PipelineStage \n} from \"../types\";\nimport { \n  Lightbulb, \n  Search, \n  FileText, \n  CheckSquare, \n  Palette, \n  Image as ImageIcon, \n  Video, \n  Clock, \n  ShieldCheck, \n  UploadCloud, \n  BarChart2, \n  Plus, \n  Minus, \n  Maximize2, \n  Lock, \n  Unlock, \n  Play, \n  Sparkles, \n  Bot, \n  Check, \n  X, \n  ChevronRight, \n  AlertCircle,\n  Film,\n  Coins,\n  Cpu,\n  Layers,\n  ExternalLink,\n  Workflow\n} from \"lucide-react\";\n\ninterface N8nWorkflowCanvasProps {\n  jobs: Job[];\n  selectedJob: Job | null;\n  onSelectJob: (job: Job) => void;\n  onAdvanceStage: (jobId: number) => Promise<void>;\n  onApproveStage: (jobId: number) => Promise<void>;\n  onRejectStage: (jobId: number, reason: string) => Promise<void>;\n  onUploadPremium: (jobId: number) => Promise<void>;\n  onOpenNewJob: () => void;\n  isAdvancing: boolean;\n}\n\ninterface WorkflowNode {\n  id: string;\n  stageKey: PipelineStage | \"AWAITING_PREMIUM\";\n  name: string;\n  icon: React.ComponentType<{ className?: string }>;\n  agentName: string;\n  role: string;\n  model: string;\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  isGate?: boolean;\n}\n\nconst WORKFLOW_NODES: WorkflowNode[] = [\n  // Row 1 (Left to Right)\n  {\n    id: \"IDEA\",\n    stageKey: \"IDEA\",\n    name: \"IDEA\",\n    icon: Lightbulb,\n    agentName: \"Manager\",\n    role: \"ORCHESTRATION\",\n    model: \"gemini-3.6-flash\",\n    x: 60,\n    y: 80,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"RESEARCH\",\n    stageKey: \"RESEARCH\",\n    name: \"RESEARCH\",\n    icon: Search,\n    agentName: \"Researcher\",\n    role: \"RESEARCH OPS\",\n    model: \"gemini-3.6-flash\",\n    x: 320,\n    y: 80,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"SCRIPT\",\n    stageKey: \"SCRIPT\",\n    name: \"SCRIPT\",\n    icon: FileText,\n    agentName: \"Scriptwriter\",\n    role: \"CREATIVE\",\n    model: \"gemini-3.6-flash\",\n    x: 580,\n    y: 80,\n    w: 180,\n    h: 120,\n    isGate: true\n  },\n  {\n    id: \"QC1\",\n    stageKey: \"QC1\",\n    name: \"QC1\",\n    icon: CheckSquare,\n    agentName: \"Quality Control\",\n    role: \"AUDIT & SAFETY\",\n    model: \"gemini-3.6-flash\",\n    x: 840,\n    y: 80,\n    w: 180,\n    h: 120,\n    isGate: true\n  },\n\n  // Row 2 (Right to Left in flow)\n  {\n    id: \"STYLE\",\n    stageKey: \"STYLE\",\n    name: \"STYLE\",\n    icon: Palette,\n    agentName: \"Style Analyst\",\n    role: \"VISUAL INTEL\",\n    model: \"gemini-3.6-flash\",\n    x: 840,\n    y: 280,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"ART\",\n    stageKey: \"ART\",\n    name: \"ART\",\n    icon: ImageIcon,\n    agentName: \"Art Director\",\n    role: \"CREATIVE\",\n    model: \"gemini-3.6-pro\",\n    x: 580,\n    y: 280,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"VIDEO\",\n    stageKey: \"VIDEO\",\n    name: \"VIDEO\",\n    icon: Video,\n    agentName: \"Video Editor\",\n    role: \"ASSEMBLY\",\n    model: \"ffmpeg + veo\",\n    x: 320,\n    y: 280,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"AWAITING_PREMIUM\",\n    stageKey: \"AWAITING_PREMIUM\",\n    name: \"AWAITING_PREMIUM\",\n    icon: Clock,\n    agentName: \"Manager\",\n    role: \"PREMIUM GATE\",\n    model: \"gemini-3.6-flash\",\n    x: 60,\n    y: 280,\n    w: 180,\n    h: 120,\n    isGate: true\n  },\n\n  // Row 3 (Left to Right)\n  {\n    id: \"QC2\",\n    stageKey: \"QC2\",\n    name: \"QC2\",\n    icon: ShieldCheck,\n    agentName: \"Quality Control\",\n    role: \"AUDIT & SAFETY\",\n    model: \"gemini-3.6-flash\",\n    x: 60,\n    y: 480,\n    w: 180,\n    h: 120,\n    isGate: true\n  },\n  {\n    id: \"POST\",\n    stageKey: \"POST\",\n    name: \"POST\",\n    icon: UploadCloud,\n    agentName: \"Poster\",\n    role: \"DISTRIBUTION\",\n    model: \"postiz-api\",\n    x: 320,\n    y: 480,\n    w: 180,\n    h: 120\n  },\n  {\n    id: \"ANALYZE\",\n    stageKey: \"ANALYZE\",\n    name: \"ANALYZE\",\n    icon: BarChart2,\n    agentName: \"Analyst\",\n    role: \"PERFORMANCE\",\n    model: \"gemini-3.6-flash\",\n    x: 580,\n    y: 480,\n    w: 180,\n    h: 120\n  }\n];\n\n// Agent List for Left Sidebar (matching screenshot)\ninterface AgentSidebarItem {\n  id: string;\n  name: string;\n  role: string;\n  roleColor: string;\n  desc: string;\n  model: string;\n  statusColor: string;\n  nodeId: string;\n}\n\nconst SIDEBAR_AGENTS: AgentSidebarItem[] = [\n  {\n    id: \"manager\",\n    name: \"Manager\",\n    role: \"ORCHESTRATION\",\n    roleColor: \"text-amber-400\",\n    desc: \"Creates jobs and coordinates the pipeline\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-amber-400\",\n    nodeId: \"IDEA\"\n  },\n  {\n    id: \"researcher\",\n    name: \"Researcher\",\n    role: \"RESEARCH OPS\",\n    roleColor: \"text-cyan-400\",\n    desc: \"Finds trending topics and viral angles\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"RESEARCH\"\n  },\n  {\n    id: \"scriptwriter\",\n    name: \"Scriptwriter\",\n    role: \"CREATIVE\",\n    roleColor: \"text-purple-400\",\n    desc: \"Writes hook-driven scripts with 3 variants\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"SCRIPT\"\n  },\n  {\n    id: \"style_analyst\",\n    name: \"Style Analyst\",\n    role: \"VISUAL INTEL\",\n    roleColor: \"text-rose-400\",\n    desc: \"Extracts visual style guides from references\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"STYLE\"\n  },\n  {\n    id: \"art_director\",\n    name: \"Art Director\",\n    role: \"CREATIVE\",\n    roleColor: \"text-amber-400\",\n    desc: \"Plans shots, prompts, and character bible\",\n    model: \"gemini-3.6-pro\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"ART\"\n  },\n  {\n    id: \"video_editor\",\n    name: \"Video Editor\",\n    role: \"ASSEMBLY\",\n    roleColor: \"text-cyan-400\",\n    desc: \"Compiles timeline, captions, B-roll & sound FX\",\n    model: \"ffmpeg + veo\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"VIDEO\"\n  },\n  {\n    id: \"qc\",\n    name: \"Quality Control\",\n    role: \"AUDIT & SAFETY\",\n    roleColor: \"text-emerald-400\",\n    desc: \"Validates typography, timing, audio sync & policy\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"QC1\"\n  },\n  {\n    id: \"poster\",\n    name: \"Poster\",\n    role: \"DISTRIBUTION\",\n    roleColor: \"text-indigo-400\",\n    desc: \"Auto-publishes to TikTok, Reels, and Shorts via Postiz\",\n    model: \"postiz-api\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"POST\"\n  },\n  {\n    id: \"analyst\",\n    name: \"Analyst\",\n    role: \"PERFORMANCE\",\n    roleColor: \"text-emerald-400\",\n    desc: \"Monitors retention curves, CTR, and Creator Rewards\",\n    model: \"gemini-3.6-flash\",\n    statusColor: \"bg-emerald-400\",\n    nodeId: \"ANALYZE\"\n  }\n];\n\n// Linear pipeline stages for progression indexing\nconst PIPELINE_ORDER: string[] = [\n  \"IDEA\",\n  \"RESEARCH\",\n  \"SCRIPT\",\n  \"QC1\",\n  \"STYLE\",\n  \"ART\",\n  \"VIDEO\",\n  \"AWAITING_PREMIUM\",\n  \"QC2\",\n  \"POST\",\n  \"ANALYZE\"\n];\n\nexport const N8nWorkflowCanvas: React.FC<N8nWorkflowCanvasProps> = ({\n  jobs,\n  selectedJob,\n  onSelectJob,\n  onAdvanceStage,\n  onApproveStage,\n  onRejectStage,\n  onUploadPremium,\n  onOpenNewJob,\n  isAdvancing\n}) => {\n  const [selectedNodeId, setSelectedNodeId] = useState<string>(\"SCRIPT\");\n  const [scale, setScale] = useState(1);\n  const [pan, setPan] = useState({ x: 0, y: 0 });\n  const [isLocked, setIsLocked] = useState(false);\n  const [isDragging, setIsDragging] = useState(false);\n  const [dragStart, setDragStart] = useState({ x: 0, y: 0 });\n  const [rejectFeedback, setRejectFeedback] = useState(\"\");\n  const [showRejectForm, setShowRejectForm] = useState(false);\n  const [isSidebarCollapsed, setIsSidebarCollapsed] = useState(false);\n\n  const canvasRef = useRef<HTMLDivElement>(null);\n\n  // Determine stage status for a given node in the active job\n  const getNodeStatus = (node: WorkflowNode): \"completed\" | \"active\" | \"pending\" => {\n    if (!selectedJob) return \"pending\";\n    if (selectedJob.status === \"COMPLETED\") return \"completed\";\n\n    // Map job current_stage to virtual index\n    const jobStageKey = selectedJob.current_stage;\n    const currStageIdx = PIPELINE_ORDER.indexOf(jobStageKey);\n    const thisNodeIdx = PIPELINE_ORDER.indexOf(node.id);\n\n    // If this node is AWAITING_PREMIUM\n    if (node.id === \"AWAITING_PREMIUM\") {\n      if (selectedJob.status === \"AWAITING_PREMIUM\") return \"active\";\n      if (currStageIdx > PIPELINE_ORDER.indexOf(\"VIDEO\")) return \"completed\";\n      if (currStageIdx === PIPELINE_ORDER.indexOf(\"VIDEO\") && selectedJob.config.premium) return \"active\";\n      return \"pending\";\n    }\n\n    if (thisNodeIdx < currStageIdx) return \"completed\";\n    if (thisNodeIdx === currStageIdx) return \"active\";\n    return \"pending\";\n  };\n\n  // Active selected node object\n  const selectedNode = WORKFLOW_NODES.find(n => n.id === selectedNodeId) || WORKFLOW_NODES[2];\n\n  // Mouse pan handlers\n  const handleMouseDown = (e: React.MouseEvent) => {\n    if (isLocked) return;\n    // Don\'t drag if clicking inside node or control\n    if ((e.target as HTMLElement).closest(\".canvas-interactive\")) return;\n    setIsDragging(true);\n    setDragStart({ x: e.clientX - pan.x, y: e.clientY - pan.y });\n  };\n\n  const handleMouseMove = (e: React.MouseEvent) => {\n    if (!isDragging || isLocked) return;\n    setPan({ x: e.clientX - dragStart.x, y: e.clientY - dragStart.y });\n  };\n\n  const handleMouseUp = () => {\n    setIsDragging(false);\n  };\n\n  // Zoom controls\n  const handleZoomIn = () => setScale(prev => Math.min(1.4, prev + 0.1));\n  const handleZoomOut = () => setScale(prev => Math.max(0.65, prev - 0.1));\n  const handleResetView = () => {\n    setScale(1);\n    setPan({ x: 0, y: 0 });\n  };\n\n  // Output record from selected stage\n  const selectedStageData = selectedJob?.stages.find(\n    s => s.stage === selectedNode.stageKey || (selectedNode.id === \"AWAITING_PREMIUM\" && s.stage === \"VIDEO\")\n  );\n\n  return (\n    <div className=\"flex flex-1 h-[calc(100vh-108px)] w-full overflow-hidden bg-[#070b14] text-slate-100 select-none\">\n      {/* ============================================================ */}\n      {/* LEFT SIDEBAR: AGENTS (Directly matching screenshot)          */}\n      {/* ============================================================ */}\n      <aside \n        className={`${\n          isSidebarCollapsed ? \"w-14\" : \"w-72 sm:w-80\"\n        } shrink-0 bg-[#090e1a] border-r border-[#192437] flex flex-col transition-all duration-300 z-20`}\n      >\n        {/* Sidebar Header */}\n        <div className=\"p-4 border-b border-[#192437] flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <Bot className=\"w-5 h-5 text-cyan-400\" />\n            {!isSidebarCollapsed && (\n              <h2 className=\"text-xs font-bold uppercase tracking-widest text-cyan-400 font-sans\">\n                AGENTS\n              </h2>\n            )}\n          </div>\n          <button\n            onClick={() => setIsSidebarCollapsed(!isSidebarCollapsed)}\n            title={isSidebarCollapsed ? \"Expand Agents\" : \"Collapse Agents\"}\n            className=\"p-1 rounded text-slate-400 hover:text-slate-200 hover:bg-[#121c2d] transition cursor-pointer\"\n          >\n            <ChevronRight className={`w-4 h-4 transition-transform ${isSidebarCollapsed ? \"\" : \"rotate-180\"}`} />\n          </button>\n        </div>\n\n        {/* Scrollable Agent Cards List */}\n        <div className=\"flex-1 overflow-y-auto p-3 space-y-2.5 scrollbar-thin\">\n          {SIDEBAR_AGENTS.map((agent) => {\n            const isSelected = selectedNode?.id === agent.nodeId;\n            return (\n              <div\n                key={agent.id}\n                onClick={() => setSelectedNodeId(agent.nodeId)}\n                className={`rounded-xl p-3 border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"bg-[#111c2e] border-cyan-500/80 shadow-[0_0_15px_rgba(6,182,212,0.15)] ring-1 ring-cyan-500/40\"\n                    : \"bg-[#0d1525]/90 border-[#1c293e] hover:border-[#2d3f5e] hover:bg-[#101b2d]\"\n                }`}\n              >\n                <div className=\"flex items-start justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"w-7 h-7 rounded-lg bg-[#142236] border border-[#233550] flex items-center justify-center text-cyan-400 text-xs font-bold\">\n                      {agent.name.slice(0, 1)}\n                    </div>\n                    {!isSidebarCollapsed && (\n                      <div>\n                        <div className=\"text-xs font-bold text-slate-100 flex items-center gap-1.5\">\n                          <span>{agent.name}</span>\n                        </div>\n                        <div className={`text-[10px] font-bold tracking-wider uppercase ${agent.roleColor}`}>\n                          {agent.role}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  {/* Status dot */}\n                  <span className={`w-2 h-2 rounded-full ${agent.statusColor} shadow-[0_0_6px_currentColor]`} />\n                </div>\n\n                {!isSidebarCollapsed && (\n                  <>\n                    <p className=\"text-[11px] text-slate-400 mt-2 line-clamp-2 leading-relaxed\">\n                      {agent.desc}\n                    </p>\n                    <div className=\"mt-2.5 pt-2 border-t border-[#172338] flex items-center justify-between text-[10px]\">\n                      <span className=\"font-mono px-2 py-0.5 rounded bg-[#090f1d] border border-[#1d2c45] text-slate-300\">\n                        {agent.model}\n                      </span>\n                      <span className=\"text-cyan-400/80 hover:text-cyan-300 text-[10px] font-medium flex items-center gap-0.5\">\n                        Focus Node &rarr;\n                      </span>\n                    </div>\n                  </>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      </aside>\n\n      {/* ============================================================ */}\n      {/* MAIN CANVAS: n8n NODE GRAPH VIEWPORT                        */}\n      {/* ============================================================ */}\n      <div \n        ref={canvasRef}\n        onMouseDown={handleMouseDown}\n        onMouseMove={handleMouseMove}\n        onMouseUp={handleMouseUp}\n        className=\"flex-1 relative overflow-hidden bg-[#0a0f1d] bg-dot-grid cursor-grab active:cursor-grabbing\"\n      >\n        {/* Canvas Top Bar Overlay: Active Job Selector & Quick Execution Controls */}\n        <div className=\"absolute top-4 left-4 right-4 z-10 flex flex-wrap items-center justify-between gap-3 pointer-events-none\">\n          {/* Active Job Selector Pill */}\n          <div className=\"pointer-events-auto bg-[#0d1627]/95 border border-[#1c2b43] backdrop-blur-md rounded-2xl px-4 py-2 flex items-center gap-3 shadow-xl\">\n            <span className=\"text-[10px] font-mono uppercase tracking-widest text-slate-400 font-semibold\">\n              PIPELINE\n            </span>\n            <select\n              value={selectedJob?.id || \"\"}\n              onChange={(e) => {\n                const found = jobs.find(j => j.id === Number(e.target.value));\n                if (found) onSelectJob(found);\n              }}\n              className=\"bg-[#090f1b] border border-[#21324e] text-xs font-semibold text-white rounded-lg px-2.5 py-1 focus:outline-none focus:border-cyan-500 cursor-pointer max-w-[220px] sm:max-w-[340px] truncate\"\n            >\n              {jobs.map(j => (\n                <option key={j.id} value={j.id}>\n                  #{j.id}: {j.niche} [{j.status}]\n                </option>\n              ))}\n            </select>\n\n            {/* Status badge */}\n            {selectedJob && (\n              <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border ${\n                selectedJob.status === \"COMPLETED\"\n                  ? \"bg-emerald-500/10 text-emerald-400 border-emerald-500/30\"\n                  : selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\"\n                  ? \"bg-amber-500/10 text-amber-300 border-amber-500/30 animate-pulse\"\n                  : \"bg-cyan-500/10 text-cyan-300 border-cyan-500/30\"\n              }`}>\n                {selectedJob.status}\n              </span>\n            )}\n          </div>\n\n          {/* Quick Action CTA Bar */}\n          <div className=\"pointer-events-auto flex items-center gap-2\">\n            {selectedJob && selectedJob.status !== \"COMPLETED\" && (\n              <button\n                id=\"canvas-advance-stage-button\"\n                onClick={() => onAdvanceStage(selectedJob.id)}\n                disabled={isAdvancing}\n                className=\"flex items-center gap-1.5 bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-950 text-xs font-bold px-3.5 py-2 rounded-xl shadow-[0_0_15px_rgba(245,158,11,0.3)] transition cursor-pointer\"\n              >\n                <Play className=\"w-3.5 h-3.5 fill-current\" />\n                <span>{isAdvancing ? \"Executing Stage...\" : \"Advance Next Stage\"}</span>\n              </button>\n            )}\n\n            <button\n              id=\"canvas-new-job-button\"\n              onClick={onOpenNewJob}\n              className=\"flex items-center gap-1.5 bg-[#142237] hover:bg-[#1b2d49] border border-[#233857] text-cyan-300 text-xs font-bold px-3.5 py-2 rounded-xl transition cursor-pointer\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>New Pipeline</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Scalable & Pannable Graph World */}\n        <div\n          style={{\n            transform: `translate(${pan.x}px, ${pan.y}px) scale(${scale})`,\n            transformOrigin: \"0 0\",\n            transition: isDragging ? \"none\" : \"transform 0.15s ease-out\"\n          }}\n          className=\"absolute inset-0 w-[1100px] h-[700px]\"\n        >\n          {/* SVG Connection Cables Layer */}\n          <svg className=\"absolute inset-0 w-full h-full overflow-visible pointer-events-none\">\n            <defs>\n              {/* Gradient for active amber wire */}\n              <linearGradient id=\"activeAmberGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#10b981\" />\n                <stop offset=\"100%\" stopColor=\"#f59e0b\" />\n              </linearGradient>\n\n              {/* Marker dots */}\n              <filter id=\"glowGreen\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                <feDropShadow dx=\"0\" dy=\"0\" stdDeviation=\"3\" floodColor=\"#10b981\" />\n              </filter>\n              <filter id=\"glowAmber\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                <feDropShadow dx=\"0\" dy=\"0\" stdDeviation=\"4\" floodColor=\"#f59e0b\" />\n              </filter>\n            </defs>\n\n            {/* 1. IDEA -> RESEARCH */}\n            {(() => {\n              const from = WORKFLOW_NODES[0];\n              const to = WORKFLOW_NODES[1];\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && (toStatus === \"completed\" || toStatus === \"active\");\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c1\">\n                  <line\n                    x1={from.x + from.w}\n                    y1={from.y + from.h / 2}\n                    x2={to.x}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                    filter={isCompleted ? \"url(#glowGreen)\" : undefined}\n                  />\n                  {isActive && (\n                    <circle r=\"4\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w} ${from.y + from.h / 2} L ${to.x} ${to.y + to.h / 2}`}\n                        dur=\"1.5s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 2. RESEARCH -> SCRIPT (Orange active line with pulsing traveling dot in screenshot!) */}\n            {(() => {\n              const from = WORKFLOW_NODES[1];\n              const to = WORKFLOW_NODES[2];\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c2\">\n                  <line\n                    x1={from.x + from.w}\n                    y1={from.y + from.h / 2}\n                    x2={to.x}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                    filter={isActive ? \"url(#glowAmber)\" : isCompleted ? \"url(#glowGreen)\" : undefined}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\" filter=\"url(#glowAmber)\">\n                      <animateMotion\n                        path={`M ${from.x + from.w} ${from.y + from.h / 2} L ${to.x} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 3. SCRIPT -> QC1 */}\n            {(() => {\n              const from = WORKFLOW_NODES[2];\n              const to = WORKFLOW_NODES[3];\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c3\">\n                  <line\n                    x1={from.x + from.w}\n                    y1={from.y + from.h / 2}\n                    x2={to.x}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w} ${from.y + from.h / 2} L ${to.x} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 4. QC1 (Bottom) -> STYLE (Top) [Vertical line dropping to row 2] */}\n            {(() => {\n              const from = WORKFLOW_NODES[3]; // QC1 at (840, 80)\n              const to = WORKFLOW_NODES[4];   // STYLE at (840, 280)\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c4\">\n                  <line\n                    x1={from.x + from.w / 2}\n                    y1={from.y + from.h}\n                    x2={to.x + to.w / 2}\n                    y2={to.y}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w / 2} ${from.y + from.h} L ${to.x + to.w / 2} ${to.y}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 5. STYLE (Left) -> ART (Right) [Row 2, moving right to left] */}\n            {(() => {\n              const from = WORKFLOW_NODES[4]; // STYLE at x=840\n              const to = WORKFLOW_NODES[5];   // ART at x=580\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c5\">\n                  <line\n                    x1={from.x}\n                    y1={from.y + from.h / 2}\n                    x2={to.x + to.w}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x} ${from.y + from.h / 2} L ${to.x + to.w} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 6. ART (Left) -> VIDEO (Right) */}\n            {(() => {\n              const from = WORKFLOW_NODES[5]; // ART at x=580\n              const to = WORKFLOW_NODES[6];   // VIDEO at x=320\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c6\">\n                  <line\n                    x1={from.x}\n                    y1={from.y + from.h / 2}\n                    x2={to.x + to.w}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x} ${from.y + from.h / 2} L ${to.x + to.w} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 7. VIDEO (Left) -> AWAITING_PREMIUM (Right) */}\n            {(() => {\n              const from = WORKFLOW_NODES[6]; // VIDEO at x=320\n              const to = WORKFLOW_NODES[7];   // AWAITING_PREMIUM at x=60\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c7\">\n                  <line\n                    x1={from.x}\n                    y1={from.y + from.h / 2}\n                    x2={to.x + to.w}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x} ${from.y + from.h / 2} L ${to.x + to.w} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 8. AWAITING_PREMIUM (Bottom) -> QC2 (Top) [Vertical line dropping to row 3] */}\n            {(() => {\n              const from = WORKFLOW_NODES[7]; // AWAITING_PREMIUM at (60, 280)\n              const to = WORKFLOW_NODES[8];   // QC2 at (60, 480)\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c8\">\n                  <line\n                    x1={from.x + from.w / 2}\n                    y1={from.y + from.h}\n                    x2={to.x + to.w / 2}\n                    y2={to.y}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w / 2} ${from.y + from.h} L ${to.x + to.w / 2} ${to.y}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 9. QC2 (Right) -> POST (Left) [Row 3, moving left to right] */}\n            {(() => {\n              const from = WORKFLOW_NODES[8]; // QC2 at x=60\n              const to = WORKFLOW_NODES[9];   // POST at x=320\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c9\">\n                  <line\n                    x1={from.x + from.w}\n                    y1={from.y + from.h / 2}\n                    x2={to.x}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w} ${from.y + from.h / 2} L ${to.x} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n\n            {/* 10. POST (Right) -> ANALYZE (Left) */}\n            {(() => {\n              const from = WORKFLOW_NODES[9];  // POST at x=320\n              const to = WORKFLOW_NODES[10];   // ANALYZE at x=580\n              const fromStatus = getNodeStatus(from);\n              const toStatus = getNodeStatus(to);\n              const isCompleted = fromStatus === \"completed\" && toStatus === \"completed\";\n              const isActive = fromStatus === \"completed\" && toStatus === \"active\";\n              const strokeColor = isActive ? \"#f59e0b\" : isCompleted ? \"#10b981\" : \"#283952\";\n              return (\n                <g key=\"c10\">\n                  <line\n                    x1={from.x + from.w}\n                    y1={from.y + from.h / 2}\n                    x2={to.x}\n                    y2={to.y + to.h / 2}\n                    stroke={strokeColor}\n                    strokeWidth={isActive || isCompleted ? 2.5 : 2}\n                  />\n                  {isActive && (\n                    <circle r=\"4.5\" fill=\"#f59e0b\">\n                      <animateMotion\n                        path={`M ${from.x + from.w} ${from.y + from.h / 2} L ${to.x} ${to.y + to.h / 2}`}\n                        dur=\"1.8s\"\n                        repeatCount=\"indefinite\"\n                      />\n                    </circle>\n                  )}\n                </g>\n              );\n            })()}\n          </svg>\n\n          {/* Workflow Nodes Layer */}\n          {WORKFLOW_NODES.map((node) => {\n            const Icon = node.icon;\n            const status = getNodeStatus(node);\n            const isSelected = selectedNodeId === node.id;\n\n            // Border styling based on state (matching screenshot)\n            let borderStyle = \"border-[#26354a] bg-[#121c2c] text-slate-300\";\n            let dotStyle = \"bg-slate-600\";\n            let glowShadow = \"\";\n\n            if (status === \"completed\") {\n              borderStyle = \"border-[#10b981] bg-[#101c2a] text-white\";\n              dotStyle = \"bg-[#10b981] shadow-[0_0_8px_#10b981]\";\n              glowShadow = \"shadow-[0_0_15px_rgba(16,185,129,0.3)]\";\n            } else if (status === \"active\") {\n              borderStyle = \"border-[#f59e0b] bg-[#1a1f28] text-white ring-1 ring-amber-400/60\";\n              dotStyle = \"bg-[#f59e0b] shadow-[0_0_10px_#f59e0b] animate-pulse\";\n              glowShadow = \"shadow-[0_0_24px_rgba(245,158,11,0.5)]\";\n            }\n\n            if (isSelected) {\n              glowShadow += \" ring-2 ring-cyan-400\";\n            }\n\n            return (\n              <div\n                key={node.id}\n                onClick={(e) => {\n                  e.stopPropagation();\n                  setSelectedNodeId(node.id);\n                }}\n                style={{\n                  left: `${node.x}px`,\n                  top: `${node.y}px`,\n                  width: `${node.w}px`,\n                  height: `${node.h}px`\n                }}\n                className={`canvas-interactive absolute rounded-2xl border-2 p-3.5 flex flex-col justify-between transition-all cursor-pointer select-none ${borderStyle} ${glowShadow}`}\n              >\n                {/* 4 Connection Handles (Top, Bottom, Left, Right) */}\n                <span className=\"w-2.5 h-2.5 rounded-full bg-[#64748b] border border-[#0a0f1d] absolute -top-1.5 left-1/2 -translate-x-1/2\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-[#64748b] border border-[#0a0f1d] absolute -bottom-1.5 left-1/2 -translate-x-1/2\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-[#64748b] border border-[#0a0f1d] absolute top-1/2 -left-1.5 -translate-y-1/2\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-[#64748b] border border-[#0a0f1d] absolute top-1/2 -right-1.5 -translate-y-1/2\" />\n\n                {/* Top Row: Gate Tag & Status Indicator Dot */}\n                <div className=\"flex items-center justify-between w-full\">\n                  {node.isGate ? (\n                    <span className=\"text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30\">\n                      HITL\n                    </span>\n                  ) : (\n                    <span />\n                  )}\n                  <span className={`w-2.5 h-2.5 rounded-full ${dotStyle}`} />\n                </div>\n\n                {/* Center: Stage Icon */}\n                <div className=\"flex flex-col items-center justify-center my-auto\">\n                  <Icon className=\"w-8 h-8 stroke-[1.75]\" />\n                  <span className=\"text-xs font-black tracking-wider uppercase mt-2 text-center text-slate-100\">\n                    {node.name}\n                  </span>\n                </div>\n\n                {/* Bottom subtle metadata */}\n                <div className=\"text-[10px] text-center font-mono opacity-60 truncate\">\n                  {node.agentName}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Floating Zoom & Pan Controls Toolbar (Bottom-Left) */}\n        <div className=\"absolute bottom-6 left-6 z-10 flex flex-col bg-[#0d1627]/95 border border-[#1c2c43] rounded-xl overflow-hidden shadow-2xl backdrop-blur-md\">\n          <button\n            onClick={handleZoomIn}\n            title=\"Zoom In\"\n            className=\"p-2.5 hover:bg-[#192840] text-slate-300 hover:text-white transition cursor-pointer border-b border-[#1c2c43]\"\n          >\n            <Plus className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={handleZoomOut}\n            title=\"Zoom Out\"\n            className=\"p-2.5 hover:bg-[#192840] text-slate-300 hover:text-white transition cursor-pointer border-b border-[#1c2c43]\"\n          >\n            <Minus className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={handleResetView}\n            title=\"Fit View\"\n            className=\"p-2.5 hover:bg-[#192840] text-slate-300 hover:text-white transition cursor-pointer border-b border-[#1c2c43]\"\n          >\n            <Maximize2 className=\"w-4 h-4\" />\n          </button>\n          <button\n            onClick={() => setIsLocked(!isLocked)}\n            title={isLocked ? \"Unlock Canvas Pan\" : \"Lock Canvas Pan\"}\n            className={`p-2.5 hover:bg-[#192840] transition cursor-pointer ${\n              isLocked ? \"text-amber-400\" : \"text-slate-400 hover:text-white\"\n            }`}\n          >\n            {isLocked ? <Lock className=\"w-4 h-4\" /> : <Unlock className=\"w-4 h-4\" />}\n          </button>\n        </div>\n\n        {/* Floating Mini-Map (Bottom-Right, matching screenshot) */}\n        <div className=\"absolute bottom-6 right-6 z-10 w-48 h-32 bg-[#090e1c]/90 border border-[#1d2d46] rounded-xl p-2 shadow-2xl backdrop-blur-sm hidden md:block\">\n          <div className=\"w-full h-full relative border border-[#15233a] rounded-lg bg-[#060a14] overflow-hidden\">\n            {/* Schematic representation of 3-row nodes */}\n            <div className=\"absolute top-2 left-2 w-8 h-4 rounded bg-emerald-500/40 border border-emerald-500/60\" />\n            <div className=\"absolute top-2 left-12 w-8 h-4 rounded bg-emerald-500/40 border border-emerald-500/60\" />\n            <div className=\"absolute top-2 left-22 w-8 h-4 rounded bg-amber-500/60 border border-amber-500 ring-1 ring-amber-400\" />\n            <div className=\"absolute top-2 left-32 w-8 h-4 rounded bg-slate-700/60\" />\n\n            <div className=\"absolute top-10 right-2 w-8 h-4 rounded bg-slate-700/60\" />\n            <div className=\"absolute top-10 right-12 w-8 h-4 rounded bg-slate-700/60\" />\n            <div className=\"absolute top-10 right-22 w-8 h-4 rounded bg-slate-700/60\" />\n            <div className=\"absolute top-10 right-32 w-8 h-4 rounded bg-slate-700/60\" />\n\n            <div className=\"absolute bottom-2 left-2 w-8 h-4 rounded bg-slate-700/60\" />\n            <div className=\"absolute bottom-2 left-12 w-8 h-4 rounded bg-slate-700/60\" />\n            <div className=\"absolute bottom-2 left-22 w-8 h-4 rounded bg-slate-700/60\" />\n\n            {/* Active viewport frame */}\n            <div \n              style={{\n                left: `${Math.max(0, -pan.x / 14)}%`,\n                top: `${Math.max(0, -pan.y / 12)}%`,\n                width: `${Math.min(100, 100 / scale)}%`,\n                height: `${Math.min(100, 100 / scale)}%`\n              }}\n              className=\"absolute border border-cyan-400/70 bg-cyan-500/10 pointer-events-none rounded\"\n            />\n          </div>\n          <div className=\"absolute bottom-1 right-2 text-[8px] font-mono text-slate-500\">\n            React Flow\n          </div>\n        </div>\n      </div>\n\n      {/* ============================================================ */}\n      {/* RIGHT SLIDE-OUT DRAWER: NODE EXECUTION INSPECTOR             */}\n      {/* ============================================================ */}\n      {selectedNode && (\n        <div className=\"w-80 sm:w-96 shrink-0 bg-[#090e1a] border-l border-[#192437] flex flex-col z-20 overflow-hidden shadow-2xl\">\n          {/* Drawer Header */}\n          <div className=\"p-4 border-b border-[#192437] flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400\">\n                <selectedNode.icon className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-extrabold text-white flex items-center gap-1.5\">\n                  {selectedNode.name}\n                  <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#132034] text-cyan-300 border border-cyan-500/30\">\n                    STAGE\n                  </span>\n                </h3>\n                <p className=\"text-[11px] text-slate-400\">{selectedNode.role}</p>\n              </div>\n            </div>\n            <button\n              onClick={() => setSelectedNodeId(\"\")}\n              className=\"p-1 rounded-lg text-slate-400 hover:text-white hover:bg-[#131f32] transition\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Drawer Content */}\n          <div className=\"flex-1 overflow-y-auto p-4 space-y-4\">\n            {/* Engine & Agent info */}\n            <div className=\"p-3.5 rounded-xl bg-[#0c1424] border border-[#1b2a41] space-y-2\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-slate-400 font-medium\">Assigned Agent</span>\n                <span className=\"font-bold text-white font-mono\">{selectedNode.agentName}</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-slate-400 font-medium\">Model Engine</span>\n                <span className=\"font-mono text-emerald-400 font-semibold\">{selectedNode.model}</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-slate-400 font-medium\">Stage Status</span>\n                <span className=\"font-mono text-amber-400 font-semibold uppercase\">\n                  {getNodeStatus(selectedNode)}\n                </span>\n              </div>\n            </div>\n\n            {/* Human-in-the-loop Controls (if applicable) */}\n            {selectedJob && (selectedJob.status === \"AWAITING_APPROVAL\" || selectedJob.status === \"AWAITING_PREMIUM\") && selectedJob.current_stage === selectedNode.stageKey && (\n              <div className=\"p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 space-y-3\">\n                <div className=\"flex items-center gap-2 text-amber-300 text-xs font-bold\">\n                  <AlertCircle className=\"w-4 h-4\" />\n                  <span>Human-in-the-Loop Gate Paused</span>\n                </div>\n                <p className=\"text-[11px] text-slate-300 leading-relaxed\">\n                  Execution is paused awaiting Telegram / UI approval or revisions before proceeding to next stage.\n                </p>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => onApproveStage(selectedJob.id)}\n                    className=\"flex-1 flex items-center justify-center gap-1 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold py-2 rounded-lg transition cursor-pointer\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n                    <span>Approve Gate</span>\n                  </button>\n                  <button\n                    onClick={() => setShowRejectForm(!showRejectForm)}\n                    className=\"flex-1 flex items-center justify-center gap-1 bg-rose-500/20 hover:bg-rose-500/30 border border-rose-500/40 text-rose-300 text-xs font-bold py-2 rounded-lg transition cursor-pointer\"\n                  >\n                    <X className=\"w-3.5 h-3.5\" />\n                    <span>Reject / Revise</span>\n                  </button>\n                </div>\n\n                {showRejectForm && (\n                  <div className=\"space-y-2 pt-2 border-t border-amber-500/20\">\n                    <textarea\n                      value={rejectFeedback}\n                      onChange={(e) => setRejectFeedback(e.target.value)}\n                      placeholder=\"Enter specific feedback / revision request...\"\n                      className=\"w-full bg-[#080d19] border border-[#233756] rounded-lg p-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400\"\n                      rows={2}\n                    />\n                    <button\n                      onClick={() => {\n                        onRejectStage(selectedJob.id, rejectFeedback || \"Revision requested via n8n Canvas\");\n                        setShowRejectForm(false);\n                      }}\n                      className=\"w-full bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-1.5 rounded-lg transition\"\n                    >\n                      Submit Revision Order\n                    </button>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* Video Stage: 4K Veo Upload Action */}\n            {selectedJob && (selectedNode.id === \"VIDEO\" || selectedNode.id === \"AWAITING_PREMIUM\") && selectedJob.config.premium && !selectedJob.config.premium_asset_uploaded && (\n              <div className=\"p-3.5 rounded-xl bg-purple-500/10 border border-purple-500/30 space-y-2.5\">\n                <div className=\"flex items-center gap-2 text-purple-300 text-xs font-bold\">\n                  <Film className=\"w-4 h-4\" />\n                  <span>Veo 3.1 4K Render Attachment</span>\n                </div>\n                <p className=\"text-[11px] text-slate-300\">\n                  Upload or attach your ultra-high-bitrate Veo 3.1 video render to the pipeline assets.\n                </p>\n                <button\n                  onClick={() => onUploadPremium(selectedJob.id)}\n                  className=\"w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold py-2 rounded-lg transition flex items-center justify-center gap-1.5 cursor-pointer shadow-lg shadow-purple-500/20\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Attach 4K Veo Asset</span>\n                </button>\n              </div>\n            )}\n\n            {/* Output Payload Inspection */}\n            <div>\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[11px] font-mono uppercase tracking-wider text-slate-400 font-bold\">\n                  STAGE OUTPUT PAYLOAD\n                </span>\n                {selectedStageData && (\n                  <span className=\"text-[10px] font-mono text-emerald-400\">\n                    {selectedStageData.timestamp.split(\"T\")[1]?.slice(0, 8) || \"GENERATED\"}\n                  </span>\n                )}\n              </div>\n\n              {selectedStageData ? (\n                <pre className=\"p-3.5 rounded-xl bg-[#070c17] border border-[#19273f] text-[11px] font-mono text-cyan-300 overflow-x-auto max-h-72 leading-relaxed select-text\">\n                  {JSON.stringify(selectedStageData.output, null, 2)}\n                </pre>\n              ) : (\n                <div className=\"p-6 rounded-xl bg-[#080d19] border border-[#16243a] text-center text-xs text-slate-500\">\n                  <p>No output generated yet for this stage.</p>\n                  <p className=\"text-[10px] text-slate-600 mt-1\">Advance previous stages to populate data.</p>\n                </div>\n              )}\n            </div>\n\n            {/* Stage Action Trigger */}\n            <div className=\"pt-2 border-t border-[#172338]\">\n              {selectedJob && (\n                <button\n                  onClick={() => onAdvanceStage(selectedJob.id)}\n                  disabled={isAdvancing || selectedJob.status === \"COMPLETED\"}\n                  className=\"w-full flex items-center justify-center gap-2 bg-[#122137] hover:bg-[#1a2e4c] border border-[#243959] text-cyan-300 hover:text-cyan-200 text-xs font-bold py-2.5 rounded-xl transition cursor-pointer\"\n                >\n                  <Play className=\"w-3.5 h-3.5\" />\n                  <span>{isAdvancing ? \"Running...\" : \"Run This Stage\"}</span>\n                </button>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
