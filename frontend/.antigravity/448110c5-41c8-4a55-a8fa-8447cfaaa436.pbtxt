        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Calculate SVG spline bezier path between two nodes"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const calculatePath = (fromNode: WorkflowNode, toNode: WorkflowNode, type: \"main\" | \"dashed\" | \"subpin\") => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let startX = fromNode.x + (fromNode.width || 180);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let startY = fromNode.y + ((fromNode.height || 74) / 2);"
