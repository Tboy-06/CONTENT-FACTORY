          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Film\": return <Film className=\"w-4 h-4 text-blue-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Volume2\": return <Volume2 className=\"w-4 h-4 text-cyan-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Layers\": return <Layers className=\"w-4 h-4 text-indigo-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Eye\": return <Eye className=\"w-4 h-4 text-sky-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
