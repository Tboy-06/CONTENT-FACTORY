el: \"Audio\" },\n      { id: \"e5\", fromNode: \"node-json-split\", toNode: \"node-image-prompt\", type: \"main\", label: \"Visuals\" },\n      { id: \"e6\", fromNode: \"node-image-prompt\", toNode: \"node-image-gen\", type: \"main\" },\n      // Merge\n      { id: \"e7\", fromNode: \"node-voice-gen\", toNode: \"node-merge\", type: \"main\" },\n      { id: \"e8\", fromNode: \"node-image-gen\", toNode: \"node-merge\", type: \"main\" },\n      // Post-merge pipeline\n      { id: \"e9\", fromNode: \"node-merge\", toNode: \"node-render-video\", type: \"main\" },\n      { id: \"e10\", fromNode: \"node-render-video\", toNode: \"node-wait\", type: \"main\" },\n      { id: \"e11\", fromNode: \"node-wait\", toNode: \"node-download\", type: \"main\" },\n      { id: \"e12\", fromNode: \"node-download\", toNode: \"node-upload\", type: \"main\" },\n      // Vault and Telegram branch from wait\n      { id: \"e13\", fromNode: \"node-wait\", toNode: \"node-append-vault\", type: \"dashed\" },\n      { id: \"e14\", fromNode: \"node-append-vault\", toNode: \"node-telegram-response\", type: \"main\" },\n\n      // Sub-pin connections from bottom of AI Agent\n      { id: \"e-sub-model\", fromNode: \"node-ai-agent\", toNode: \"node-model-gemini-flash\", type: \"subpin\" },\n      { id: \"e-sub-think\", fromNode: \"node-ai-agent\", toNode: \"node-think-prompt\", type: \"subpin\" },\n      { id: \"e-sub-mem\", fromNode: \"node-ai-agent\", toNode: \"node-vault-memory\", type: \"subpin\" },\n      { id: \"e-sub-research\", fromNode: \"node-ai-agent\", toNode: \"node-subagent-research\", type: \"subpin\" },\n\n      // Research tools\n      { id: \"e-res-yt\", fromNode: \"node-subagent-research\", toNode: \"node-tool-youtube\", type: \"dashed\" },\n      { id: \"e-res-tav\", fromNode: \"node-subagent-research\", toNode: \"node-tool-tavily\", type: \"dashed\" }\n    ];"
