        }
        lines {
          text: "      ) : ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"flex-1 flex flex-col min-h-0 relative\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            className=\"flex-1 relative overflow-hidden cursor-grab active:cursor-grabbing bg-[#0b0e17] min-h-[280px]\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            onMouseDown={handleMouseDown}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
