  file_change {
    absolute_path_uri: "file:///src/components/WorkflowExecutionsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { \n  Play, \n  CheckCircle2, \n  Clock, \n  AlertTriangle, \n  ChevronRight, \n  RefreshCw, \n  Send, \n  Cpu, \n  Bot, \n  Eye, \n  Terminal, \n  FileText,\n  Activity,\n  Layers,\n  ArrowRight\n} from \"lucide-react\";\nimport { WorkflowExecution } from \"../types\";\n\ninterface WorkflowExecutionsViewProps {\n  onSelectNiche?: (niche: string) => void;\n  onRunWorkflow?: () => void;\n  isRunning?: boolean;\n}\n\nexport const WorkflowExecutionsView: React.FC<WorkflowExecutionsViewProps> = ({\n  onSelectNiche,\n  onRunWorkflow,\n  isRunning = false\n}) => {\n  const [executions, setExecutions] = useState<WorkflowExecution[]>([]);\n  const [selectedExec, setSelectedExec] = useState<WorkflowExecution | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  const fetchExecutions = async () => {\n    setLoading(true);\n    try {\n      const res = await fetch(\"/api/workflow/executions\");\n      if (res.ok) {\n        const data = await res.json();\n        setExecutions(data);\n        if (data.length > 0 && !selectedExec) {\n          setSelectedExec(data[0]);\n        }\n      }\n    } catch (e) {\n      console.error(\"Error fetching executions:\", e);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchExecutions();\n  }, []);\n\n  return (\n    <div className=\"flex-1 flex flex-col md:flex-row h-full min-h-0 bg-[#0d111a] text-slate-100 overflow-hidden font-sans select-none\">\n      {/* LEFT: Executions History List */}\n      <div className=\"w-full md:w-96 border-r border-[#1e2738] flex flex-col shrink-0 bg-[#090d15]\">\n        {/* Header */}\n        <div className=\"p-4 border-b border-[#1e2738] flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Activity className=\"w-4 h-4 text-emerald-400\" />\n            <h2 className=\"text-sm font-bold uppercase tracking-wider text-white\">\n              Executions History\n            </h2>\n            <span className=\"text-[11px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono\">\n              {executions.length}\n            </span>\n          </div>\n          <button\n            onClick={fetchExecutions}\n            disabled={loading}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n            title=\"Refresh Runs\"\n          >\n            <RefreshCw className={`w-4 h-4 ${loading ? \"animate-spin text-sky-400\" : \"\"}`} />\n          </button>\n        </div>\n\n        {/* List of Executions */}\n        <div className=\"flex-1 overflow-y-auto divide-y divide-[#151d2c]\">\n          {executions.map(exec => {\n            const isSelected = selectedExec?.id === exec.id;\n            return (\n              <div\n                key={exec.id}\n                onClick={() => setSelectedExec(exec)}\n                className={`p-3.5 transition cursor-pointer flex flex-col gap-1.5 ${\n                  isSelected ? \"bg-[#182337] border-l-4 border-emerald-500\" : \"hover:bg-[#111724]\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-mono text-xs font-bold text-white flex items-center gap-1.5\">\n                    {exec.status === \"SUCCESS\" && <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />}\n                    {exec.status === \"RUNNING\" && <Activity className=\"w-3.5 h-3.5 text-sky-400 animate-pulse\" />}\n                    {exec.status === \"WAITING\" && <Clock className=\"w-3.5 h-3.5 text-amber-400\" />}\n                    {exec.status === \"ERROR\" && <AlertTriangle className=\"w-3.5 h-3.5 text-rose-400\" />}\n                    {exec.id}\n                  </span>\n                  <span className=\"text-[10px] font-mono text-slate-400\">\n                    {(exec.durationMs / 1000).toFixed(2)}s\n                  </span>\n                </div>\n\n                <div className=\"text-xs text-slate-200 font-medium truncate\">\n                  {exec.niche}\n                </div>\n\n                <div className=\"flex items-center justify-between text-[11px] text-slate-400\">\n                  <span className=\"px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 font-mono text-[10px]\">\n                    {exec.triggerType}\n                  </span>\n                  <span>{new Date(exec.startedAt).toLocaleTimeString()}</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* RIGHT: Selected Execution Trace & Step-by-Step Payload View */}\n      <div className=\"flex-1 flex flex-col min-h-0 bg-[#0d131f] overflow-hidden\">\n        {selectedExec ? (\n          <div className=\"flex-1 flex flex-col min-h-0 overflow-hidden\">\n            {/* Run Top Summary Bar */}\n            <div className=\"p-4 border-b border-[#1f2b3e] bg-[#111827] flex items-center justify-between shrink-0\">\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center gap-2\">\n                  <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold font-mono tracking-wider ${\n                    selectedExec.status === \"SUCCESS\" ? \"bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\" :\n                    selectedExec.status === \"RUNNING\" ? \"bg-sky-500/20 text-sky-300 border border-sky-500/40\" :\n                    \"bg-amber-500/20 text-amber-300 border border-amber-500/40\"\n                  }`}>\n                    {selectedExec.status}\n                  </span>\n                  <h3 className=\"text-sm font-bold text-white\">\n                    {selectedExec.niche}\n                  </h3>\n                </div>\n                <div className=\"text-xs text-slate-400 flex items-center gap-4\">\n                  <span>Execution: <strong className=\"text-slate-200 font-mono\">{selectedExec.id}</strong></span>\n                  <span>Duration: <strong className=\"text-emerald-400 font-mono\">{(selectedExec.durationMs / 1000).toFixed(2)}s</strong></span>\n                  <span>Nodes Executed: <strong className=\"text-slate-200\">{selectedExec.steps?.length || 0} nodes</strong></span>\n                </div>\n              </div>\n\n              {onRunWorkflow && (\n                <button\n                  onClick={onRunWorkflow}\n                  disabled={isRunning}\n                  className=\"px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold shadow-lg transition flex items-center gap-2 cursor-pointer disabled:opacity-50\"\n                >\n                  <Play className=\"w-3.5 h-3.5 fill-current\" />\n                  {isRunning ? \"Executing...\" : \"Execute Again\"}\n                </button>\n              )}\n            </div>\n\n            {/* Execution Steps Timeline */}\n            <div className=\"flex-1 overflow-y-auto p-6 space-y-4\">\n              <h4 className=\"text-xs uppercase font-bold text-slate-400 tracking-wider flex items-center gap-2\">\n                <Layers className=\"w-4 h-4 text-sky-400\" />\n                Pipeline Execution Steps & Real Outputs\n              </h4>\n\n              <div className=\"space-y-3\">\n                {selectedExec.steps?.map((step, idx) => (\n                  <div \n                    key={idx}\n                    className=\"border border-[#202c42] rounded-xl bg-[#0f1624] overflow-hidden transition hover:border-[#2f3f5c]\"\n                  >\n                    <div className=\"px-4 py-2.5 bg-[#141d2f] border-b border-[#202c42] flex items-center justify-between\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <span className=\"w-5 h-5 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-[10px] font-mono text-slate-300\">\n                          {idx + 1}\n                        </span>\n                        <span className=\"text-xs font-bold text-white\">\n                          {step.nodeName}\n                        </span>\n                        <span className=\"text-[10px] font-mono text-slate-400\">\n                          ({step.nodeId})\n                        </span>\n                      </div>\n\n                      <div className=\"flex items-center gap-3\">\n                        <span className=\"font-mono text-[11px] text-emerald-400 font-medium\">\n                          {step.durationMs}ms\n                        </span>\n                        <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1\">\n                          <CheckCircle2 className=\"w-3 h-3\" />\n                          Passed\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Output JSON / Payload Preview */}\n                    {step.outputData && (\n                      <div className=\"p-3 bg-[#0a0f18] text-xs font-mono\">\n                        <pre className=\"text-slate-300 text-[11px] overflow-x-auto whitespace-pre-wrap leading-relaxed max-h-56\">\n                          {JSON.stringify(step.outputData, null, 2)}\n                        </pre>\n                      </div>\n                    )}\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        ) : (\n          <div className=\"flex-1 flex items-center justify-center text-slate-500 text-sm\">\n            Select an execution run from the left panel to inspect step telemetry.\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
