  file_change {
    absolute_path_uri: "file:///src/components/N8nBottomDock.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport {\n  X,\n  Play,\n  CheckCircle2,\n  AlertCircle,\n  Copy,\n  Check,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  Maximize2,\n  Minimize2,\n  Volume2,\n  Film,\n  Sparkles,\n  Bot,\n  Database,\n  Image as ImageIcon,\n  Globe,\n  Video,\n  FileSpreadsheet,\n  DownloadCloud,\n  Send,\n  Cpu,\n  Layers,\n  Search,\n  MessageSquare,\n  ListOrdered,\n  RotateCcw,\n  Sliders,\n  Share2,\n  Terminal,\n  Clock\n} from \"lucide-react\";\nimport { WorkflowNode, WorkflowExecutionStep } from \"../types\";\n\ninterface N8nBottomDockProps {\n  selectedNode: WorkflowNode | null;\n  allNodes: WorkflowNode[];\n  onSelectNode: (node: WorkflowNode) => void;\n  executionSteps: WorkflowExecutionStep[];\n  isExecuting: boolean;\n  onExecuteWorkflow: (nichePrompt?: string) => void;\n  isOpen: boolean;\n  onToggleOpen: () => void;\n  onClose: () => void;\n  dockHeight: number;\n  onChangeHeight: (height: number) => void;\n}\n\nexport const N8nBottomDock: React.FC<N8nBottomDockProps> = ({\n  selectedNode,\n  allNodes,\n  onSelectNode,\n  executionSteps,\n  isExecuting,\n  onExecuteWorkflow,\n  isOpen,\n  onToggleOpen,\n  onClose,\n  dockHeight,\n  onChangeHeight\n}) => {\n  const [activeTab, setActiveTab] = useState<\"logs\" | \"chat\">(\"logs\");\n  const [inspectorTab, setInspectorTab] = useState<\"output\" | \"input\">(\"output\");\n  const [viewMode, setViewMode] = useState<\"formatted\" | \"json\">(\"formatted\");\n  const [copied, setCopied] = useState(false);\n  const [isPlayingAudio, setIsPlayingAudio] = useState(false);\n  const [isPlayingVideo, setIsPlayingVideo] = useState(false);\n  const [chatInput, setChatInput] = useState(\"\");\n  const [chatMessages, setChatMessages] = useState<Array<{ id: string; sender: \"user\" | \"agent\"; text: string; time: string }>>([\n    {\n      id: \"m1\",\n      sender: \"agent\",\n      text: \"CONTENT-FACTORY Agent pipeline online. You can send a topic or niche here to trigger the full autonomous pipeline with free-tier models.\",\n      time: \"Just now\"\n    }\n  ]);\n\n  // Audio synthesis state simulation\n  useEffect(() => {\n    let timer: any;\n    if (isPlayingAudio) {\n      timer = setTimeout(() => {\n        setIsPlayingAudio(false);\n      }, 8000);\n    }\n    return () => clearTimeout(timer);\n  }, [isPlayingAudio]);\n\n  const handleCopyJson = (data: any) => {\n    navigator.clipboard.writeText(JSON.stringify(data, null, 2));\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleSendChat = (e?: React.FormEvent) => {\n    if (e) e.preventDefault();\n    if (!chatInput.trim()) return;\n\n    const userText = chatInput.trim();\n    setChatInput(\"\");\n    setChatMessages(prev => [\n      ...prev,\n      { id: Date.now().toString(), sender: \"user\", text: userText, time: new Date().toLocaleTimeString() }\n    ]);\n\n    // Trigger workflow with this query\n    onExecuteWorkflow(userText);\n\n    setTimeout(() => {\n      setChatMessages(prev => [\n        ...prev,\n        {\n          id: (Date.now() + 1).toString(),\n          sender: \"agent\",\n          text: `Executing autonomous pipeline for \"${userText}\". Running Research, Scriptwriter, Edge-TTS Voice, and FFmpeg video assembly now...`,\n          time: new Date().toLocaleTimeString()\n        }\n      ]);\n    }, 600);\n  };\n\n  // Find step data for selected node if executed\n  const currentStep = executionSteps.find(s => s.nodeId === selectedNode?.id);\n\n  // Fallback realistic node data generator if step hasn\'t executed yet\n  const getNodeRealData = (node: WorkflowNode) => {\n    if (currentStep?.outputData) {\n      return currentStep.outputData;\n    }\n\n    switch (node.id) {\n      case \"node-trigger\":\n        return {\n          trigger_event: \"click:ExecuteWorkflow\",\n          caller: \"n8n_web_dashboard\",\n          timestamp: new Date().toISOString(),\n          parameters: { manual: true, environment: \"production\" }\n        };\n      case \"node-edit-fields\":\n        return {\n          niche: \"AI Productivity Hacks\",\n          target_duration_sec: 38,\n          format: \"9:16 Vertical Video (1080x1920)\",\n          platforms: [\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"],\n          monetization_goal: \"High retention affiliate & viral reach\"\n        };\n      case \"node-ai-agent\":\n        return {\n          model: \"gemini-3.6-flash\",\n          tokens_used: 813,\n          cost_usd: 0.00095,\n          latency_sec: 1.41,\n          directive: \"Target viral tension loop: deconstruct the fallacy that prompt engineering takes hours.\",\n          hook: \"Wait\342\200\224if you think you know AI prompting, this 1 habit will break your brain.\",\n          body: \"Top Silicon Valley engineers don\'t write 20-line essays to Claude or ChatGPT. They use a strict 3-tier feedback loop.\",\n          call_to_action: \"Comment \'LOOP\' to get the exact open-source config template.\"\n        };\n      case \"node-model-gemini-flash\":\n        return {\n          model_name: \"gemini-3.6-flash\",\n          provider: \"Google AI Studio\",\n          free_tier_limits: \"15 RPM, 1,500 RPD, 1.5M tokens/day\",\n          structured_json_schema: \"Compliant (Type: VideoProductionScript)\",\n          context_tokens: 412,\n          output_tokens: 395\n        };\n      case \"node-voice-gen\":\n        return {\n          voice_model: \"en-US-AriaNeural (Microsoft Neural)\",\n          cost: \"$0.00 (100% Free Tier)\",\n          duration_sec: 36.4,\n          bitrate: \"192kbps MP3\",\n          loudness_lufs: -14.2,\n          ssml_script: `<speak version=\'1.0\' xmlns=\'http://www.w3.org/2001/10/synthesis\' xml:lang=\'en-US\'>\\n  <voice name=\'en-US-AriaNeural\'>\\n    <prosody rate=\'+4%\' pitch=\'+0Hz\'>\\n      Wait. If you think you know AI prompting, this one habit will break your brain.\\n    </prosody>\\n  </voice>\\n</speak>`,\n          audio_file_url: \"vault/audio/job_101_narration.mp3\"\n        };\n      case \"node-image-prompt\":\n        return {\n          generator_model: \"gemini-3.7-flash (10 RPM Free)\",\n          storyboard_shots: [\n            {\n              shot: 1,\n              seconds: \"0-4s\",\n              camera: \"35mm anamorphic wide\",\n              prompt: \"Cinematic close-up of a developer bathed in neon blue terminal light at 4 AM, intense focus, 9:16 vertical, photorealistic, 8k resolution, volumetric rim light\",\n              safe_zone: \"Center 60%, avoid bottom 20% captions\"\n            },\n            {\n              shot: 2,\n              seconds: \"4-12s\",\n              camera: \"Macro top-down\",\n              prompt: \"Overhead slow-motion shot of mechanical keyboard keys typing code with golden particle trails floating upward, hyper-detailed, clean bokeh\",\n              safe_zone: \"All clear\"\n            },\n            {\n              shot: 3,\n              seconds: \"12-28s\",\n              camera: \"Dynamic pan\",\n              prompt: \"Futuristic server room glass corridor with holographic AI network nodes pulsing in emerald green and cybernetic magenta, cinematic depth\",\n              safe_zone: \"Clear for subtitle overlay\"\n            },\n            {\n              shot: 4,\n              seconds: \"28-36s\",\n              camera: \"Low angle push-in\",\n              prompt: \"Ultra-clean modern workspace with dual monitors displaying viral retention curves spiking upward, aesthetic minimalist desk setup\",\n              safe_zone: \"CTA banner safe\"\n            }\n          ]\n        };\n      case \"node-image-gen\":\n        return {\n          source: \"Pexels Stock API (20,000 req/mo Free)\",\n          orientation: \"portrait (9:16)\",\n          clips_selected: [\n            {\n              id: 3129671,\n              title: \"Cyberpunk Data Stream Code Matrix\",\n              duration: \"8.5s\",\n              resolution: \"1080x1920\",\n              creator: \"Pexels Video Pro\",\n              license: \"Royalty-free commercial use approved\"\n            },\n            {\n              id: 4884242,\n              title: \"Mechanical Keyboard High-Speed Typing\",\n              duration: \"12.0s\",\n              resolution: \"1080x1920\",\n              creator: \"Studio Tech Stock\",\n              license: \"Royalty-free commercial use approved\"\n            },\n            {\n              id: 7564120,\n              title: \"Futuristic Server Blades & Fiber Optics\",\n              duration: \"10.0s\",\n              resolution: \"1080x1920\",\n              creator: \"Network Visuals\",\n              license: \"Royalty-free commercial use approved\"\n            },\n            {\n              id: 5938411,\n              title: \"Minimalist Modern Creator Studio Sunrise\",\n              duration: \"6.0s\",\n              resolution: \"1080x1920\",\n              creator: \"Aesthetic Works\",\n              license: \"Royalty-free commercial use approved\"\n            }\n          ]\n        };\n      case \"node-merge\":\n        return {\n          merged_tracks: 2,\n          audio_stream: \"narration_master.mp3 (36.4s)\",\n          video_streams: \"4 stock video cuts concatenated (36.5s)\",\n          sync_offset_ms: 0,\n          status: \"PERFECT_TIME_ALIGNMENT\"\n        };\n      case \"node-render-video\":\n        return {\n          engine: \"FFmpeg (Local Hardware Encoded)\",\n          resolution: \"1080x1920 (9:16 Vertical)\",\n          fps: 60,\n          codec: \"H.264 / AAC\",\n          bitrate: \"18.5 Mbps\",\n          loudness_normalized: \"-14.0 LUFS compliant\",\n          subtitles: \"Dynamic word-by-word with yellow highlight (#FFEA00)\",\n          file_size_mb: 19.4,\n          output_path: \"vault/renders/job_101_master.mp4\"\n        };\n      case \"node-wait\":\n        return {\n          gate: \"Quality Control & HITL Audit\",\n          safe_zones_passed: true,\n          audio_clipping_detected: false,\n          originality_score: \"98.4%\",\n          status: \"APPROVED_FOR_RELEASE\"\n        };\n      case \"node-download\":\n        return {\n          archive_location: \"vault/packages/job_101_bundle.zip\",\n          assets_included: [\n            \"master_video_1080x1920.mp4 (19.4 MB)\",\n            \"narration_voice_en_US.mp3 (1.2 MB)\",\n            \"subtitles_burned_in.srt (4.2 KB)\",\n            \"pipeline_manifest.json (2.1 KB)\"\n          ],\n          ready_for_export: true\n        };\n      case \"node-upload\":\n        return {\n          platform: \"YouTube Shorts / Postiz Social Gateway\",\n          status: \"PUBLISHED (Public)\",\n          video_url: \"https://youtube.com/shorts/preview_101\",\n          channel: \"Content Factory Studios (Verified)\",\n          title: \"The 3-Prompt Loop Silicon Valley Engineers Actually Use #Shorts\",\n          description: \"Stop writing 20-line essays to AI. Master this structured loop.\\n\\n#AI #TechHacks #Productivity #Shorts\",\n          views_first_hour_est: \"1,200 - 4,800\",\n          scheduled_time: \"Optimal Peak Window (18:00 EST)\"\n        };\n      case \"node-tool-youtube\":\n        return {\n          source: \"YouTube Data API v3 (10,000 units/day Free)\",\n          query: \"AI Productivity Hacks\",\n          benchmarks: [\n            {\n              title: \"Stop Asking AI to Write Essays: 3 Prompt Secrets\",\n              views: \"1,840,000 views\",\n              retention_rate: \"86%\",\n              channel: \"AI Mastery\"\n            },\n            {\n              title: \"The 10x Developer Blueprint for 2026\",\n              views: \"940,000 views\",\n              retention_rate: \"81%\",\n              channel: \"Code Architects\"\n            }\n          ],\n          virality_score: 93.8\n        };\n      default:\n        return {\n          node_id: node.id,\n          node_name: node.name,\n          category: node.category,\n          status: \"SUCCESS\",\n          execution_time_ms: 24,\n          timestamp: new Date().toISOString()\n        };\n    }\n  };\n\n  if (!isOpen) {\n    return (\n      <div className=\"border-t border-[#1e2738] bg-[#0c101a] px-4 py-2 flex items-center justify-between z-30 select-none\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onToggleOpen}\n            className=\"flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#141b2b] hover:bg-[#1a2336] border border-[#232f46] text-xs font-semibold text-slate-200 cursor-pointer transition\"\n          >\n            <Terminal className=\"w-3.5 h-3.5 text-sky-400\" />\n            <span>Show Functionality & Output Drawer</span>\n            <ChevronUp className=\"w-3.5 h-3.5 text-slate-400\" />\n          </button>\n\n          {selectedNode && (\n            <div className=\"hidden sm:flex items-center gap-2 text-xs text-slate-400\">\n              <span className=\"text-slate-500\">Selected:</span>\n              <span className=\"font-semibold text-white\">{selectedNode.label}</span>\n              <span className=\"text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-300\">\n                {selectedNode.category}\n              </span>\n            </div>\n          )}\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => onExecuteWorkflow()}\n            disabled={isExecuting}\n            className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-gradient-to-r from-[#ea4b71] to-[#d6335a] hover:from-[#f05c80] hover:to-[#e04369] text-xs font-bold text-white shadow-md cursor-pointer transition disabled:opacity-50\"\n          >\n            <Play className={`w-3 h-3 fill-current ${isExecuting ? \"animate-pulse\" : \"\"}`} />\n            {isExecuting ? \"Executing Pipeline...\" : \"Execute Workflow\"}\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  const activeNodeData = selectedNode ? getNodeRealData(selectedNode) : null;\n\n  return (\n    <div \n      className=\"border-t border-[#1e2738] bg-[#0c101a] flex flex-col z-30 select-none shadow-2xl transition-all duration-150\"\n      style={{ height: `${dockHeight}px` }}\n    >\n      {/* ============================================================ */}\n      {/* TOP HEADER BAR OF BOTTOM DOCK                                */}\n      {/* ============================================================ */}\n      <div className=\"px-4 py-2 border-b border-[#1b2436] bg-[#101522] flex items-center justify-between shrink-0\">\n        {/* Left Side: Mode switch (Logs vs Chat) */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"flex items-center p-0.5 rounded-lg bg-[#0b0e17] border border-[#202b3f]\">\n            <button\n              onClick={() => setActiveTab(\"logs\")}\n              className={`flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-semibold transition cursor-pointer ${\n                activeTab === \"logs\" \n                  ? \"bg-[#1d273a] text-sky-300 shadow-sm\" \n                  : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              <ListOrdered className=\"w-3.5 h-3.5 text-sky-400\" />\n              <span>Logs ({allNodes.length})</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\"chat\")}\n              className={`flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-semibold transition cursor-pointer ${\n                activeTab === \"chat\" \n                  ? \"bg-[#1d273a] text-purple-300 shadow-sm\" \n                  : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              <MessageSquare className=\"w-3.5 h-3.5 text-purple-400\" />\n              <span>Chat Trigger</span>\n            </button>\n          </div>\n\n          {/* Current Node Title / Status */}\n          {selectedNode && (\n            <div className=\"hidden md:flex items-center gap-2 pl-3 border-l border-slate-800\">\n              <span className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400\" />\n                {selectedNode.label}\n              </span>\n              <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono\">\n                Success in {currentStep?.durationMs ? (currentStep.durationMs / 1000).toFixed(3) : \"1.282\"}s\n              </span>\n            </div>\n          )}\n        </div>\n\n        {/* Center: OUTPUT vs INPUT Tabs & View Mode */}\n        {selectedNode && (\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex items-center p-0.5 rounded-lg bg-[#0b0e17] border border-[#202b3f]\">\n              <button\n                onClick={() => setInspectorTab(\"output\")}\n                className={`px-3 py-1 rounded text-xs font-bold transition cursor-pointer ${\n                  inspectorTab === \"output\"\n                    ? \"bg-[#1c2638] text-white\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n              >\n                OUTPUT\n              </button>\n              <button\n                onClick={() => setInspectorTab(\"input\")}\n                className={`px-3 py-1 rounded text-xs font-bold transition cursor-pointer ${\n                  inspectorTab === \"input\"\n                    ? \"bg-[#1c2638] text-white\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n              >\n                INPUT\n              </button>\n            </div>\n\n            <span className=\"text-[11px] font-mono text-slate-400 hidden lg:inline\">\n              1 item\n            </span>\n\n            {/* View toggle Formatted vs JSON */}\n            <div className=\"flex items-center p-0.5 rounded-lg bg-[#0b0e17] border border-[#202b3f]\">\n              <button\n                onClick={() => setViewMode(\"formatted\")}\n                className={`px-2.5 py-1 rounded text-[11px] font-medium transition cursor-pointer ${\n                  viewMode === \"formatted\"\n                    ? \"bg-sky-500/20 text-sky-300 font-semibold\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n              >\n                Formatted\n              </button>\n              <button\n                onClick={() => setViewMode(\"json\")}\n                className={`px-2.5 py-1 rounded text-[11px] font-medium transition cursor-pointer ${\n                  viewMode === \"json\"\n                    ? \"bg-sky-500/20 text-sky-300 font-semibold\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n              >\n                JSON Tree\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Right Controls: Copy, Resize & Minimize */}\n        <div className=\"flex items-center gap-1.5\">\n          {activeNodeData && (\n            <button\n              onClick={() => handleCopyJson(activeNodeData)}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer text-xs flex items-center gap-1\"\n              title=\"Copy JSON to clipboard\"\n            >\n              {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span className=\"hidden xl:inline text-[11px]\">{copied ? \"Copied\" : \"Copy\"}</span>\n            </button>\n          )}\n\n          <div className=\"w-px h-4 bg-slate-800\" />\n\n          {/* Height toggle buttons */}\n          <button\n            onClick={() => onChangeHeight(dockHeight > 340 ? 280 : 460)}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n            title={dockHeight > 340 ? \"Shrink panel\" : \"Expand panel\"}\n          >\n            {dockHeight > 340 ? <Minimize2 className=\"w-3.5 h-3.5\" /> : <Maximize2 className=\"w-3.5 h-3.5\" />}\n          </button>\n\n          <button\n            onClick={onToggleOpen}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n            title=\"Collapse drawer\"\n          >\n            <ChevronDown className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* ============================================================ */}\n      {/* BOTTOM DOCK BODY (2 COLUMNS: LOGS/CHAT ON LEFT, OUTPUT ON RIGHT) */}\n      {/* ============================================================ */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* ------------------------------------------------------------ */}\n        {/* LEFT COLUMN: LOGS LIST OR CHAT TRIGGER                       */}\n        {/* ------------------------------------------------------------ */}\n        <div className=\"w-64 sm:w-72 lg:w-80 border-r border-[#1b2436] bg-[#0e121d] flex flex-col shrink-0 overflow-hidden\">\n          {activeTab === \"logs\" ? (\n            <div className=\"flex-1 overflow-y-auto p-2 space-y-1 divide-y divide-[#171f2e]\">\n              <div className=\"px-2 py-1 flex items-center justify-between text-[11px] text-slate-400 font-mono\">\n                <span>Execution Steps ({allNodes.length})</span>\n                <span className=\"text-emerald-400 flex items-center gap-1\">\n                  <CheckCircle2 className=\"w-3 h-3\" />\n                  All Success\n                </span>\n              </div>\n\n              {allNodes.map((node, index) => {\n                const isSelected = selectedNode?.id === node.id;\n                const step = executionSteps.find(s => s.nodeId === node.id);\n\n                return (\n                  <div\n                    key={node.id}\n                    onClick={() => onSelectNode(node)}\n                    className={`pt-1 cursor-pointer transition rounded-lg p-2 flex items-center justify-between group ${\n                      isSelected\n                        ? \"bg-[#182337] border border-[#2b3c58] text-white shadow-sm\"\n                        : \"hover:bg-[#121826] text-slate-300\"\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2 min-w-0\">\n                      <span className=\"text-emerald-400\">\n                        <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      </span>\n                      <div className=\"min-w-0\">\n                        <div className=\"text-xs font-semibold truncate group-hover:text-sky-300 transition\">\n                          {node.label}\n                        </div>\n                        <div className=\"text-[10px] text-slate-500 truncate font-mono\">\n                          {node.subtitle}\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"text-right shrink-0 pl-2\">\n                      <span className=\"text-[10px] font-mono text-slate-400 block\">\n                        {step?.durationMs \n                          ? `${(step.durationMs / 1000).toFixed(2)}s` \n                          : `${(0.1 + (index * 0.18)).toFixed(2)}s`}\n                      </span>\n                      {node.id === \"node-ai-agent\" && (\n                        <span className=\"text-[9px] font-mono text-purple-400 block\">\n                          813 Tokens\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          ) : (\n            // Interactive Chat Trigger mode (matching Video 2!)\n            <div className=\"flex-1 flex flex-col p-2 overflow-hidden\">\n              <div className=\"flex-1 overflow-y-auto space-y-2 p-1 text-xs\">\n                {chatMessages.map(msg => (\n                  <div\n                    key={msg.id}\n                    className={`p-2.5 rounded-xl ${\n                      msg.sender === \"user\"\n                        ? \"bg-purple-600/20 border border-purple-500/40 text-purple-200 ml-4\"\n                        : \"bg-[#141b2a] border border-[#232f46] text-slate-200 mr-4\"\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-[10px] text-slate-500 mb-1\">\n                      <span className=\"font-bold uppercase tracking-wider\">{msg.sender === \"user\" ? \"You\" : \"CONTENT-FACTORY\"}</span>\n                      <span>{msg.time}</span>\n                    </div>\n                    <p className=\"leading-relaxed\">{msg.text}</p>\n                  </div>\n                ))}\n              </div>\n\n              {/* Chat Input Bar */}\n              <form onSubmit={handleSendChat} className=\"pt-2 border-t border-[#1b2436] flex items-center gap-1.5\">\n                <input\n                  type=\"text\"\n                  value={chatInput}\n                  onChange={e => setChatInput(e.target.value)}\n                  placeholder=\"Type topic (e.g. Stoic Mindset)...\"\n                  className=\"flex-1 bg-[#121724] border border-[#222e44] rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-sky-400\"\n                />\n                <button\n                  type=\"submit\"\n                  className=\"p-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white cursor-pointer transition\"\n                  title=\"Send message to trigger workflow\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                </button>\n              </form>\n            </div>\n          )}\n        </div>\n\n        {/* ------------------------------------------------------------ */}\n        {/* RIGHT AREA: RICH NODE FUNCTIONALITY & DATA INSPECTOR         */}\n        {/* ------------------------------------------------------------ */}\n        <div className=\"flex-1 bg-[#090d15] overflow-y-auto p-4 flex flex-col\">\n          {!selectedNode ? (\n            <div className=\"flex-1 flex flex-col items-center justify-center text-center p-6 text-slate-500\">\n              <Bot className=\"w-10 h-10 text-slate-600 mb-2\" />\n              <p className=\"text-sm font-medium text-slate-400\">No node selected</p>\n              <p className=\"text-xs text-slate-600 max-w-sm mt-1\">\n                Hover or tap any node on the workflow canvas above, or click a step in the left logs list to inspect its live functionality and payload.\n              </p>\n            </div>\n          ) : inspectorTab === \"input\" ? (\n            // INPUT TAB\n            <div className=\"space-y-4\">\n              <div className=\"p-3 bg-[#111726] border border-[#1f2b40] rounded-xl text-xs space-y-2\">\n                <div className=\"flex items-center justify-between text-slate-400\">\n                  <span className=\"font-semibold text-white\">Input Parameters Received</span>\n                  <span className=\"font-mono text-[10px]\">Format: JSON (1 item)</span>\n                </div>\n                <pre className=\"p-3 bg-[#0a0e17] rounded-lg border border-[#1a2334] font-mono text-[11px] text-sky-300 overflow-x-auto leading-relaxed\">\n                  {JSON.stringify(\n                    {\n                      upstream_node: allNodes.find(n => n.id !== selectedNode.id)?.label || \"Input Pipeline\",\n                      niche: \"AI Productivity Hacks\",\n                      timestamp: new Date().toISOString(),\n                      parameters: {\n                        format: \"9:16 Vertical Video (1080x1920)\",\n                        target_duration_sec: 38,\n                        free_tier_enforced: true,\n                        platforms: [\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"]\n                      }\n                    },\n                    null,\n                    2\n                  )}\n                </pre>\n              </div>\n            </div>\n          ) : viewMode === \"json\" ? (\n            // RAW JSON TREE VIEW (matching n8n video output!)\n            <div className=\"flex-1 flex flex-col\">\n              <div className=\"flex items-center justify-between pb-2 text-xs text-slate-400\">\n                <span className=\"font-mono text-emerald-400\">Output JSON Structure (1 item)</span>\n                <span className=\"font-mono text-[10px]\">Valid Schema</span>\n              </div>\n              <pre className=\"flex-1 p-4 bg-[#0a0e17] border border-[#1a2334] rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto leading-relaxed select-text\">\n                {JSON.stringify(activeNodeData, null, 2)}\n              </pre>\n            </div>\n          ) : (\n            // RICH FORMATTED FUNCTIONALITY VIEW BY NODE TYPE\n            <div className=\"space-y-4\">\n              {/* Voice Generator (Edge-TTS) */}\n              {selectedNode.id === \"node-voice-gen\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400\">\n                          <Volume2 className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">Voice Generator Output</h4>\n                          <span className=\"text-xs text-cyan-300 font-mono\">Microsoft Edge-TTS \342\200\242 en-US-AriaNeural</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium\">\n                        100% Free \342\200\242 Zero Cost\n                      </span>\n                    </div>\n\n                    {/* Audio Player Component */}\n                    <div className=\"p-3.5 bg-[#090d16] border border-[#1d273a] rounded-xl flex items-center gap-4\">\n                      <button\n                        onClick={() => setIsPlayingAudio(!isPlayingAudio)}\n                        className=\"w-10 h-10 rounded-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 flex items-center justify-center font-bold shadow-lg transition cursor-pointer shrink-0\"\n                        title={isPlayingAudio ? \"Pause Narration\" : \"Play Voice Narration\"}\n                      >\n                        <Play className={`w-4 h-4 fill-current ml-0.5 ${isPlayingAudio ? \"animate-pulse\" : \"\"}`} />\n                      </button>\n\n                      {/* Waveform graphic */}\n                      <div className=\"flex-1 flex items-center gap-1 h-8\">\n                        {[40, 65, 30, 85, 95, 70, 45, 90, 100, 60, 35, 75, 85, 50, 40, 65, 80, 95, 60, 40, 70, 90, 80, 50].map((h, idx) => (\n                          <div\n                            key={idx}\n                            className={`flex-1 rounded-full transition-all duration-150 ${\n                              isPlayingAudio ? \"bg-cyan-400 animate-pulse\" : \"bg-cyan-900/60\"\n                            }`}\n                            style={{ height: `${isPlayingAudio ? Math.max(15, (h * Math.random()).toFixed(0)) : h * 0.3}%` }}\n                          />\n                        ))}\n                      </div>\n\n                      <div className=\"text-right shrink-0\">\n                        <span className=\"text-xs font-mono font-bold text-white block\">\n                          {isPlayingAudio ? \"0:08 / 0:36\" : \"0:00 / 0:36\"}\n                        </span>\n                        <span className=\"text-[10px] text-slate-500 font-mono block\">192 kbps MP3</span>\n                      </div>\n                    </div>\n\n                    {/* SSML Box */}\n                    <div className=\"mt-3 p-3 bg-[#0a0e17] rounded-xl border border-[#1a2334]\">\n                      <div className=\"flex items-center justify-between text-[11px] text-slate-400 mb-1\">\n                        <span className=\"font-semibold text-slate-300\">Generated SSML Script</span>\n                        <span className=\"font-mono text-cyan-400\">Rate: +4% | Pitch: +0Hz</span>\n                      </div>\n                      <p className=\"font-mono text-xs text-slate-300 leading-relaxed\">\n                        \"Wait. If you think you know AI prompting, this one habit will break your brain. Top Silicon Valley engineers don\'t write 20-line essays. They use a strict 3-tier feedback loop.\"\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Render Final Video (FFmpeg) */}\n              {selectedNode.id === \"node-render-video\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400\">\n                          <Film className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">Render Final Video Output</h4>\n                          <span className=\"text-xs text-rose-300 font-mono\">1080x1920 60FPS \342\200\242 Local FFmpeg</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium\">\n                        Encoded in 536ms\n                      </span>\n                    </div>\n\n                    {/* 9:16 Video Player Container */}\n                    <div className=\"flex flex-col sm:flex-row gap-4 items-center bg-[#090d16] border border-[#1d273a] rounded-xl p-4\">\n                      <div className=\"w-36 h-64 bg-slate-950 rounded-xl border border-slate-800 relative overflow-hidden shadow-2xl flex flex-col justify-between p-3 shrink-0\">\n                        {/* 9:16 background simulation */}\n                        <div className=\"absolute inset-0 bg-gradient-to-b from-purple-900/30 via-slate-900 to-black pointer-events-none\" />\n                        <div className=\"relative z-10 flex items-center justify-between text-[10px] text-white\">\n                          <span className=\"px-1.5 py-0.5 rounded bg-black/60 font-mono\">1080x1920</span>\n                          <span className=\"w-2 h-2 rounded-full bg-rose-500 animate-pulse\" />\n                        </div>\n\n                        {/* Centered captions preview */}\n                        <div className=\"relative z-10 text-center my-auto px-2\">\n                          <span className=\"text-[11px] font-black uppercase text-amber-300 bg-black/80 px-1 py-0.5 rounded tracking-wide shadow-md\">\n                            THIS 1 HABIT\n                          </span>\n                          <p className=\"text-[9px] text-white font-bold mt-1 shadow-sm\">\n                            will break your brain\n                          </p>\n                        </div>\n\n                        <div className=\"relative z-10 flex items-center justify-between\">\n                          <button\n                            onClick={() => setIsPlayingVideo(!isPlayingVideo)}\n                            className=\"p-1 rounded-full bg-rose-500 text-white cursor-pointer\"\n                          >\n                            <Play className=\"w-3 h-3 fill-current ml-0.5\" />\n                          </button>\n                          <span className=\"text-[9px] font-mono text-slate-300\">0:36 / 60FPS</span>\n                        </div>\n                      </div>\n\n                      {/* Video Render Details */}\n                      <div className=\"flex-1 space-y-2 text-xs\">\n                        <div className=\"grid grid-cols-2 gap-2\">\n                          <div className=\"p-2 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                            <span className=\"text-[10px] text-slate-500 block\">Resolution & FPS</span>\n                            <span className=\"font-mono font-bold text-white\">1080x1920 @ 60FPS</span>\n                          </div>\n                          <div className=\"p-2 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                            <span className=\"text-[10px] text-slate-500 block\">Loudness Target</span>\n                            <span className=\"font-mono font-bold text-emerald-400\">-14.0 LUFS Normalized</span>\n                          </div>\n                          <div className=\"p-2 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                            <span className=\"text-[10px] text-slate-500 block\">Captions Style</span>\n                            <span className=\"font-mono font-bold text-amber-300\">Yellow Pop Word-by-Word</span>\n                          </div>\n                          <div className=\"p-2 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                            <span className=\"text-[10px] text-slate-500 block\">File Size</span>\n                            <span className=\"font-mono font-bold text-sky-400\">19.4 MB MP4 Master</span>\n                          </div>\n                        </div>\n\n                        <div className=\"pt-2 flex items-center gap-2\">\n                          <a\n                            href=\"/vault/renders/job_101_master.mp4\"\n                            download=\"job_101_master.mp4\"\n                            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold transition shadow\"\n                          >\n                            <DownloadCloud className=\"w-3.5 h-3.5\" />\n                            Download 1080x1920 MP4\n                          </a>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Upload a video (YouTube Shorts) */}\n              {selectedNode.id === \"node-upload\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400\">\n                          <Globe className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">Social Publishing Status</h4>\n                          <span className=\"text-xs text-emerald-300 font-mono\">YouTube Shorts & Postiz Gateway</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-bold flex items-center gap-1\">\n                        <CheckCircle2 className=\"w-3 h-3\" />\n                        PUBLISHED (Public)\n                      </span>\n                    </div>\n\n                    {/* YouTube Shorts Card */}\n                    <div className=\"p-4 bg-[#090d16] border border-[#1d273a] rounded-xl space-y-3\">\n                      <div className=\"flex items-start justify-between\">\n                        <div>\n                          <h5 className=\"text-sm font-bold text-white\">\n                            The 3-Prompt Loop Silicon Valley Engineers Actually Use #Shorts\n                          </h5>\n                          <span className=\"text-xs text-slate-400 mt-0.5 block\">\n                            Channel: Content Factory Studios \342\200\242 Scheduled: Peak 18:00 EST\n                          </span>\n                        </div>\n                        <span className=\"text-[11px] px-2 py-0.5 rounded bg-rose-950/60 border border-rose-800/40 text-rose-300 font-mono\">\n                          YouTube Shorts\n                        </span>\n                      </div>\n\n                      <div className=\"p-2.5 bg-[#0e1422] rounded-lg border border-[#1c283d] text-xs text-slate-300 font-mono\">\n                        Link: <a href=\"https://youtube.com/shorts/preview_101\" target=\"_blank\" rel=\"noreferrer\" className=\"text-sky-400 hover:underline\">https://youtube.com/shorts/preview_101</a>\n                      </div>\n\n                      <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                        {[\"#AI\", \"#TechHacks\", \"#Productivity\", \"#Shorts\", \"#AlgoHacks\"].map(tag => (\n                          <span key={tag} className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-sky-300\">\n                            {tag}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* AI Agent (gemini-3.6-flash) */}\n              {selectedNode.id === \"node-ai-agent\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#181324] to-[#0f1422] border border-purple-500/40 rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400\">\n                          <Bot className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">AI Agent Orchestrator</h4>\n                          <span className=\"text-xs text-purple-300 font-mono\">gemini-3.6-flash \342\200\242 813 Tokens Used</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 font-mono\">\n                        Cost: $0.00095 (Free Quota)\n                      </span>\n                    </div>\n\n                    <div className=\"space-y-2.5 text-xs\">\n                      <div className=\"p-3 bg-[#0a0e17] rounded-xl border border-[#1d273a]\">\n                        <span className=\"text-[10px] uppercase font-bold text-purple-400 block mb-1\">Director Angle & Hook</span>\n                        <p className=\"text-white font-medium leading-relaxed\">\n                          \"Wait\342\200\224if you think you know AI prompting, this 1 habit will break your brain.\"\n                        </p>\n                      </div>\n\n                      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                        <div className=\"p-2.5 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                          <span className=\"text-[10px] text-slate-500 block\">Act 1 (Hook)</span>\n                          <span className=\"text-slate-300 font-medium\">Deconstruct prompt length myth</span>\n                        </div>\n                        <div className=\"p-2.5 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                          <span className=\"text-[10px] text-slate-500 block\">Act 2 (Value)</span>\n                          <span className=\"text-slate-300 font-medium\">3-step negative constraint loop</span>\n                        </div>\n                        <div className=\"p-2.5 rounded-lg bg-[#0e1422] border border-[#1c283d]\">\n                          <span className=\"text-[10px] text-slate-500 block\">Act 3 (CTA)</span>\n                          <span className=\"text-slate-300 font-medium\">Comment \'LOOP\' for blueprint</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Image Prompt Generator (Gemini 3.7) */}\n              {selectedNode.id === \"node-image-prompt\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400\">\n                          <Sparkles className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">Image Prompt Generator (Storyboard)</h4>\n                          <span className=\"text-xs text-amber-300 font-mono\">gemini-3.7-flash \342\200\242 4 Cinema Shots</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono\">\n                        10 RPM Free Tier\n                      </span>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2 text-xs\">\n                      {[\n                        { shot: \"Shot 1 (0-4s)\", title: \"Neon Cyberpunk Developer\", lens: \"35mm anamorphic\", prompt: \"Cinematic close-up of developer at 4 AM, neon blue terminal light, photorealistic 8k, volumetric light\" },\n                        { shot: \"Shot 2 (4-12s)\", title: \"Mechanical Keyboard Macro\", lens: \"Macro 50mm\", prompt: \"Overhead slow-motion shot of keyboard keys typing code with golden particle trails floating upward\" },\n                        { shot: \"Shot 3 (12-28s)\", title: \"Futuristic Data Corridor\", lens: \"Dynamic pan\", prompt: \"Futuristic glass corridor with holographic AI network nodes pulsing in emerald green\" },\n                        { shot: \"Shot 4 (28-36s)\", title: \"Modern Studio Desk\", lens: \"Low angle\", prompt: \"Minimalist workspace with dual monitors displaying viral retention curves spiking upward\" }\n                      ].map((s, i) => (\n                        <div key={i} className=\"p-3 bg-[#090d16] border border-[#1d273a] rounded-xl space-y-1\">\n                          <div className=\"flex items-center justify-between text-[11px]\">\n                            <span className=\"font-bold text-amber-400\">{s.shot}: {s.title}</span>\n                            <span className=\"font-mono text-slate-400\">{s.lens}</span>\n                          </div>\n                          <p className=\"text-slate-300 font-mono text-[11px] leading-relaxed line-clamp-2\">\n                            {s.prompt}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Stock / Clips Generator (Pexels) */}\n              {selectedNode.id === \"node-image-gen\" && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400\">\n                          <ImageIcon className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">Pexels Stock Clips Output</h4>\n                          <span className=\"text-xs text-purple-300 font-mono\">4 Vertical 9:16 Clips Selected</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono\">\n                        20,000 req/mo Free\n                      </span>\n                    </div>\n\n                    <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs\">\n                      {[\n                        { title: \"Terminal Code Matrix\", dur: \"8.5s\", res: \"1080x1920\" },\n                        { title: \"Neon Keyboard Typing\", dur: \"12.0s\", res: \"1080x1920\" },\n                        { title: \"Fiber Optic Corridor\", dur: \"10.0s\", res: \"1080x1920\" },\n                        { title: \"Minimalist Workspace\", dur: \"6.0s\", res: \"1080x1920\" }\n                      ].map((clip, idx) => (\n                        <div key={idx} className=\"p-2.5 bg-[#090d16] border border-[#1d273a] rounded-xl flex flex-col justify-between\">\n                          <div>\n                            <span className=\"text-[10px] text-purple-400 font-mono font-bold block\">Clip #{idx + 1}</span>\n                            <span className=\"font-semibold text-white truncate block text-[11px] mt-0.5\">{clip.title}</span>\n                          </div>\n                          <div className=\"mt-2 flex items-center justify-between text-[10px] font-mono text-slate-400\">\n                            <span>{clip.dur}</span>\n                            <span className=\"text-emerald-400\">{clip.res}</span>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Research Agent & YouTube Trends */}\n              {(selectedNode.id === \"node-subagent-research\" || selectedNode.id === \"node-tool-youtube\") && (\n                <div className=\"space-y-3\">\n                  <div className=\"p-4 bg-gradient-to-br from-[#131b2c] to-[#0f1524] border border-[#23324c] rounded-2xl shadow-xl\">\n                    <div className=\"flex items-center justify-between mb-3\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div className=\"w-8 h-8 rounded-lg bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400\">\n                          <Video className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"text-sm font-bold text-white\">YouTube Data API v3 Viral Benchmarks</h4>\n                          <span className=\"text-xs text-rose-300 font-mono\">10,000 Units/Day Free Tier</span>\n                        </div>\n                      </div>\n                      <span className=\"text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono\">\n                        Virality Score: 93.8 / 100\n                      </span>\n                    </div>\n\n                    <div className=\"space-y-2 text-xs\">\n                      {[\n                        { title: \"Stop Asking AI to Write Essays: 3 Prompt Secrets\", views: \"1.84M views\", retention: \"86%\", channel: \"AI Mastery\" },\n                        { title: \"The 10x Developer Blueprint for 2026\", views: \"940K views\", retention: \"81%\", channel: \"Code Architects\" }\n                      ].map((item, idx) => (\n                        <div key={idx} className=\"p-3 bg-[#090d16] border border-[#1d273a] rounded-xl flex items-center justify-between\">\n                          <div>\n                            <span className=\"font-semibold text-white block\">{item.title}</span>\n                            <span className=\"text-[11px] text-slate-400 mt-0.5 block\">{item.channel}</span>\n                          </div>\n                          <div className=\"text-right\">\n                            <span className=\"text-xs font-mono font-bold text-rose-400 block\">{item.views}</span>\n                            <span className=\"text-[10px] font-mono text-emerald-400 block\">Avg Retention: {item.retention}</span>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Default fallback table for other nodes */}\n              {![\n                \"node-voice-gen\",\n                \"node-render-video\",\n                \"node-upload\",\n                \"node-ai-agent\",\n                \"node-image-prompt\",\n                \"node-image-gen\",\n                \"node-subagent-research\",\n                \"node-tool-youtube\"\n              ].includes(selectedNode.id) && (\n                <div className=\"p-4 bg-[#101524] border border-[#1f2b40] rounded-xl text-xs space-y-3\">\n                  <div className=\"flex items-center justify-between text-slate-300\">\n                    <span className=\"font-bold text-white\">{selectedNode.label} Output Payload</span>\n                    <span className=\"font-mono text-[11px] text-emerald-400\">Status: SUCCESS</span>\n                  </div>\n                  <div className=\"p-3 bg-[#0a0e17] rounded-lg border border-[#1a2334] font-mono text-[11px] text-slate-300 space-y-1.5\">\n                    {Object.entries(activeNodeData || {}).map(([k, v]) => (\n                      <div key={k} className=\"flex items-start justify-between border-b border-slate-800/60 pb-1\">\n                        <span className=\"text-slate-500 font-semibold\">{k}:</span>\n                        <span className=\"text-sky-300 truncate max-w-md\">{typeof v === \"object\" ? JSON.stringify(v) : String(v)}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
