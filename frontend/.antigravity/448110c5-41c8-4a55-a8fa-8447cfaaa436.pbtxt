      replacement_content: "export interface CodeFile {\n  name: string;\n  path: string;\n  desc: string;\n  content: string;\n  exists: boolean;\n}\n\nexport type N8nNodeCategory = \n  | \"trigger\" \n  | \"routing\" \n  | \"agent\" \n  | \"subagent\" \n  | \"tool\" \n  | \"model\" \n  | \"memory\" \n  | \"output\";\n\nexport interface FreeTierLimitInfo {\n  tierName: string;\n  quotaLimit: string;\n  whyChosen: string;\n  apiKeyName: string;\n  isConfigured: boolean;\n  docUrl?: string;\n}\n\nexport interface WorkflowNode {\n  id: string;\n  name: string;\n  label: string;\n  subtitle: string;\n  category: N8nNodeCategory;\n  iconName: string;\n  x: number;\n  y: number;\n  width?: number;\n  height?: number;\n  status: \"idle\" | \"running\" | \"success\" | \"error\" | \"waiting\";\n  inputs?: Array<{ id: string; label: string; type: \"main\" | \"model\" | \"memory\" | \"tool\" }>;\n  outputs?: Array<{ id: string; label: string; type: \"main\" | \"true\" | \"false\" | \"success\" | \"error\" }>;\n  subPins?: {\n    model?: boolean;\n    think?: boolean;\n    memory?: boolean;\n    tools?: boolean;\n  };\n  freeTierInfo?: FreeTierLimitInfo;\n  defaultParams?: Record<string, any>;\n  lastOutput?: Record<string, any>;\n}\n\nexport interface WorkflowEdge {\n  id: string;\n  fromNode: string;\n  fromPort?: string;\n  toNode: string;\n  toPort?: string;\n  type?: \"main\" | \"dashed\" | \"subpin\";\n  animated?: boolean;\n  status?: \"active\" | \"idle\" | \"success\";\n  label?: string;\n}\n\nexport interface WorkflowExecutionStep {\n  nodeId: string;\n  nodeName: string;\n  status: \"success\" | \"error\" | \"running\" | \"skipped\";\n  durationMs: number;\n  inputData?: any;\n  outputData?: any;\n  error?: string;\n}\n\nexport interface WorkflowExecution {\n  id: string;\n  workflowName: string;\n  status: \"SUCCESS\" | \"RUNNING\" | \"WAITING\" | \"ERROR\";\n  triggerType: \"TELEGRAM_WEBHOOK\" | \"MANUAL_TEST\" | \"CRON_SCHEDULER\";\n  startedAt: string;\n  durati