  file_change {
    absolute_path_uri: "file:///src/components/PipelineBoard.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* 10-Stage Visual Workflow Header Card */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4\">\n          <div>\n            <h2 className=\"text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2\">\n              <Sparkles className=\"w-4 h-4 text-cyan-400\" />\n              10-Stage Autonomous Pipeline Architecture\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Each stage is powered by a dedicated agent with automated cost tracking and HITL approval gates.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3 text-xs text-slate-400\">\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" /> Completed\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-cyan-500 animate-pulse\" /> Active\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-amber-400\" /> HITL Gate\n            </span>\n          </div>\n        </div>\n\n        {/* Responsive Stage Stepper */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 lg:grid-cols-10 gap-2\">\n          {STAGES.map((st, idx) => {\n            const isCurrent = selectedJob && selectedJob.current_stage === st.key;\n            const status = selectedJob ? getStageStatus(selectedJob, st.key) : \"upcoming\";\n\n            let borderClass = \"border-slate-800 bg-slate-900/60 text-slate-400\";\n            if (status === \"completed\") {\n              borderClass = \"border-emerald-500/40 bg-emerald-950/20 text-emerald-300\";\n            } else if (status === \"active\") {\n              borderClass = \"border-cyan-500 bg-cyan-950/30 text-cyan-200 ring-2 ring-cyan-500/20\";\n            } else if (status === \"waiting\") {\n              borderClass = \"border-amber-500/80 bg-amber-950/30 text-amber-200 ring-2 ring-amber-500/30\";\n            }\n\n            return (\n              <div \n                key={st.key}\n                className={`p-2.5 rounded-xl border flex flex-col justify-between transition-all ${borderClass}`}\n              >\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <span className=\"text-[10px] font-mono font-bold text-slate-400\">\n                    {String(idx + 1).padStart(2, \'0\')}\n                  </span>\n                  {st.isGate && (\n                    <span className=\"text-[9px] font-bold px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n                      GATE\n                    </span>\n                  )}\n                </div>\n                <div className=\"font-bold text-xs truncate text-white\">{st.name}</div>\n                <div className=\"text-[10px] truncate text-slate-400 mt-0.5\">{st.agent.replace(\"Agent\", \"\")}</div>\n              </div>\n            );\n          })}\n        </div>\n      </div>"
      replacement_content: "      {/* 10-Stage Visual Workflow Header Bento Card */}\n      <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5\">\n          <div>\n            <h2 className=\"text-sm font-semibold uppercase tracking-wider text-zinc-300 flex items-center gap-2\">\n              <span className=\"w-2 h-2 rounded-full bg-indigo-500 animate-pulse\"></span>\n              10-Stage Autonomous Pipeline Architecture\n            </h2>\n            <p className=\"text-xs text-zinc-400 mt-0.5\">\n              Each stage is powered by a dedicated agent with automated cost tracking and HITL approval gates.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500\" /> Completed\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-indigo-500 animate-pulse\" /> Active\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_5px_rgba(245,158,11,0.5)]\" /> HITL Gate\n            </span>\n          </div>\n        </div>\n\n        {/* Responsive Stage Stepper */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 lg:grid-cols-10 gap-2.5\">\n          {STAGES.map((st, idx) => {\n            const isCurrent = selectedJob && selectedJob.current_stage === st.key;\n            const status = selectedJob ? getStageStatus(selectedJob, st.key) : \"upcoming\";\n\n            let borderClass = \"border-[#27272a] bg-[#09090b] text-zinc-400\";\n            if (status === \"completed\") {\n              borderClass = \"border-emerald-500/30 bg-emerald-950/20 text-emerald-300\";\n            } else if (status === \"active\") {\n              borderClass = \"border-indigo-500 bg-indigo-950/30 text-indigo-200 ring-1 ring-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.25)]\";\n            } else if (status === \"waiting\") {\n              borderClass = \"border-amber-500/60 bg-amber-950/30 text-amber-200 ring-1 ring-amber-500/40 shadow-[0_0_10px_rgba(245,158,11,0.25)]\";\n            }\n\n            return (\n              <div \n                key={st.key}\n                className={`p-3 rounded-2xl border flex flex-col justify-between transition-all ${borderClass}`}\n              >\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <span className=\"text-[10px] font-mono font-bold text-zinc-500\">\n                    {String(idx + 1).padStart(2, \'0\')}\n                  </span>\n                  {st.isGate && (\n                    <span className=\"text-[9px] font-bold px-1.5 py-0.2 rounded-md bg-amber-500/10 text-amber-300 border border-amber-500/30\">\n                      GATE\n                    </span>\n                  )}\n                </div>\n                <div className=\"font-bold text-xs truncate text-[#fafafa]\">{st.name}</div>\n                <div className=\"text-[10px] truncate text-zinc-400 mt-0.5\">{st.agent.replace(\"Agent\", \"\")}</div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Bento Metric Quick Cards Row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Bento Stat 1: Total Savings */}\n        <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 flex items-center justify-between shadow-sm\">\n          <div>\n            <p className=\"text-xs text-zinc-500 font-semibold mb-1 uppercase tracking-wider\">Total Savings</p>\n            <p className=\"text-2xl font-bold font-mono text-emerald-400\">$842.10</p>\n            <p className=\"text-[10px] text-zinc-500 mt-0.5\">Automated Production Yield</p>\n          </div>\n          <div className=\"w-12 h-12 rounded-full border-4 border-emerald-500/20 border-t-emerald-500 flex items-center justify-center text-[10px] font-bold text-emerald-400 font-mono shrink-0\">\n            +12%\n          </div>\n        </div>\n\n        {/* Bento Stat 2: Active Pipeline Rate */}\n        <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 flex items-center justify-between shadow-sm\">\n          <div>\n            <p className=\"text-xs text-zinc-500 font-semibold mb-1 uppercase tracking-wider\">Active Jobs</p>\n            <p className=\"text-2xl font-bold font-mono text-indigo-400\">\n              {jobs.filter(j => j.status !== \"COMPLETED\").length} <span className=\"text-zinc-500 text-sm font-normal\">/ {jobs.length}</span>\n            </p>\n            <p className=\"text-[10px] text-zinc-500 mt-0.5\">Pipelines in Execution</p>\n          </div>\n          <div className=\"w-12 h-12 rounded-full border-4 border-indigo-500/20 border-t-indigo-500 flex items-center justify-center text-[10px] font-bold text-indigo-400 font-mono shrink-0\">\n            9 Stg\n          </div>\n        </div>\n\n        {/* Bento Stat 3: Approval Pending */}\n        <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 flex items-center justify-between shadow-sm\">\n          <div>\n            <p className=\"text-xs text-zinc-500 font-semibold mb-1 uppercase tracking-wider\">HITL Queue</p>\n            <p className=\"text-2xl font-bold font-mono text-amber-400\">\n              {jobs.filter(j => j.status === \"AWAITING_APPROVAL\" || j.status === \"AWAITING_PREMIUM\").length}\n            </p>\n            <p className=\"text-[10px] text-zinc-500 mt-0.5\">Awaiting Review</p>\n          </div>\n          <div className=\"w-12 h-12 rounded-full border-4 border-amber-500/20 border-t-amber-500 flex items-center justify-center text-[10px] font-bold text-amber-400 font-mono shrink-0\">\n            {jobs.filter(j => j.status === \"AWAITING_APPROVAL\").length ? \"GATE\" : \"OK\"}\n          </div>\n        </div>\n\n        {/* Bento Stat 4: Fast Postiz Status */}\n        <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-5 flex items-center justify-between shadow-sm\">\n          <div>\n            <p className=\"text-xs text-zinc-500 font-semibold mb-1 uppercase tracking-wider\">Postiz Fleet</p>\n            <p className=\"text-2xl font-bold font-mono text-white\">Live</p>\n            <p className=\"text-[10px] text-zinc-500 mt-0.5\">TikTok, IG Reels, Shorts</p>\n          </div>\n          <div className=\"w-12 h-12 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0\">\n            <Zap className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>"
    }
