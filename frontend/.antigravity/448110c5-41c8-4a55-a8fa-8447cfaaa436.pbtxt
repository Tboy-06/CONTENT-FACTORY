  file_change {
    absolute_path_uri: "file:///src/components/NewJobModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { X, Sparkles, Plus, Check } from \"lucide-react\";\n\ninterface NewJobModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onCreate: (data: { niche: string; format: string; platforms: string[]; premium: boolean }) => Promise<void>;\n}\n\nconst PRESETS = [\n  \"AI Productivity Hacks & Automation\",\n  \"Stoic Philosophy & Deep Work Focus\",\n  \"Cyberpunk Hardware & Future Tech Lore\",\n  \"DeFi & Crypto Algorithmic Trading\",\n  \"Billionaire 5 AM Routine Exposed\"\n];\n\nexport const NewJobModal: React.FC<NewJobModalProps> = ({ isOpen, onClose, onCreate }) => {\n  const [niche, setNiche] = useState(\"AI Productivity Hacks & Automation\");\n  const [format, setFormat] = useState(\"9:16 Vertical Short\");\n  const [platforms, setPlatforms] = useState<string[]>([\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"]);\n  const [premium, setPremium] = useState(false);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  if (!isOpen) return null;\n\n  const togglePlatform = (p: string) => {\n    if (platforms.includes(p)) {\n      if (platforms.length > 1) setPlatforms(platforms.filter(x => x !== p));\n    } else {\n      setPlatforms([...platforms, p]);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!niche.trim() || isSubmitting) return;\n\n    setIsSubmitting(true);\n    try {\n      await onCreate({ niche, format, platforms, premium });\n      onClose();\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl animate-in fade-in zoom-in-95 duration-200\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-white text-sm\">Spawn Content Pipeline</h3>\n              <p className=\"text-[11px] text-slate-400\">Initialize 10-stage autonomous generation via ManagerAgent</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-4\">\n          {/* Niche Input */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">\n              Niche or Content Topic\n            </label>\n            <input\n              type=\"text\"\n              value={niche}\n              onChange={(e) => setNiche(e.target.value)}\n              placeholder=\"e.g. AI Workflow Automation, Stoic Philosophy...\"\n              className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500\"\n              required\n            />\n          </div>\n\n          {/* Quick Preset Pills */}\n          <div>\n            <label className=\"block text-[11px] font-medium text-slate-400 mb-1.5\">\n              Or pick an instant viral preset:\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {PRESETS.map((p, idx) => (\n                <button\n                  type=\"button\"\n                  key={idx}\n                  onClick={() => setNiche(p)}\n                  className={`text-[10px] px-2.5 py-1 rounded-lg border transition-all cursor-pointer ${\n                    niche === p\n                      ? \"bg-cyan-500/20 border-cyan-500 text-cyan-300 font-semibold\"\n                      : \"bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700 hover:text-slate-200\"\n                  }`}\n                >\n                  {p}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Format selection */}\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">\n                Video Format\n              </label>\n              <select\n                value={format}\n                onChange={(e) => setFormat(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500\"\n              >\n                <option value=\"9:16 Vertical Short\">9:16 Vertical Short (Shorts/Reels)</option>\n                <option value=\"1:1 Square Feed\">1:1 Square Feed (Instagram/FB)</option>\n                <option value=\"16:9 Landscape\">16:9 Landscape Video</option>\n              </select>\n            </div>\n\n            {/* Target Platforms */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">\n                Target Channels\n              </label>\n              <div className=\"flex flex-wrap gap-1\">\n                {[\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"].map((plat) => {\n                  const active = platforms.includes(plat);\n                  return (\n                    <button\n                      type=\"button\"\n                      key={plat}\n                      onClick={() => togglePlatform(plat)}\n                      className={`text-[10px] px-2 py-1 rounded-md border font-medium transition cursor-pointer ${\n                        active\n                          ? \"bg-blue-500/20 border-blue-500 text-blue-300\"\n                          : \"bg-slate-950 border-slate-800 text-slate-500\"\n                      }`}\n                    >\n                      {plat}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          {/* Premium Mode Toggle */}\n          <div className=\"p-3 rounded-xl bg-purple-950/20 border border-purple-800/40 flex items-center justify-between\">\n            <div>\n              <div className=\"text-xs font-bold text-purple-300\">Premium Veo 3.1 Mode</div>\n              <div className=\"text-[10px] text-slate-400\">\n                Pause pipeline at VIDEO stage for high-bitrate Veo 4K render upload.\n              </div>\n            </div>\n            <input\n              type=\"checkbox\"\n              checked={premium}\n              onChange={(e) => setPremium(e.target.checked)}\n              className=\"w-4 h-4 rounded text-purple-600 focus:ring-purple-500 bg-slate-900 border-slate-700 cursor-pointer\"\n            />\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"pt-3 border-t border-slate-800 flex items-center justify-end gap-2\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white transition cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              disabled={isSubmitting}\n              className=\"flex items-center gap-1.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-xs font-bold px-4 py-2 rounded-xl shadow-lg shadow-cyan-500/20 transition cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>{isSubmitting ? \"Spawning...\" : \"Launch Pipeline\"}</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
