          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (thisNodeIdx === currStageIdx) return \"active\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return \"pending\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
