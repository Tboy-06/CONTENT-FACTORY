    instruction: "Update App.tsx to use N8nWorkflowCanvas, BottomStatusBar, and updated tabs"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \"react\";\nimport { Job, VaultData } from \"./types\";\nimport { Header } from \"./components/Header\";\nimport { PipelineBoard } from \"./components/PipelineBoard\";\nimport { TelegramSimulator } from \"./components/TelegramSimulator\";\nimport { AgentsStudio } from \"./components/AgentsStudio\";\nimport { VaultExplorer } from \"./components/VaultExplorer\";\nimport { CodeExplorer } from \"./components/CodeExplorer\";\nimport { NewJobModal } from \"./components/NewJobModal\";\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\"pipeline\" | \"telegram\" | \"agents\" | \"vault\" | \"code\">(\"pipeline\");\n  const [jobs, setJobs] = useState<Job[]>([]);\n  const [selectedJob, setSelectedJob] = useState<Job | null>(null);\n  const [vaultData, setVaultData] = useState<VaultData | null>(null);\n  const [isNewJobOpen, setIsNewJobOpen] = useState(false);\n  const [isAdvancing, setIsAdvancing] = useState(false);\n\n  // Load initial data\n  const fetchData = async () => {\n    try {\n      const [jobsRes, vaultRes] = await Promise.all([\n        fetch(\"/api/jobs\"),\n        fetch(\"/api/vault\")\n      ]);\n      if (jobsRes.ok) {\n        const jobsJson: Job[] = await jobsRes.json();\n        setJobs(jobsJson);\n        if (!selectedJob && jobsJson.length > 0) {\n          setSelectedJob(jobsJson[0]);\n        } else if (selectedJob) {\n          const updated = jobsJson.find(j => j.id === selectedJob.id);\n          if (updated) setSelectedJob(updated);\n        }\n      }\n      if (vaultRes.ok) {\n        const vaultJson: VaultData = await vaultRes.json();\n        setVaultData(vaultJson);\n      }\n    } catch (e) {\n      console.error(\"Error fetching data:\", e);\n    }\n  };\n\n  useEffect(() => {\n    fetchData();\n  }, []);\n\n  // Advance stage\n  const handleAdvanceStage = async (jobId: number) => {\n    setIsAdvancing(true);\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/advance`, { method: \"POST\" });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Failed to advance stage:\", e);\n    } finally {\n      setIsAdvancing(false);\n    }\n  };\n\n  // Approve stage\n  const handleApproveStage = async (jobId: number) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/approve`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ notes: \"Approved via Web UI Console\" })\n      });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Approval error:\", e);\n    }\n  };\n\n  // Reject stage\n  const handleRejectStage = async (jobId: number, reason: string) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/reject`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ reason })\n      });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Rejection error:\", e);\n    }\n  };\n\n  // Attach premium render\n  const handleUploadPremium = async (jobId: number) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/upload-premium`, { method: \"POST\" });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Upload premium error:\", e);\n    }\n  };\n\n  // Telegram Command Dispatcher\n  const handleTelegramCommand = async (cmd: string): Promise<string> => {\n    const res = await fetch(\"/api/telegram/command\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ command: cmd })\n    });\n    const data = await res.json();\n    await fetchData();\n    return data.response;\n  };\n\n  // Create new job\n  const handleCreateJob = async (data: { niche: string; format: string; platforms: string[]; premium: boolean }) => {\n    const res = await fetch(\"/api/jobs\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(data)\n    });\n    if (res.ok) {\n      const newJob: Job = await res.json();\n      await fetchData();\n      setSelectedJob(newJob);\n      setActiveTab(\"pipeline\");\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#09090b] text-[#fafafa] flex flex-col font-sans selection:bg-indigo-500 selection:text-white antialiased\">\n      {/* Top Header */}\n      <Header\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        vaultData={vaultData}\n        onOpenNewJob={() => setIsNewJobOpen(true)}\n      />\n\n      {/* Main View Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6\">\n        {activeTab === \"pipeline\" && (\n          <PipelineBoard\n            jobs={jobs}\n            selectedJob={selectedJob}\n            onSelectJob={setSelectedJob}\n            onAdvanceStage={handleAdvanceStage}\n            onApproveStage={handleApproveStage}\n            onRejectStage={handleRejectStage}\n            onUploadPremium={handleUploadPremium}\n            isAdvancing={isAdvancing}\n          />\n        )}\n\n        {activeTab === \"telegram\" && (\n          <TelegramSimulator onCommandRun={handleTelegramCommand} />\n        )}\n\n        {activeTab === \"agents\" && (\n          <AgentsStudio />\n        )}\n\n        {activeTab === \"vault\" && (\n          <VaultExplorer vaultData={vaultData} />\n        )}\n\n        {activeTab === \"code\" && (\n          <CodeExplorer />\n        )}\n      </main>\n\n      {/* New Job Modal */}\n      <NewJobModal\n        isOpen={isNewJobOpen}\n        onClose={() => setIsNewJobOpen(false)}\n        onCreate={handleCreateJob}\n      />\n    </div>\n  );\n}"
        replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Job, VaultData } from \"./types\";\nimport { Header, NavTabType } from \"./components/Header\";\nimport { N8nWorkflowCanvas } from \"./components/N8nWorkflowCanvas\";\nimport { BottomStatusBar } from \"./components/BottomStatusBar\";\nimport { TelegramSimulator } from \"./components/TelegramSimulator\";\nimport { VaultExplorer } from \"./components/VaultExplorer\";\nimport { CodeExplorer } from \"./components/CodeExplorer\";\nimport { NewJobModal } from \"./components/NewJobModal\";\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<NavTabType>(\"pipeline\");\n  const [jobs, setJobs] = useState<Job[]>([]);\n  const [selectedJob, setSelectedJob] = useState<Job | null>(null);\n  const [vaultData, setVaultData] = useState<VaultData | null>(null);\n  const [isNewJobOpen, setIsNewJobOpen] = useState(false);\n  const [isAdvancing, setIsAdvancing] = useState(false);\n\n  // Load initial data\n  const fetchData = async () => {\n    try {\n      const [jobsRes, vaultRes] = await Promise.all([\n        fetch(\"/api/jobs\"),\n        fetch(\"/api/vault\")\n      ]);\n      if (jobsRes.ok) {\n        const jobsJson: Job[] = await jobsRes.json();\n        setJobs(jobsJson);\n        if (!selectedJob && jobsJson.length > 0) {\n          setSelectedJob(jobsJson[0]);\n        } else if (selectedJob) {\n          const updated = jobsJson.find(j => j.id === selectedJob.id);\n          if (updated) setSelectedJob(updated);\n        }\n      }\n      if (vaultRes.ok) {\n        const vaultJson: VaultData = await vaultRes.json();\n        setVaultData(vaultJson);\n      }\n    } catch (e) {\n      console.error(\"Error fetching data:\", e);\n    }\n  };\n\n  useEffect(() => {\n    fetchData();\n  }, []);\n\n  // Advance stage\n  const handleAdvanceStage = async (jobId: number) => {\n    setIsAdvancing(true);\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/advance`, { method: \"POST\" });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Failed to advance stage:\", e);\n    } finally {\n      setIsAdvancing(false);\n    }\n  };\n\n  // Approve stage\n  const handleApproveStage = async (jobId: number) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/approve`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ notes: \"Approved via n8n Canvas Console\" })\n      });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Approval error:\", e);\n    }\n  };\n\n  // Reject stage\n  const handleRejectStage = async (jobId: number, reason: string) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/reject`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ reason })\n      });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Rejection error:\", e);\n    }\n  };\n\n  // Attach premium render\n  const handleUploadPremium = async (jobId: number) => {\n    try {\n      const res = await fetch(`/api/jobs/${jobId}/upload-premium`, { method: \"POST\" });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (e) {\n      console.error(\"Upload premium error:\", e);\n    }\n  };\n\n  // Telegram Command Dispatcher\n  const handleTelegramCommand = async (cmd: string): Promise<string> => {\n    const res = await fetch(\"/api/telegram/command\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ command: cmd })\n    });\n    const data = await res.json();\n    await fetchData();\n    return data.response;\n  };\n\n  // Create new job\n  const handleCreateJob = async (data: { niche: string; format: string; platforms: string[]; premium: boolean }) => {\n    const res = await fetch(\"/api/jobs\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(data)\n    });\n    if (res.ok) {\n      const newJob: Job = await res.json();\n      await fetchData();\n      setSelectedJob(newJob);\n      setActiveTab(\"pipeline\");\n    }\n  };\n\n  return (\n    <div className=\"h-screen w-screen bg-[#070b14] text-slate-100 flex flex-col font-sans overflow-hidden antialiased\">\n      {/* Top Header (matches screenshot) */}\n      <Header\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        vaultData={vaultData}\n        onOpenNewJob={() => setIsNewJobOpen(true)}\n      />\n\n      {/* Main Viewport */}\n      <main className=\"flex-1 flex flex-col min-h-0 overflow-hidden relative\">\n        {activeTab === \"pipeline\" && (\n          <N8nWorkflowCanvas\n            jobs={jobs}\n            selectedJob={selectedJob}\n            onSelectJob={setSelectedJob}\n            onAdvanceStage={handleAdvanceStage}\n            onApproveStage={handleApproveStage}\n            onRejectStage={handleRejectStage}\n            onUploadPremium={handleUploadPremium}\n            onOpenNewJob={() => setIsNewJobOpen(true)}\n            isAdvancing={isAdvancing}\n          />\n        )}\n\n        {activeTab === \"analytics\" && (\n          <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 max-w-7xl mx-auto w-full\">\n            <VaultExplorer vaultData={vaultData} defaultTab=\"retention\" />\n          </div>\n        )}\n\n        {activeTab === \"style_guides\" && (\n          <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 max-w-7xl mx-auto w-full\">\n            <VaultExplorer vaultData={vaultData} defaultTab=\"styles\" />\n          </div>\n        )}\n\n        {activeTab === \"telegram\" && (\n          <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 max-w-6xl mx-auto w-full\">\n            <TelegramSimulator onCommandRun={handleTelegramCommand} />\n          </div>\n        )}\n\n        {activeTab === \"code\" && (\n          <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 max-w-7xl mx-auto w-full\">\n            <CodeExplorer />\n          </div>\n        )}\n      </main>\n\n      {/* Bottom Status Bar (matches screenshot) */}\n      <BottomStatusBar \n        vaultData={vaultData}\n        completedJobsCount={jobs.filter(j => j.status === \"COMPLETED\").length}\n      />\n\n      {/* New Job Modal */}\n      <NewJobModal\n        isOpen={isNewJobOpen}\n        onClose={() => setIsNewJobOpen(false)}\n        onCreate={handleCreateJob}\n      />\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
