        lines {
          text: "      if (selectedJob.status === \"AWAITING_PREMIUM\") return \"active\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (currStageIdx > PIPELINE_ORDER.indexOf(\"VIDEO\")) return \"completed\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (currStageIdx === PIPELINE_ORDER.indexOf(\"VIDEO\") && selectedJob.config.premium) return \"active\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return \"pending\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
