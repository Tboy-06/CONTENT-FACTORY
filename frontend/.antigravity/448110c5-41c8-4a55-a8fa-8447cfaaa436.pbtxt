mini-3.6-flash (Primary LLM)\",\n      quotaLimit: \"15 RPM, 1,500 RPD, 1M tokens/min\",\n      whyChosen: \"Fastest, cheapest, structured JSON schema output, 1M context\",\n      apiKeyName: \"GEMINI_API_KEY\",\n      isConfigured: true\n    }\n  },\n  // Model sub-node under AI Agent\n  {\n    id: \"node-model-gemini-flash\",\n    name: \"Gemini Chat Model\",\n    label: \"gemini-3.6-flash\",\n    subtitle: \"Chat Model (15 RPM Free)\",\n    category: \"model\",\n    iconName: \"Cpu\",\n    x: 520,\n    y: 380,\n    width: 180,\n    height: 74,\n    status: \"idle\",\n    freeTierInfo: {\n      tierName: \"Google AI Studio Free Tier\",\n      quotaLimit: \"15 RPM, 1,500 RPD, 1.5M tokens/day\",\n      whyChosen: \"Generates high retention scripts with JSON schema without credit card\",\n      apiKeyName: \"GEMINI_API_KEY\",\n      isConfigured: true,\n      docUrl: \"https://aistudio.google.com/apikey\"\n    }\n  },\n  // Director reasoning prompt\n  {\n    id: \"node-think-prompt\",\n    name: \"Think Reasoning\",\n    label: \"Think\",\n    subtitle: \"Director System Directive\",\n    category: \"agent\",\n    iconName: \"Brain\",\n    x: 730,\n    y: 380,\n    width: 170,\n    height: 74,\n    status: \"idle\"\n  },\n  // Vault Memory\n  {\n    id: \"node-vault-memory\",\n    name: \"Simple Memory\",\n    label: \"Memory\",\n    subtitle: \"SQLite Window Buffer\",\n    category: \"memory\",\n    iconName: \"Database\",\n    x: 930,\n    y: 380,\n    width: 170,\n    height: 74,\n    status: \"idle\"\n  },\n  // 4. JSON Split\n  {\n    id: \"node-json-split\",\n    name: \"JSON Split\",\n    label: \"JSON Split\",\n    subtitle: \"Split audio & visual tracks\",\n    category: \"routing\",\n    iconName: \"GitFork\",\n    x: 1010,\n    y: 200,\n    width: 180,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [\n      { id: \"out-audio\", label: \"Audio\", type: \"main\" },\n      { id: \"out-visual\", label: \"Visual\", type: \"main\" }\n    ]\n  },\n  // 5. Audio Branch: Voice Generator (Edge-TTS)\n  {\n    id: \"node-voice-gen\",\n    name: \"Voice Generator\",\n    label: \"Voice Generator\",\n    subtitle: \"Edge-TTS AriaNeural (Free)\",\n    category: \"tool\",\n    iconName: \"Volume2\",\n    x: 1300,\n    y: 90,\n    width: 200,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }],\n    freeTierInfo: {\n      tierName: \"Microsoft Edge-TTS\",\n      quotaLimit: \"100% FREE (No API key, unlimited)\",\n      whyChosen: \"Zero-cost natural neural voice narration with custom SSML\",\n      apiKeyName: \"NONE\",\n      isConfigured: true\n    }\n  },\n  // 6. Visual Branch: Image Prompt Generator (Gemini 3.7)\n  {\n    id: \"node-image-prompt\",\n    name: \"Image Prompt Generator\",\n    label: \"Image Prompt Gen\",\n    subtitle: \"gemini-3.7-flash (10 RPM)\",\n    category: \"model\",\n    iconName: \"Sparkles\",\n    x: 1300,\n    y: 280,\n    width: 210,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }],\n    freeTierInfo: {\n      tierName: \"gemini-3.7-flash\",\n      quotaLimit: \"10 RPM, 1,000 RPD\",\n      whyChosen: \"High reasoning for cinematic storyboard prompts and safe-zone layouts\",\n      apiKeyName: \"GEMINI_API_KEY\",\n      isConfigured: true\n    }\n  },\n  // 7. Visual Branch: Stock & Clip Generator (Pexels API)\n  {\n    id: \"node-image-gen\",\n    name: \"Image Generator\",\n    label: \"Stock & Clip Selector\",\n    subtitle: \"Pexels 9:16 vertical clips\",\n    category: \"tool\",\n    iconName: \"Image\",\n    x: 1590,\n    y: 280,\n    width: 200,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }],\n    freeTierInfo: {\n      tierName: \"Pexels API Free Tier\",\n      quotaLimit: \"200 req/hr, 20,000 requests/mo\",\n      whyChosen: \"High quality royalty-free vertical video clips without watermarks\",\n      apiKeyName: \"PEXELS_API_KEY\",\n      isConfigured: true\n    }\n  },\n  // 8. Merge Node (Sync Audio + Video)\n  {\n    id: \"node-merge\",\n    name: \"Merge\",\n    label: \"Merge Streams\",\n    subtitle: \"Combine voice & video cuts\",\n    category: \"routing\",\n    iconName: \"Layers\",\n    x: 1880,\n    y: 200,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    inputs: [\n      { id: \"in-audio\", label: \"Audio\", type: \"main\" },\n      { id: \"in-video\", label: \"Video\", type: \"main\" }\n    ],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }]\n  },\n  // 9. Render Final Video (FFmpeg)\n  {\n    id: \"node-render-video\",\n    name: \"Render Final Video\",\n    label: \"Render Final Video\",\n    subtitle: \"FFmpeg 1080x1920 60FPS\",\n    category: \"tool\",\n    iconName: \"Film\",\n    x: 2170,\n    y: 200,\n    width: 210,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }],\n    freeTierInfo: {\n      tierName: \"FFmpeg Local Engine\",\n      quotaLimit: \"100% FREE (Local hardware acceleration)\",\n      whyChosen: \"Concatenation, word-by-word subtitles, LUFS audio normalization\",\n      apiKeyName: \"LOCAL\",\n      isConfigured: true\n    }\n  },\n  // 10. Wait & QC Gate\n  {\n    id: \"node-wait\",\n    name: \"Wait\",\n    label: \"QC & Safety Gate\",\n    subtitle: \"Loudness & Safe-zones check\",\n    category: \"subagent\",\n    iconName: \"ShieldCheck\",\n    x: 2470,\n    y: 200,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }]\n  },\n  // 11. Download Video\n  {\n    id: \"node-download\",\n    name: \"Download Video\",\n    label: \"Download Video\",\n    subtitle: \"Archive in Vault storage\",\n    category: \"memory\",\n    iconName: \"DownloadCloud\",\n    x: 2750,\n    y: 200,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }]\n  },\n  // 12. Upload a video (YouTube Shorts / Socials)\n  {\n    id: \"node-upload\",\n    name: \"Upload a video\",\n    label: \"Upload a video\",\n    subtitle: \"YouTube Shorts / Postiz API\",\n    category: \"output\",\n    iconName: \"Globe\",\n    x: 3030,\n    y: 200,\n    width: 200,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    freeTierInfo: {\n      tierName: \"YouTube / Postiz API\",\n      quotaLimit: \"Free scheduled posting\",\n      whyChosen: \"Direct upload to YouTube Shorts and multi-social distribution\",\n      apiKeyName: \"POSTIZ_API_KEY\",\n      isConfigured: true\n    }\n  },\n\n  // Sub-Agent Intelligence Pod (Connected from AI Agent)\n  {\n    id: \"node-subagent-research\",\n    name: \"Research Agent\",\n    label: \"Research Agent\",\n    subtitle: \"Trend & Hook Intelligence\",\n    category: \"subagent\",\n    iconName: \"Compass\",\n    x: 1140,\n    y: 470,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    subPins: { model: true, tools: true }\n  },\n  {\n    id: \"node-tool-youtube\",\n    name: \"YouTube Data API v3\",\n    label: \"YouTube Trends\",\n    subtitle: \"search: viral hooks (10k units)\",\n    category: \"tool\",\n    iconName: \"Video\",\n    x: 1400,\n    y: 470,\n    width: 200,\n    height: 76,\n    status: \"idle\",\n    freeTierInfo: {\n      tierName: \"YouTube Data API v3\",\n      quotaLimit: \"10,000 units/day (~500 searches)\",\n      whyChosen: \"Real competitor view counts & retention metrics\",\n      apiKeyName: \"YOUTUBE_API_KEY\",\n      isConfigured: true\n    }\n  },\n  {\n    id: \"node-tool-tavily\",\n    name: \"Tavily Search\",\n    label: \"Tavily Search\",\n    subtitle: \"Web deep-dive (1k req/mo)\",\n    category: \"tool\",\n    iconName: \"Search\",\n    x: 1670,\n    y: 470,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    freeTierInfo: {\n      tierName: \"Tavily AI Search\",\n      quotaLimit: \"1,000 requests/month\",\n      whyChosen: \"Returns clean markdown structured for LLM ingestion\",\n      apiKeyName: \"TAVILY_API_KEY\",\n      isConfigured: true\n    }\n  },\n\n  // Vault & Telegram Notification Pod\n  {\n    id: \"node-append-vault\",\n    name: \"Append to SQLite Vault\",\n    label: \"Append to Vault\",\n    subtitle: \"vault.db (Persistent Ledger)\",\n    category: \"memory\",\n    iconName: \"Database\",\n    x: 2750,\n    y: 350,\n    width: 190,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n    outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }]\n  },\n  {\n    id: \"node-telegram-response\",\n    name: \"Telegram Response\",\n    label: \"Telegram Notice\",\n    subtitle: \"Push notification with video\",\n    category: \"output\",\n    iconName: \"Send\",\n    x: 3030,\n    y: 350,\n    width: 200,\n    height: 76,\n    status: \"idle\",\n    inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }]\n  }\n];\n\nexport const DEFAULT_WORKFLOW_EDGES: WorkflowEdge[] = [\n  // Main linear pipeline\n  { id: \"e1\", fromNode: \"node-trigger\", toNode: \"node-edit-fields\", type: \"main\" },\n  { id: \"e2\", fromNode: \"node-edit-fields\", toNode: \"node-ai-agent\", type: \"main\" },\n  { id: \"e3\", fromNode: \"node-ai-agent\", toNode: \"node-json-split\", type: \"main\" },\n  // Branches from JSON Split\n  { id: \"e4\", fromNode: \"node-json-split\", toNode: \"node-voice-gen\", type: \"main\", label: \"Audio\" },\n  { id: \"e5\", fromNode: \"node-json-split\", toNode: \"node-image-prompt\", type: \"main\", label: \"Visuals\" },\n  { id: \"e6\", fromNode: \"node-image-prompt\", toNode: \"node-image-gen\", type: \"main\" },\n  // Merge\n  { id: \"e7\", fromNode: \"node-voice-gen\", toNode: \"node-merge\", type: \"main\" },\n  { id: \"e8\", fromNode: \"node-image-gen\", toNode: \"node-merge\", type: \"main\" },\n  // Post-merge pipeline\n  { id: \"e9\", fromNode: \"node-merge\", toNode: \"node-render-video\", type: \"main\" },\n  { id: \"e10\", fromNode: \"node-render-video\", toNode: \"node-wait\", type: \"main\" },\n  { id: \"e11\", fromNode: \"node-wait\", toNode: \"node-download\", type: \"main\" },\n  { id: \"e12\", fromNode: \"node-download\", toNode: \"node-upload\", type: \"main\" },\n  // Vault and Telegram branch from wait\n  { id: \"e13\", fromNode: \"node-wait\", toNode: \"node-append-vault\", type: \"dashed\" },\n  { id: \"e14\", fromNode: \"node-append-vault\", toNode: \"node-telegram-response\", type: \"main\" },\n\n  // Sub-pin connections from bottom of AI Agent\n  { id: \"e-sub-model\", fromNode: \"node-ai-agent\", toNode: \"node-model-gemini-flash\", type: \"subpin\" },\n  { id: \"e-sub-think\", fromNode: \"node-ai-agent\", toNode: \"node-think-prompt\", type: \"subpin\" },\n  { id: \"e-sub-mem\", fromNode: \"node-ai-agent\", toNode: \"node-vault-memory\", type: \"subpin\" },\n  { id: \"e-sub-research\", fromNode: \"node-ai-agent\", toNode: \"node-subagent-research\", type: \"subpin\" },\n\n  // Research tools\n  { id: \"e-res-yt\", fromNode: \"node-subagent-research\", toNode: \"node-tool-youtube\", type: \"dashed\" },\n  { id: \"e-res-tav\", fromNode: \"node-subagent-research\", toNode: \"node-tool-tavily\", type: \"dashed\" }\n];\n"
