          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"CheckCircle\": return <CheckCircle2 className=\"w-4 h-4 text-teal-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Globe\": return <Globe className=\"w-4 h-4 text-emerald-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"TrendingUp\": return <TrendingUp className=\"w-4 h-4 text-green-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \"Repeat\": return <Repeat className=\"w-4 h-4 text-cyan-400\" />;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
