{\n        id: \"node-upload\",\n        name: \"Upload a video\",\n        label: \"Upload a video\",\n        subtitle: \"YouTube Shorts / Postiz API\",\n        category: \"output\",\n        iconName: \"Globe\",\n        x: 2910,\n        y: 180,\n        width: 190,\n        height: 74,\n        status: \"idle\",\n        inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n        freeTierInfo: {\n          tierName: \"YouTube / Postiz API\",\n          quotaLimit: \"Free scheduled posting\",\n          whyChosen: \"Direct upload to YouTube Shorts and multi-social distribution\",\n          apiKeyName: \"POSTIZ_API_KEY\",\n          isConfigured: Boolean(process.env.POSTIZ_API_KEY)\n        }\n      },\n\n      // Sub-Agent Intelligence Pod (Connected from AI Agent)\n      {\n        id: \"node-subagent-research\",\n        name: \"Research Agent\",\n        label: \"Research Agent\",\n        subtitle: \"Trend & Hook Intelligence\",\n        category: \"subagent\",\n        iconName: \"Compass\",\n        x: 1090,\n        y: 430,\n        width: 180,\n        height: 74,\n        status: \"idle\",\n        subPins: { model: true, tools: true }\n      },\n      {\n        id: \"node-tool-youtube\",\n        name: \"YouTube Data API v3\",\n        label: \"YouTube Trends\",\n        subtitle: \"search: viral hooks (10k units)\",\n        category: \"tool\",\n        iconName: \"Video\",\n        x: 1330,\n        y: 430,\n        width: 190,\n        height: 74,\n        status: \"idle\",\n        freeTierInfo: {\n          tierName: \"YouTube Data API v3\",\n          quotaLimit: \"10,000 units/day (~500 searches)\",\n          whyChosen: \"Real competitor view counts & retention metrics\",\n          apiKeyName: \"YOUTUBE_API_KEY\",\n          isConfigured: Boolean(process.env.YOUTUBE_API_KEY)\n        }\n      },\n      {\n        id: \"node-tool-tavily\",\n        name: \"Tavily Search\",\n        label: \"Tavily Search\",\n        subtitle: \"Web 