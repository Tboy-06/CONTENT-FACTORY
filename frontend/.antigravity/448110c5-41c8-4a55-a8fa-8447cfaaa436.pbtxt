        lines {
          text: "    const currStageIdx = PIPELINE_ORDER.indexOf(jobStageKey);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const thisNodeIdx = PIPELINE_ORDER.indexOf(node.id);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
