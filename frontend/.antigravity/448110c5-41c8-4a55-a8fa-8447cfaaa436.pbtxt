  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  LayoutGrid, \n  Zap, \n  Settings, \n  Moon, \n  Sun, \n  Plus, \n  Check, \n  Bot, \n  Database, \n  FileCode, \n  Send,\n  Workflow\n} from \"lucide-react\";\nimport { VaultData } from \"../types\";\n\nexport type NavTabType = \"pipeline\" | \"analytics\" | \"style_guides\" | \"telegram\" | \"code\";\n\ninterface HeaderProps {\n  activeTab: NavTabType;\n  setActiveTab: (tab: NavTabType) => void;\n  vaultData: VaultData | null;\n  onOpenNewJob: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeTab,\n  setActiveTab,\n  vaultData,\n  onOpenNewJob\n}) => {\n  const [showSettingsModal, setShowSettingsModal] = useState(false);\n  const [isDarkMode, setIsDarkMode] = useState(true);\n\n  return (\n    <header className=\"h-14 bg-[#080d1a] border-b border-[#182337] px-4 sm:px-6 flex items-center justify-between text-slate-100 z-40 shrink-0 select-none\">\n      {/* ============================================================ */}\n      {/* LEFT: Grid App Menu & Brand Title (matching screenshot)     */}\n      {/* ============================================================ */}\n      <div className=\"flex items-center gap-3\">\n        {/* 4-Squares Grid App Icon */}\n        <button\n          className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-[#121c2d] transition cursor-pointer\"\n          title=\"App Grid Menu\"\n        >\n          <LayoutGrid className=\"w-5 h-5\" />\n        </button>\n\n        {/* Green Lightning Bolt & Brand Name */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-6 h-6 rounded-md bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400\">\n            <Zap className=\"w-4 h-4 fill-current\" />\n          </div>\n          <span className=\"text-sm font-black tracking-wider uppercase text-white font-sans\">\n            CONTENT-FACTORY\n          </span>\n        </div>\n      </div>\n\n      {/* ============================================================ */}\n      {/* CENTER: n8n Pill Navigation Tabs (matching screenshot)       */}\n      {/* ============================================================ */}\n      <div className=\"hidden sm:flex items-center bg-[#0d1627] border border-[#1b2a41] rounded-xl p-1 text-xs\">\n        <button\n          id=\"nav-pill-pipeline\"\n          onClick={() => setActiveTab(\"pipeline\")}\n          className={`px-4 py-1.5 rounded-lg font-semibold transition cursor-pointer ${\n            activeTab === \"pipeline\"\n              ? \"bg-[#1d2c43] text-white shadow-sm\"\n              : \"text-slate-400 hover:text-slate-200\"\n          }`}\n        >\n          Pipeline\n        </button>\n\n        <button\n          id=\"nav-pill-analytics\"\n          onClick={() => setActiveTab(\"analytics\")}\n          className={`px-4 py-1.5 rounded-lg font-semibold transition cursor-pointer ${\n            activeTab === \"analytics\"\n              ? \"bg-[#1d2c43] text-white shadow-sm\"\n              : \"text-slate-400 hover:text-slate-200\"\n          }`}\n        >\n          Analytics\n        </button>\n\n        <button\n          id=\"nav-pill-style-guides\"\n          onClick={() => setActiveTab(\"style_guides\")}\n          className={`px-4 py-1.5 rounded-lg font-semibold transition cursor-pointer ${\n            activeTab === \"style_guides\"\n              ? \"bg-[#1d2c43] text-white shadow-sm\"\n              : \"text-slate-400 hover:text-slate-200\"\n          }`}\n        >\n          Style Guides\n        </button>\n\n        <button\n          id=\"nav-pill-telegram\"\n          onClick={() => setActiveTab(\"telegram\")}\n          className={`px-4 py-1.5 rounded-lg font-semibold transition cursor-pointer ${\n            activeTab === \"telegram\"\n              ? \"bg-[#1d2c43] text-white shadow-sm\"\n              : \"text-slate-400 hover:text-slate-200\"\n          }`}\n        >\n          Telegram HITL\n        </button>\n\n        <button\n          id=\"nav-pill-code\"\n          onClick={() => setActiveTab(\"code\")}\n          className={`px-4 py-1.5 rounded-lg font-semibold transition cursor-pointer ${\n            activeTab === \"code\"\n              ? \"bg-[#1d2c43] text-white shadow-sm\"\n              : \"text-slate-400 hover:text-slate-200\"\n          }`}\n        >\n          Codebase\n        </button>\n      </div>\n\n      {/* ============================================================ */}\n      {/* RIGHT: Connected Status, Settings & Dark Mode (screenshot)  */}\n      {/* ============================================================ */}\n      <div className=\"flex items-center gap-3\">\n        {/* Connected Status Pill */}\n        <div className=\"flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#10b981]\" />\n          <span className=\"font-semibold\">Connected</span>\n        </div>\n\n        {/* Settings Icon */}\n        <button\n          onClick={() => setShowSettingsModal(true)}\n          className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-[#121c2d] transition cursor-pointer\"\n          title=\"Pipeline Settings\"\n        >\n          <Settings className=\"w-4 h-4\" />\n        </button>\n\n        {/* Moon / Theme Toggle Icon */}\n        <button\n          onClick={() => setIsDarkMode(!isDarkMode)}\n          className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-[#121c2d] transition cursor-pointer\"\n          title=\"Toggle Theme\"\n        >\n          {isDarkMode ? <Moon className=\"w-4 h-4\" /> : <Sun className=\"w-4 h-4 text-amber-400\" />}\n        </button>\n\n        {/* Action button */}\n        <button\n          id=\"header-create-job-btn\"\n          onClick={onOpenNewJob}\n          className=\"hidden md:flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold px-3 py-1.5 rounded-lg transition cursor-pointer shadow-sm\"\n        >\n          <Plus className=\"w-3.5 h-3.5\" />\n          <span>New Job</span>\n        </button>\n      </div>\n\n      {/* Settings Modal */}\n      {showSettingsModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-[#0e1627] border border-[#20324e] rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-[#1c2c43] pb-3\">\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <Settings className=\"w-4 h-4 text-cyan-400\" />\n                Pipeline Orchestrator Settings\n              </h3>\n              <button\n                onClick={() => setShowSettingsModal(false)}\n                className=\"text-slate-400 hover:text-white text-xs font-mono\"\n              >\n                ESC\n              </button>\n            </div>\n\n            <div className=\"space-y-3 text-xs\">\n              <div className=\"flex items-center justify-between p-2.5 rounded-xl bg-[#090f1d] border border-[#19273f]\">\n                <div>\n                  <div className=\"font-semibold text-white\">Daily Budget Limit</div>\n                  <div className=\"text-slate-400 text-[11px]\">Enforce hard cap on API spend</div>\n                </div>\n                <span className=\"font-mono text-emerald-400 font-bold\">$10.00 / day</span>\n              </div>\n\n              <div className=\"flex items-center justify-between p-2.5 rounded-xl bg-[#090f1d] border border-[#19273f]\">\n                <div>\n                  <div className=\"font-semibold text-white\">Telegram HITL Webhook</div>\n                  <div className=\"text-slate-400 text-[11px]\">Instant polling & approvals</div>\n                </div>\n                <span className=\"font-mono text-cyan-400 font-bold\">Enabled</span>\n              </div>\n\n              <div className=\"flex items-center justify-between p-2.5 rounded-xl bg-[#090f1d] border border-[#19273f]\">\n                <div>\n                  <div className=\"font-semibold text-white\">Postiz Auto-Publish</div>\n                  <div className=\"text-slate-400 text-[11px]\">TikTok, Shorts & Reels distribution</div>\n                </div>\n                <span className=\"font-mono text-emerald-400 font-bold\">Ready</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => setShowSettingsModal(false)}\n              className=\"w-full bg-[#1b2b44] hover:bg-[#233858] text-white font-bold text-xs py-2 rounded-xl transition cursor-pointer\"\n            >\n              Close Settings\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
