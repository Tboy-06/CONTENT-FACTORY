  file_change {
    absolute_path_uri: "file:///src/components/N8nWorkflowCanvas.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // Functional summary for node hover tooltips\n  const getNodeFunctionalitySummary = (node: WorkflowNode) => {\n    switch (node.id) {\n      case \"node-trigger\":\n        return \"Manual or Webhook trigger: Launches autonomous multi-agent video production pipeline.\";\n      case \"node-edit-fields\":\n        return \"Configures target niche, 9:16 vertical 1080x1920 constraints, and distribution platforms.\";\n      case \"node-ai-agent\":\n        return \"gemini-3.6-flash Director: Architect of viral 3-act retention loops and structured script JSON.\";\n      case \"node-model-gemini-flash\":\n        return \"Google AI Studio Free Tier (15 RPM / 1,500 RPD): Zero-cost high-speed script generation.\";\n      case \"node-think-prompt\":\n        return \"Director System Prompt: Enforces 0-3s hook, tension build, value reveal, and looping CTA.\";\n      case \"node-vault-memory\":\n        return \"SQLite window buffer: Enforces visual DNA consistency and references viral hook formulas.\";\n      case \"node-json-split\":\n        return \"Payload splitter: Dispatches parallel voice audio generation and visual storyboard prompts.\";\n      case \"node-voice-gen\":\n        return \"Edge-TTS (100% Free): Generates natural neural voice narration (en-US-AriaNeural) with SSML.\";\n      case \"node-image-prompt\":\n        return \"gemini-3.7-flash (10 RPM): Generates 4-shot cinematic storyboard prompts with lens specs.\";\n      case \"node-image-gen\":\n        return \"Pexels API (20,000 req/mo Free): Selects and retrieves 9:16 vertical 1080x1920 stock video cuts.\";\n      case \"node-merge\":\n        return \"Stream synchronization: Aligns narration duration with visual cuts for dynamic pacing.\";\n      case \"node-render-video\":\n        return \"FFmpeg local engine: Encodes 1080x1920 60FPS video, -14 LUFS loudness, and yellow subtitles.\";\n      case \"node-wait\":\n        return \"QC & HITL Gate: Verifies safe-zones, audio clipping, and originality score (98.4%).\";\n      case \"node-download\":\n        return \"Vault Packaging: Archives master MP4, narration MP3, SRT captions, and manifest JSON.\";\n      case \"node-upload\":\n        return \"Social Gateway: Uploads published video directly to YouTube Shorts and social schedules.\";\n      case \"node-subagent-research\":\n        return \"Research Agent: Dispatches YouTube Data API and Tavily search for viral topic intel.\";\n      case \"node-tool-youtube\":\n        return \"YouTube Data API v3 (10k units/day): Evaluates competitor views, retention benchmarks, and tags.\";\n      case \"node-tool-tavily\":\n        return \"Tavily Search: Extracts clean, structured markdown research citations for script writing.\";\n      case \"node-append-vault\":\n        return \"SQLite Vault Logger: Records job metadata, execution metrics, and cost tallies ($0.00).\";\n      case \"node-telegram-response\":\n        return \"Telegram Bot Dispatch: Pushes instant completion alert with direct video preview to mobile.\";\n      default:\n        return `${node.label}: ${node.subtitle || \"Autonomous pipeline component.\"}`;\n    }\n  };\n\n  // Fetch Workflow Graph Spec from backend\n  const fetchWorkflowSpec = async () => {\n    try {\n      const res = await fetch(\"/api/workflow/spec\");\n      if (res.ok) {\n        const data = await res.json();\n        const incomingNodes: WorkflowNode[] = data.workflow?.nodes || [];\n        // If incoming nodes have generous coordinates matching our spec, use them, otherwise use DEFAULT_WORKFLOW_NODES\n        if (incomingNodes.length > 0 && incomingNodes.some(n => n.id === \"node-trigger\" || n.id === \"node-ai-agent\")) {\n          const isCompressed = incomingNodes.some(n => n.id === \"node-edit-fields\" && n.x < 300);\n          if (isCompressed) {\n            setNodes(DEFAULT_WORKFLOW_NODES);\n            setEdges(DEFAULT_WORKFLOW_EDGES);\n          } else {\n            setNodes(incomingNodes);\n            setEdges(data.workflow.edges || DEFAULT_WORKFLOW_EDGES);\n          }\n        } else {\n          setNodes(DEFAULT_WORKFLOW_NODES);\n          setEdges(DEFAULT_WORKFLOW_EDGES);\n        }\n      } else {\n        setNodes(DEFAULT_WORKFLOW_NODES);\n        setEdges(DEFAULT_WORKFLOW_EDGES);\n      }\n    } catch (e) {\n      console.error(\"Failed to load workflow spec:\", e);\n      setNodes(DEFAULT_WORKFLOW_NODES);\n      setEdges(DEFAULT_WORKFLOW_EDGES);\n    } finally {\n      setIsLoadingSpec(false);\n    }\n  };"
      replacement_content: "  // Functional summary for node hover tooltips\n  const getNodeFunctionalitySummary = (node: WorkflowNode) => {\n    switch (node.id) {\n      // Main Top Orchestration Line\n      case \"node-telegram-trigger\":\n        return \"Telegram Bot Webhook: Listens for audio voice notes, text messages, and prompts from Telegram in real-time.\";\n      case \"node-switch-type\":\n        return \"Switch / Content Router: Automatically detects whether incoming payload is voice audio or text message.\";\n      case \"node-download-voice\":\n        return \"Telegram File Downloader: Fetches raw OGG/MP3 voice audio memo payloads using the Telegram Bot API.\";\n      case \"node-transcribe-audio\":\n        return \"Audio Transcriber (Whisper / Gemini): Transcribes spoken voice notes into clean punctuated text scripts.\";\n      case \"node-set-text\":\n        return \"Text State Initializer: Normalizes raw incoming text ideas, topics, and prompt directives into standard fields.\";\n      case \"node-input-prep\":\n        return \"Input Consolidator: Prepares unified structured JSON payload for the Content Factory Manager.\";\n      case \"node-ai-agent\":\n        return \"gemini-3.6-flash Director: Architect of viral 3-act retention loops and structured script JSON.\";\n      case \"node-clean-up\":\n        return \"Clean Up & JSON Formatter: Validates script output, formats subtitles, and prepares metadata rows.\";\n      case \"node-append-vault\":\n        return \"SQLite Vault Database: Appends full job records, script lines, and timestamped runs into vault.db.\";\n      case \"node-telegram-response\":\n        return \"Telegram Bot Sender: Pushes completed MP4 previews and video status back to the user on Telegram.\";\n      case \"node-error-handler\":\n        return \"Error Notification Alert: Catches pipeline failures and dispatches error messages to Telegram.\";\n\n      // Models & Memory\n      case \"node-model-gemini-flash\":\n        return \"Google AI Studio Free Tier (15 RPM / 1,500 RPD): Zero-cost high-speed script generation.\";\n      case \"node-think-prompt\":\n        return \"Director System Prompt: Enforces 0-3s hook, tension build, value reveal, and looping CTA.\";\n      case \"node-vault-memory\":\n        return \"SQLite window buffer: Enforces visual DNA consistency and references viral hook formulas.\";\n\n      // Sub-Agents & Tools\n      case \"node-subagent-research\":\n        return \"Research Agent: Dispatches YouTube Data API and Tavily search for viral topic intel.\";\n      case \"node-tool-youtube\":\n        return \"YouTube Data API v3 (10k units/day): Evaluates competitor views, retention benchmarks, and tags.\";\n      case \"node-tool-tavily\":\n        return \"Tavily Search (1,000/mo Free): Extracts clean, structured markdown research citations for script writing.\";\n      case \"node-tool-firecrawl\":\n        return \"Jina Reader & Firecrawl: URL to markdown converter for deep web article extraction.\";\n      case \"node-subagent-script\":\n        return \"Scriptwriter Agent: Drafts 3-act retention loops, hooks, body value points, and seamless looping CTAs.\";\n      case \"node-tool-hook-vault\":\n        return \"Hook Formulas Vault: 150+ proven viral opening hook structures for maximum viewer retention.\";\n      case \"node-tool-character-bible\":\n        return \"Character Bible: Enforces consistent persona, visual tone, and voice style across all generations.\";\n      case \"node-subagent-art\":\n        return \"Art & Style Director: Generates cinematic storyboard prompts and curates aesthetic color palettes.\";\n      case \"node-model-gemini-37\":\n        return \"gemini-3.7-flash: High-reasoning multimodal model for creative storyboard prompt generation.\";\n      case \"node-tool-pexels\":\n        return \"Pexels API (20,000 req/mo Free): Selects and retrieves 9:16 vertical 1080x1920 stock video cuts.\";\n      case \"node-tool-veo-prompts\":\n        return \"Veo / Flow Pack: Formats 4K cinematic AI video prompts ready for browser or API rendering.\";\n      case \"node-subagent-video\":\n        return \"Video Editor Agent: Directs audio assembly, dynamic subtitle burning, and visual synchronization.\";\n      case \"node-tool-edge-tts\":\n        return \"Microsoft Edge-TTS (100% Free): Generates high-quality neural voice narration with zero API cost.\";\n      case \"node-tool-ffmpeg\":\n        return \"FFmpeg Local Engine: Assembles 1080x1920 60FPS video with dynamic word-by-word subtitles and LUFS audio.\";\n      case \"node-model-gemini-vision\":\n        return \"gemini-2.5-pro Vision: Audits video keyframes to ensure text safe-zones and aesthetic quality.\";\n      case \"node-subagent-qc\":\n        return \"Quality Control Agent: Dual-gate audit verifying originality, loudness compliance, and mobile safe-zones.\";\n      case \"node-tool-qc-audit\":\n        return \"Originality & Audio Check: Enforces -14 LUFS loudness target and >95% content originality score.\";\n      case \"node-tool-telegram-hitl\":\n        return \"Human-in-the-Loop Gate: Sends inline /approve and /reject buttons to Telegram before final publish.\";\n      case \"node-subagent-post\":\n        return \"Poster Agent: Multi-channel scheduler orchestrating YouTube Shorts, Reels, and TikTok distribution.\";\n      case \"node-tool-postiz\":\n        return \"Postiz Self-Hosted API: Automates multi-platform social media posting and scheduled release queues.\";\n      case \"node-subagent-analyst\":\n        return \"Performance Analyst: Measures audience retention metrics and feeds insights back into future scripts.\";\n      case \"node-tool-feedback-loop\":\n        return \"Algorithmic Feedback Loop: Updates viral hook weights and pacing parameters based on engagement.\";\n\n      // Legacy/Fallback node IDs\n      case \"node-trigger\":\n        return \"Manual or Webhook trigger: Launches autonomous multi-agent video production pipeline.\";\n      case \"node-edit-fields\":\n        return \"Configures target niche, 9:16 vertical 1080x1920 constraints, and distribution platforms.\";\n      case \"node-json-split\":\n        return \"Payload splitter: Dispatches parallel voice audio generation and visual storyboard prompts.\";\n      case \"node-voice-gen\":\n        return \"Edge-TTS (100% Free): Generates natural neural voice narration (en-US-AriaNeural) with SSML.\";\n      case \"node-image-prompt\":\n        return \"gemini-3.7-flash (10 RPM): Generates 4-shot cinematic storyboard prompts with lens specs.\";\n      case \"node-image-gen\":\n        return \"Pexels API (20,000 req/mo Free): Selects and retrieves 9:16 vertical 1080x1920 stock video cuts.\";\n      case \"node-merge\":\n        return \"Stream synchronization: Aligns narration duration with visual cuts for dynamic pacing.\";\n      case \"node-render-video\":\n        return \"FFmpeg local engine: Encodes 1080x1920 60FPS video, -14 LUFS loudness, and yellow subtitles.\";\n      case \"node-wait\":\n        return \"QC & HITL Gate: Verifies safe-zones, audio clipping, and originality score (98.4%).\";\n      case \"node-download\":\n        return \"Vault Packaging: Archives master MP4, narration MP3, SRT captions, and manifest JSON.\";\n      case \"node-upload\":\n        return \"Social Gateway: Uploads published video directly to YouTube Shorts and social schedules.\";\n      default:\n        return `${node.label}: ${node.subtitle || \"Autonomous pipeline component.\"}`;\n    }\n  };\n\n  // Fetch Workflow Graph Spec from backend\n  const fetchWorkflowSpec = async () => {\n    try {\n      const res = await fetch(\"/api/workflow/spec\");\n      if (res.ok) {\n        const data = await res.json();\n        const incomingNodes: WorkflowNode[] = data.workflow?.nodes || [];\n        if (incomingNodes.length > 0) {\n          setNodes(incomingNodes);\n          setEdges(data.workflow.edges || DEFAULT_WORKFLOW_EDGES);\n        } else {\n          setNodes(DEFAULT_WORKFLOW_NODES);\n          setEdges(DEFAULT_WORKFLOW_EDGES);\n        }\n      } else {\n        setNodes(DEFAULT_WORKFLOW_NODES);\n        setEdges(DEFAULT_WORKFLOW_EDGES);\n      }\n    } catch (e) {\n      console.error(\"Failed to load workflow spec:\", e);\n      setNodes(DEFAULT_WORKFLOW_NODES);\n      setEdges(DEFAULT_WORKFLOW_EDGES);\n    } finally {\n      setIsLoadingSpec(false);\n    }\n  };"
    }
