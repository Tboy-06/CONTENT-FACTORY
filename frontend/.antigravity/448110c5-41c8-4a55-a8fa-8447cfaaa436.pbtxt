    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport fs from \"fs\";\nimport { createServer as createViteServer } from \"vite\";\nimport dotenv from \"dotenv\";\nimport { GoogleGenAI } from \"@google/genai\";\n\ndotenv.config();\n\nconst PORT = 3000;\n\n// Initialize Gemini Client\nlet geminiClient: GoogleGenAI | null = null;\nfunction getGemini(): GoogleGenAI | null {\n  if (!geminiClient && process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \"MY_GEMINI_API_KEY\") {\n    try {\n      geminiClient = new GoogleGenAI({\n        apiKey: process.env.GEMINI_API_KEY,\n        httpOptions: {\n          headers: {\n            \"User-Agent\": \"aistudio-build\"\n          }\n        }\n      });\n    } catch (e) {\n      console.warn(\"Gemini client initialization notice:\", e);\n    }\n  }\n  return geminiClient;\n}\n\n// In-Memory Vault State (mirrors the backend SQLite database for live UI interaction)\ninterface JobRecord {\n  id: number;\n  niche: string;\n  status: \"PENDING\" | \"IN_PROGRESS\" | \"AWAITING_APPROVAL\" | \"AWAITING_PREMIUM\" | \"COMPLETED\" | \"FAILED\";\n  current_stage: \"IDEA\" | \"RESEARCH\" | \"SCRIPT\" | \"QC1\" | \"STYLE\" | \"ART\" | \"VIDEO\" | \"QC2\" | \"POST\" | \"ANALYZE\";\n  config: Record<string, any>;\n  created_at: string;\n  stages: Array<{\n    id: number;\n    stage: string;\n    output: Record<string, any>;\n    timestamp: string;\n  }>;\n  assets: Array<{\n    id: number;\n    type: \"SCRIPT\" | \"AUDIO\" | \"VIDEO\" | \"IMAGE\";\n    path: string;\n    description: string;\n  }>;\n  approvals: Array<{\n    id: number;\n    stage: string;\n    decision: \"APPROVED\" | \"REJECTED\";\n    timestamp: string;\n    notes?: string;\n  }>;\n  costs: Array<{\n    id: number;\n    agent_name: string;\n    tokens: number;\n    usd_estimate: number;\n    timestamp: string;\n  }>;\n  analytics?: {\n    views: number;\n    likes: number;\n    comments: number;\n    shares: number;\n    retention_rate: number;\n    revenue: number;\n  };\n}\n\nconst STAGES = [\"IDEA\", \"RESEARCH\", \"SCRIPT\", \"QC1\", \"STYLE\", \"ART\", \"VIDEO\", \"QC2\", \"POST\", \"ANALYZE\"] as const;\n\n// Initial preloaded jobs showing complete and in-progress pipelines\nlet jobsStore: JobRecord[] = [\n  {\n    id: 101,\n    niche: \"AI Productivity Hacks\",\n    status: \"AWAITING_APPROVAL\",\n    current_stage: \"SCRIPT\",\n    config: {\n      format: \"9:16 Vertical Video\",\n      target_duration: 38,\n      platforms: [\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"],\n      premium: false\n    },\n    created_at: new Date(Date.now() - 1000 * 60 * 45).toISOString(),\n    stages: [\n      {\n        id: 1,\n        stage: \"IDEA\",\n        output: {\n          niche: \"AI Productivity Hacks\",\n          target_audience: \"Tech professionals, builders, and students wanting to 10x workflow\",\n          core_mission: \"Break the misconception that AI prompt engineering has to be complicated\",\n          hook_angle: \"The 3-Prompt Loop Silicon Valley Engineers Actually Use\",\n          target_duration_seconds: 38,\n          projected_retention_score: 88.5\n        },\n        timestamp: new Date(Date.now() - 1000 * 60 * 40).toISOString()\n      },\n      {\n        id: 2,\n        stage: \"RESEARCH\",\n        output: {\n          top_trends: [\n            { title: \"Stop Asking ChatGPT to Write Essays\", views: \"2.4M\", retention: \"89%\" },\n            { title: \"Automate Your Life With 1 Script\", views: \"1.1M\", retention: \"82%\" }\n          ],\n          selected_angle: \"Reverse Context Prompting: Why 98% of people get hallucinated garbage\",\n          virality_score: 93.4,\n          primary_emotion: \"High Curiosity + Practical Utility\"\n        },\n        timestamp: new Date(Date.now() - 1000 * 60 * 30).toISOString()\n      },\n      {\n        id: 3,\n        stage: \"SCRIPT\",\n        output: {\n          hook: \"Wait\342\200\224if you are still prompting AI like a Google search, you are doing it backwards.\",\n          act_1: \"Most people dump a paragraph and pray. The real pro trick is assigning a cognitive persona first.\",\n          act_2: \"Feed it the exact negative constraints: \'Do not use corporate jargon, buzzwords, or passive voice.\'\",\n          act_3: \"Watch the response transform from generic fluff into senior-staff tier code in 3 seconds flat.\",\n          cta: \"Drop \'PROMPT\' in the comments for our private template library.\",\n          hashtags: [\"#AITools\", \"#ProductivityHack\", \"#TechCareer\", \"#FutureOfWork\", \"#AlgoHack\"]\n        },\n        timestamp: new Date(Date.now() - 1000 * 60 * 20).toISOString()\n      }\n    ],\n    assets: [\n      {\n        id: 1,\n        type: \"SCRIPT\",\n        path: \"vault/scripts/job_101_script.json\",\n        description: \"38-second high-retention script with 3-act tension loop\"\n      }\n    ],\n    approvals: [],\n    costs: [\n      { id: 1, agent_name: \"Manager\", tokens: 180, usd_estimate: 0.0009, timestamp: new Date(Date.now() - 1000 * 60 * 40).toISOString() },\n      { id: 2, agent_name: \"Researcher\", tokens: 340, usd_estimate: 0.0017, timestamp: new Date(Date.now() - 1000 * 60 * 30).toISOString() },\n      { id: 3, agent_name: \"Scriptwriter\", tokens: 490, usd_estimate: 0.0025, timestamp: new Date(Date.now() - 1000 * 60 * 20).toISOString() }\n    ]\n  },\n  {\n    id: 102,\n    niche: \"Stoic Mindset & Focus\",\n    status: \"COMPLETED\",\n    current_stage: \"ANALYZE\",\n    config: {\n      format: \"9:16 Vertical Video\",\n      target_duration: 35,\n      platforms: [\"TikTok\", \"YouTube Shorts\"],\n      premium: true,\n      premium_asset_uploaded: true\n    },\n    created_at: new Date(Date.now() - 1000 * 60 * 180).toISOString(),\n    stages: [\n      { id: 1, stage: \"IDEA\", output: { angle: \"Marcus Aurelius on cognitive overload\" }, timestamp: new Date(Date.now() - 1000 * 60 * 175).toISOString() },\n      { id: 2, stage: \"RESEARCH\", output: { virality: 96.1, audio_trend: \"Tension Synth (118 BPM)\" }, timestamp: new Date(Date.now() - 1000 * 60 * 160).toISOString() },\n      { id: 3, stage: \"SCRIPT\", output: { hook: \"You have power over your mind\342\200\224not outside events.\" }, timestamp: new Date(Date.now() - 1000 * 60 * 145).toISOString() },\n      { id: 4, stage: \"QC1\", output: { passed: true, originality: 99.1 }, timestamp: new Date(Date.now() - 1000 * 60 * 130).toISOString() },\n      { id: 5, stage: \"STYLE\", output: { archetype: \"Monochrome Charcoal & Gold Rim Lighting\", cut_rate: \"1.8s\" }, timestamp: new Date(Date.now() - 1000 * 60 * 120).toISOString() },\n      { id: 6, stage: \"ART\", output: { shot_count: 5, veo_prompts_ready: true }, timestamp: new Date(Date.now() - 1000 * 60 * 105).toISOString() },\n      { id: 7, stage: \"VIDEO\", output: { render: \"1080x1920 60FPS\", engine: \"Veo 3.1 + Edge-TTS + FFmpeg\" }, timestamp: new Date(Date.now() - 1000 * 60 * 90).toISOString() },\n      { id: 8, stage: \"QC2\", output: { av_sync: \"0ms offset\", lufs: -14.1, passed: true }, timestamp: new Date(Date.now() - 1000 * 60 * 75).toISOString() },\n      { id: 9, stage: \"POST\", output: { postiz_id: \"post_77491\", platforms: [\"TikTok\", \"YouTube Shorts\"] }, timestamp: new Date(Date.now() - 1000 * 60 * 60).toISOString() },\n      { id: 10, stage: \"ANALYZE\", output: { viral_score: 95.8, retention_3s: \"93.4%\", final_completion: \"71.2%\" }, timestamp: new Date(Date.now() - 1000 * 60 * 10).toISOString() }\n    ],\n    assets: [\n      { id: 1, type: \"SCRIPT\", path: \"vault/scripts/job_102_script.json\", description: \"Stoic script\" },\n      { id: 2, type: \"AUDIO\", path: \"vault/audio/job_102_voice.mp3\", description: \"Edge-TTS deep narration\" },\n      { id: 3, type: \"IMAGE\", path: \"vault/art/job_102_storyboard.json\", description: \"5-shot Veo prompt pack\" },\n      { id: 4, type: \"VIDEO\", path: \"vault/renders/job_102_master.mp4\", description: \"Final 1080x1920 60fps MP4\" }\n    ],\n    approvals: [\n      { id: 1, stage: \"SCRIPT\", decision: \"APPROVED\", timestamp: new Date(Date.now() - 1000 * 60 * 140).toISOString() },\n      { id: 2, stage: \"QC1\", decision: \"APPROVED\", timestamp: new Date(Date.now() - 1000 * 60 * 125).toISOString() },\n      { id: 3, stage: \"QC2\", decision: \"APPROVED\", timestamp: new Date(Date.now() - 1000 * 60 * 70).toISOString() }\n    ],\n    costs: [\n      { id: 1, agent_name: \"Manager\", tokens: 190, usd_estimate: 0.0009, timestamp: \"\" },\n      { id: 2, agent_name: \"Researcher\", tokens: 410, usd_estimate: 0.0020, timestamp: \"\" },\n      { id: 3, agent_name: \"Scriptwriter\", tokens: 520, usd_estimate: 0.0026, timestamp: \"\" },\n      { id: 4, agent_name: \"StyleAnalyst\", tokens: 280, usd_estimate: 0.0014, timestamp: \"\" },\n      { id: 5, agent_name: \"ArtDirector\", tokens: 620, usd_estimate: 0.0031, timestamp: \"\" },\n      { id: 6, agent_name: \"VideoEditor\", tokens: 150, usd_estimate: 0.0008, timestamp: \"\" },\n      { id: 7, agent_name: \"Poster\", tokens: 80, usd_estimate: 0.0004, timestamp: \"\" },\n      { id: 8, agent_name: \"Analyst\", tokens: 310, usd_estimate: 0.0015, timestamp: \"\" }\n    ],\n    analytics: {\n      views: 184500,\n      likes: 21800,\n      comments: 1340,\n      shares: 3420,\n      retention_rate: 76.4,\n      revenue: 92.25\n    }\n  }\n];\n\nlet vaultExtras = {\n  styleGuides: [\n    {\n      niche: \"AI Productivity Hacks\",\n      archetype: \"Electric Cyan Minimalist Cyberpunk\",\n      primaryColor: \"#0F172A\",\n      accentColor: \"#38BDF8\",\n      typography: \"Syne / Montserrat Bold Uppercase\",\n      cutFrequency: \"Every 1.6 - 2.0s\",\n      music: \"Tension Bass Pulse 118 BPM\"\n    },\n    {\n      niche: \"Stoic Mindset & Focus\",\n      archetype: \"Monochrome Charcoal & Antique Gold\",\n      primaryColor: \"#18181B\",\n      accentColor: \"#F59E0B\",\n      typography: \"Cinzel / Inter Heavy\",\n      cutFrequency: \"Every 2.1s with slow pans\",\n      music: \"Deep Atmospheric Cello & Sub-Bass\"\n    }\n  ],\n  characterBibles: [\n    {\n      niche: \"AI Productivity Hacks\",\n      characterName: \"The Systems Architect\",\n      persona: \"Hyper-focused, confidential, zero-fluff technologist\",\n      visualDescription: \"Matte dark techwear, subtle cyan reflections, sharp direct eye contact\"\n    },\n    {\n      niche: \"Stoic Mindset & Focus\",\n      characterName: \"The Philosopher\",\n      persona: \"Calm, stoic, immovable, measured cadence\",\n      visualDescription: \"Marble statue aesthetic with living gold veins and dramatic rim lighting\"\n    }\n  ],\n  hookFormulas: [\n    { formula: \"Wait\342\200\224if you think you know [Niche], this 1 fact will break your brain.\", score: 94.8, count: 42 },\n    { formula: \"Stop doing [Mistake] in 2026. Here is what top 1% do instead.\", score: 92.4, count: 38 },\n    { formula: \"Did you know that 97% of people get [Concept] completely backwards?\", score: 91.2, count: 29 },\n    { formula: \"I tested 100 different [Methods] so you don\'t have to.\", score: 89.6, count: 18 }\n  ],\n  logs: [\n    { id: 1, time: new Date().toLocaleTimeString(), message: \"System initialized. 9 Agents active. Scheduler running.\" },\n    { id: 2, time: new Date().toLocaleTimeString(), message: \"Telegram HITL Bot connected. Polling for commands.\" }\n  ]\n};\n\nasync function startServer() {\n  const app = express();\n  app.use(express.json());\n\n  // API Routes\n  app.get(\"/api/health\", (req, res) => {\n    res.json({\n      status: \"ok\",\n      service: \"CONTENT-FACTORY\",\n      active_jobs: jobsStore.length,\n      agents_registered: 9,\n      stages_count: 10\n    });\n  });\n\n  // Get all jobs\n  app.get(\"/api/jobs\", (req, res) => {\n    res.json(jobsStore);\n  });\n\n  // Create new job\n  app.post(\"/api/jobs\", async (req, res) => {\n    const { niche, format, platforms, premium } = req.body;\n    const newId = (jobsStore.length > 0 ? Math.max(...jobsStore.map(j => j.id)) : 100) + 1;\n\n    // Optional Gemini call for initial managerial strategic roadmap\n    let managerOutput = {\n      niche: niche || \"General Tech & AI\",\n      target_audience: \"Gen-Z & Millennial builders\",\n      core_mission: `Produce viral high-retention content for ${niche}`,\n      format: format || \"9:16 Vertical Short\",\n      target_duration_seconds: 35,\n      goal_views: 350000\n    };\n\n    const ai = getGemini();\n    if (ai) {\n      try {\n        const geminiRes = await ai.models.generateContent({\n          model: \"gemini-3.8-flash\",\n          contents: `You are the Executive Director of CONTENT-FACTORY. Provide a 2-sentence viral angle and target audience for niche: \"${niche}\".`\n        });\n        if (geminiRes.text) {\n          managerOutput.ai_directive = geminiRes.text;\n        }\n      } catch (e) {\n        console.warn(\"Gemini manager call notice:\", e);\n      }\n    }\n\n    const newJob: JobRecord = {\n      id: newId,\n      niche: niche || \"AI Tech Alpha\",\n      status: \"IN_PROGRESS\",\n      current_stage: \"IDEA\",\n      config: {\n        format: format || \"9:16 Vertical Video\",\n        platforms: platforms || [\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"],\n        premium: Boolean(premium)\n      },\n      created_at: new Date().toISOString(),\n      stages: [\n        {\n          id: 1,\n          stage: \"IDEA\",\n          output: managerOutput,\n          timestamp: new Date().toISOString()\n        }\n      ],\n      assets: [],\n      approvals: [],\n      costs: [\n        {\n          id: 1,\n          agent_name: \"Manager\",\n          tokens: 140,\n          usd_estimate: 0.0007,\n          timestamp: new Date().toISOString()\n        }\n      ]\n    };\n\n    jobsStore.unshift(newJob);\n    vaultExtras.logs.unshift({\n      id: Date.now(),\n      time: new Date().toLocaleTimeString(),\n      message: `Created Job #${newId} (${newJob.niche}) via ManagerAgent.`\n    });\n\n    res.json(newJob);\n  });\n\n  // Get job detail\n  app.get(\"/api/jobs/:id\", (req, res) => {\n    const job = jobsStore.find(j => j.id === parseInt(req.params.id));\n    if (!job) return res.status(404).json({ error: \"Job not found\" });\n    res.json(job);\n  });\n\n  // Advance stage for a job (autonomous agent execution)\n  app.post(\"/api/jobs/:id/advance\", async (req, res) => {\n    const job = jobsStore.find(j => j.id === parseInt(req.params.id));\n    if (!job) return res.status(404).json({ error: \"Job not found\" });\n\n    // Check approval gates\n    if (job.status === \"AWAITING_APPROVAL\") {\n      return res.status(400).json({ error: `Job is waiting for human approval at stage ${job.current_stage}. Use Telegram /approve or the approval button.` });\n    }\n\n    const currIdx = STAGES.indexOf(job.current_stage);\n    if (currIdx === STAGES.length - 1 || job.status === \"COMPLETED\") {\n      return res.json({ message: \"Job is already completed\", job });\n    }\n\n    const nextStage = STAGES[currIdx + 1];\n    const ai = getGemini();\n    let stageOutput: Record<string, any> = {};\n    let tokensUsed = 150;\n    let costEst = 0.001;\n\n    // Execute agent logic based on nextStage\n    switch (nextStage) {\n      case \"RESEARCH\": {\n        let aiInsight = `Trending viral hooks in ${job.niche} focus on counter-intuitive truths.`;\n        if (ai) {\n          try {\n            const resp = await ai.models.generateContent({\n              model: \"gemini-3.8-flash\",\n              contents: `Synthesize 2 high-retention trending topics and an audience retention hook for short-form video in niche: ${job.niche}.`\n            });\n            if (resp.text) aiInsight = resp.text;\n          } catch (e) { console.warn(\"Gemini research call notice:\", e); }\n        }\n        stageOutput = {\n          agent: \"Researcher\",\n          virality_score: 92.4,\n          competitor_benchmarks: [\n            { title: `The 3 Biggest Lies About ${job.niche}`, views: \"1.9M\", retention: \"84%\" },\n            { title: `How to Master ${job.niche} in 60 Seconds`, views: \"850K\", retention: \"79%\" }\n          ],\n          selected_angle: `Why 90% of creators fail at ${job.niche}`,\n          insights: aiInsight\n        };\n        tokensUsed = 320;\n        costEst = 0.0016;\n        break;\n      }\n\n      case \"SCRIPT\": {\n        let generatedScript = `Hook: Stop making this mistake with ${job.niche}.\\nAct 1: Most people think it takes months.\\nAct 2: Here is the framework that cuts learning time in half.\\nAct 3: Apply this today and watch results compound.\\nCTA: Follow for daily high-signal breakdowns.`;\n        if (ai) {\n          try {\n            const resp = await ai.models.generateContent({\n              model: \"gemini-3.8-flash\",\n              contents: `Write an intense 35-second vertical video script for ${job.niche}. Structure: 3-second hook, Act 1 curiosity, Act 2 value reveal, Act 3 CTA. Include hashtags.`\n            });\n            if (resp.text) generatedScript = resp.text;\n          } catch (e) { console.warn(\"Gemini script call notice:\", e); }\n        }\n        stageOutput = {\n          agent: \"Scriptwriter\",\n          hook: `Wait\342\200\224if you want to dominate ${job.niche}, do not skip this 1 rule.`,\n          full_script: generatedScript,\n          hashtags: [`#${job.niche.replace(/\\s+/g, \'\')}`, \"#ViralHacks\", \"#Growth\", \"#Trending\"],\n          duration_est_sec: 34\n        };\n        job.assets.push({\n          id: Date.now(),\n          type: \"SCRIPT\",\n          path: `vault/scripts/job_${job.id}_script.json`,\n          description: \"Full production script\"\n        });\n        tokensUsed = 480;\n        costEst = 0.0024;\n        break;\n      }\n\n      case \"QC1\": {\n        stageOutput = {\n          agent: \"QualityControl\",\n          originality_score: 98.4,\n          policy_compliance: true,\n          retention_risk_check: \"Low risk. Hook verified.\",\n          recommendation: \"Approved for Visual DNA & Art Direction.\"\n        };\n        tokensUsed = 120;\n        costEst = 0.0006;\n        break;\n      }\n\n      case \"STYLE\": {\n        stageOutput = {\n          agent: \"StyleAnalyst\",\n          archetype: \"Cinematic High-Contrast Tech Noir\",\n          palette: [\"#0B0F19\", \"#0284C7\", \"#38BDF8\", \"#F59E0B\"],\n          cut_pacing_sec: 1.8,\n          caption_style: \"Dynamic animated word-by-word with yellow highlight\",\n          bg_music: \"118 BPM Synthwave Tension\"\n        };\n        tokensUsed = 210;\n        costEst = 0.0011;\n        break;\n      }\n\n      case \"ART\": {\n        stageOutput = {\n          agent: \"ArtDirector\",\n          veo_prompts: [\n            `Shot 1: Extreme close up holographic interface detailing ${job.niche}, 9:16 vertical, photorealistic 8K volumetric lighting`,\n            `Shot 2: Wide cinematic view modern workspace, neon cyan data stream overlays`,\n            `Shot 3: Split screen dramatic comparison, failure vs success state`,\n            `Shot 4: Dynamic camera push-in on glowing futuristic follow badge`\n          ],\n          character_bible: {\n            archetype: \"The Senior Strategist\",\n            tone: \"Authoritative, confident, direct\"\n          }\n        };\n        job.assets.push({\n          id: Date.now(),\n          type: \"IMAGE\",\n          path: `vault/art/job_${job.id}_storyboard.json`,\n          description: \"4-shot Veo prompt pack & storyboard\"\n        });\n        tokensUsed = 390;\n        costEst = 0.0019;\n        break;\n      }\n\n      case \"VIDEO\": {\n        if (job.config.premium && !job.config.premium_asset_uploaded) {\n          job.status = \"AWAITING_PREMIUM\";\n          job.current_stage = \"VIDEO\";\n          vaultExtras.logs.unshift({\n            id: Date.now(),\n            time: new Date().toLocaleTimeString(),\n            message: `Job #${job.id} escalated to AWAITING_PREMIUM. Upload Veo/Flow asset via Telegram /upload_premium.`\n          });\n          return res.json({ job, notice: \"Escalated to human for premium video render.\" });\n        }\n        stageOutput = {\n          agent: \"VideoEditor\",\n          video_url: `/vault/renders/job_${job.id}_master.mp4`,\n          audio_url: `/vault/audio/job_${job.id}_narration.mp3`,\n          resolution: \"1080x1920\",\n          fps: 60,\n          pacing_score: 97.2,\n          engine: job.config.premium_asset_uploaded ? \"Veo 3.1 + Edge-TTS + FFmpeg Complex\" : \"Edge-TTS + Stock B-Roll + FFmpeg\"\n        };\n        job.assets.push({\n          id: Date.now(),\n          type: \"VIDEO\",\n          path: `vault/renders/job_${job.id}_master.mp4`,\n          description: \"Final assembled 1080x1920 60FPS video\"\n        });\n        tokensUsed = 140;\n        costEst = 0.0007;\n        break;\n      }\n\n      case \"QC2\": {\n        stageOutput = {\n          agent: \"QualityControl\",\n          av_sync_offset_ms: 0,\n          loudness_lufs: -14.0,\n          safe_zone_audit: \"100% compliant (no text in UI margins)\",\n          final_verdict: \"PASSED. Ready for social dispatch.\"\n        };\n        tokensUsed = 100;\n        costEst = 0.0005;\n        break;\n      }\n\n      case \"POST\": {\n        stageOutput = {\n          agent: \"Poster\",\n          postiz_id: `postiz_${Date.now().toString().slice(-6)}`,\n          platforms: job.config.platforms || [\"TikTok\", \"Instagram Reels\", \"YouTube Shorts\"],\n          status: \"Published / Scheduled for Peak Traffic\",\n          public_links: [\n            `https://tiktok.com/@contentfactory/video/${job.id}`,\n            `https://youtube.com/shorts/${job.id}`\n          ]\n        };\n        tokensUsed = 50;\n        costEst = 0.0002;\n        break;\n      }\n\n      case \"ANALYZE\": {\n        const views = Math.floor(Math.random() * 150000) + 50000;\n        const likes = Math.floor(views * 0.11);\n        const comments = Math.floor(views * 0.008);\n        const shares = Math.floor(views * 0.02);\n        const retention = 78.4;\n        const rev = +(views * 0.00045).toFixed(2);\n\n        job.analytics = {\n          views,\n          likes,\n          comments,\n          shares,\n          retention_rate: retention,\n          revenue: rev\n        };\n\n        stageOutput = {\n          agent: \"Analyst\",\n          performance: job.analytics,\n          viral_score: 94.6,\n          learnings: \"High retention past 3-second hook (+18% above median). Recommend duplicating template.\"\n        };\n        tokensUsed = 240;\n        costEst = 0.0012;\n        break;\n      }\n    }\n\n    // Update job state\n    job.current_stage = nextStage;\n    job.stages.push({\n      id: job.stages.length + 1,\n      stage: nextStage,\n      output: stageOutput,\n      timestamp: new Date().toISOString()\n    });\n\n    job.costs.push({\n      id: job.costs.length + 1,\n      agent_name: stageOutput.agent || \"Agent\",\n      tokens: tokensUsed,\n      usd_estimate: costEst,\n      timestamp: new Date().toISOString()\n    });\n\n    // Check if next stage requires approval\n    if ([\"SCRIPT\", \"QC1\", \"QC2\"].includes(nextStage)) {\n      job.status = \"AWAITING_APPROVAL\";\n      vaultExtras.logs.unshift({\n        id: Date.now(),\n        time: new Date().toLocaleTimeString(),\n        message: `Job #${job.id} reached ${nextStage}. Paused for Telegram HITL approval.`\n      });\n    } else if (nextStage === \"ANALYZE\") {\n      job.status = \"COMPLETED\";\n      vaultExtras.logs.unshift({\n        id: Date.now(),\n        time: new Date().toLocaleTimeString(),\n        message: `Job #${job.id} successfully completed entire 10-stage pipeline!`\n      });\n    } else {\n      job.status = \"IN_PROGRESS\";\n    }\n\n    res.json(job);\n  });\n\n  // Approve stage (HITL)\n  app.post(\"/api/jobs/:id/approve\", (req, res) => {\n    const job = jobsStore.find(j => j.id === parseInt(req.params.id));\n    if (!job) return res.status(404).json({ error: \"Job not found\" });\n\n    job.approvals.push({\n      id: job.approvals.length + 1,\n      stage: job.current_stage,\n      decision: \"APPROVED\",\n      timestamp: new Date().toISOString(),\n      notes: req.body.notes || \"Approved via HITL Console\"\n    });\n\n    job.status = \"IN_PROGRESS\";\n    vaultExtras.logs.unshift({\n      id: Date.now(),\n      time: new Date().toLocaleTimeString(),\n      message: `Approved stage ${job.current_stage} for Job #${job.id}. Resuming pipeline.`\n    });\n\n    res.json(job);\n  });\n\n  // Reject stage (HITL)\n  app.post(\"/api/jobs/:id/reject\", (req, res) => {\n    const job = jobsStore.find(j => j.id === parseInt(req.params.id));\n    if (!job) return res.status(404).json({ error: \"Job not found\" });\n\n    const reason = req.body.reason || \"Revision requested\";\n    job.approvals.push({\n      id: job.approvals.length + 1,\n      stage: job.current_stage,\n      decision: \"REJECTED\",\n      timestamp: new Date().toISOString(),\n      notes: reason\n    });\n\n    job.status = \"PENDING\";\n    vaultExtras.logs.unshift({\n      id: Date.now(),\n      time: new Date().toLocaleTimeString(),\n      message: `Rejected stage ${job.current_stage} on Job #${job.id}: ${reason}`\n    });\n\n    res.json(job);\n  });\n\n  // Upload / attach premium asset\n  app.post(\"/api/jobs/:id/upload-premium\", (req, res) => {\n    const job = jobsStore.find(j => j.id === parseInt(req.params.id));\n    if (!job) return res.status(404).json({ error: \"Job not found\" });\n\n    job.config.premium_asset_uploaded = true;\n    job.status = \"IN_PROGRESS\";\n    job.assets.push({\n      id: Date.now(),\n      type: \"VIDEO\",\n      path: `vault/premium/job_${job.id}_custom_veo_4k.mp4`,\n      description: \"Custom Veo 3.1 4K 60FPS Video Asset\"\n    });\n\n    vaultExtras.logs.unshift({\n      id: Date.now(),\n      time: new Date().toLocaleTimeString(),\n      message: `Attached custom 4K Veo asset to Job #${job.id}. Advancing to QC2.`\n    });\n\n    res.json(job);\n  });\n\n  // Vault data endpoint\n  app.get(\"/api/vault\", (req, res) => {\n    const totalSpent = jobsStore.reduce((acc, j) => acc + j.costs.reduce((cAcc, c) => cAcc + c.usd_estimate, 0), 0);\n    const totalTokens = jobsStore.reduce((acc, j) => acc + j.costs.reduce((cAcc, c) => cAcc + c.tokens, 0), 0);\n    const totalRev = jobsStore.reduce((acc, j) => acc + (j.analytics?.revenue || 0), 0);\n\n    res.json({\n      metrics: {\n        totalSpent: +totalSpent.toFixed(4),\n        totalTokens,\n        totalRevenue: +totalRev.toFixed(2),\n        dailyBudget: 5.0,\n        activeJobsCount: jobsStore.filter(j => j.status !== \"COMPLETED\").length,\n        completedJobsCount: jobsStore.filter(j => j.status === \"COMPLETED\").length\n      },\n      styleGuides: vaultExtras.styleGuides,\n      characterBibles: vaultExtras.characterBibles,\n      hookFormulas: vaultExtras.hookFormulas,\n      logs: vaultExtras.logs.slice(0, 30)\n    });\n  });\n\n  // Telegram bot interactive command emulator (all 14 commands)\n  app.post(\"/api/telegram/command\", async (req, res) => {\n    const raw = (req.body.command || \"\").trim();\n    const parts = raw.split(\" \");\n    const cmd = parts[0].toLowerCase();\n    const args = parts.slice(1);\n\n    let output = \"\";\n\n    switch (cmd) {\n      case \"/start\":\n      case \"/help\":\n        output = `\360\237\244\226 CONTENT-FACTORY HITL Bot Online\\n\\nCommands:\\n\342\200\242 /goal <niche> - Create new pipeline job\\n\342\200\242 /status - View all pipeline jobs\\n\342\200\242 /pending - View jobs waiting for approval\\n\342\200\242 /approve <id> - Approve job stage\\n\342\200\242 /reject <id> <reason> - Reject stage\\n\342\200\242 /variants <id> - Generate hook variants\\n\342\200\242 /preview <id> - Inspect generated assets\\n\342\200\242 /premium <id> - Enable premium Veo mode\\n\342\200\242 /upload_premium <id> - Attach 4K Veo render\\n\342\200\242 /post <id> - Post to TikTok, IG Reels, YT Shorts\\n\342\200\242 /analyze <id> - View virality metrics\\n\342\200\242 /cost - Real-time token spend & budget\\n\342\200\242 /report - Executive summary`;\n        break;\n\n      case \"/goal\": {\n        const niche = args.join(\" \") || \"AI Tech Alpha\";\n        const newId = (jobsStore.length > 0 ? Math.max(...jobsStore.map(j => j.id)) : 100) + 1;\n        const newJob: JobRecord = {\n          id: newId,\n          niche,\n          status: \"IN_PROGRESS\",\n          current_stage: \"IDEA\",\n          config: { format: \"9:16 Vertical Video\", platforms: [\"TikTok\", \"Reels\", \"Shorts\"], premium: false },\n          created_at: new Date().toISOString(),\n          stages: [{ id: 1, stage: \"IDEA\", output: { niche, target_views: 350000 }, timestamp: new Date().toISOString() }],\n          assets: [],\n          approvals: [],\n          costs: [{ id: 1, agent_name: \"Manager\", tokens: 140, usd_estimate: 0.0007, timestamp: new Date().toISOString() }]\n        };\n        jobsStore.unshift(newJob);\n        output = `\360\237\216\257 Job #${newId} created for niche: \"${niche}\". ManagerAgent started stage IDEA.`;\n        break;\n      }\n\n      case \"/status\": {\n        if (jobsStore.length === 0) {\n          output = \"No jobs currently in pipeline.\";\n        } else {\n          output = `\360\237\223\212 Active Jobs (${jobsStore.length}):\\n` + jobsStore.map(j => `\342\200\242 #${j.id} [${j.status}] ${j.niche} (Stage: ${j.current_stage})`).join(\"\\n\");\n        }\n        break;\n      }\n\n      case \"/pending\": {\n        const pending = jobsStore.filter(j => j.status === \"AWAITING_APPROVAL\" || j.status === \"AWAITING_PREMIUM\");\n        if (pending.length === 0) {\n          output = \"\342\234\205 No jobs currently awaiting human approval.\";\n        } else {\n          output = `\342\217\263 Awaiting Human Approval (${pending.length}):\\n` + pending.map(j => `\342\200\242 #${j.id} \"${j.niche}\" at stage ${j.current_stage} [${j.status}]`).join(\"\\n\");\n        }\n        break;\n      }\n\n      case \"/approve\": {\n        const id = parseInt(args[0]);\n        const job = jobsStore.find(j => j.id === id);\n        if (!job) {\n          output = `Job #${id} not found. Usage: /approve <job_id>`;\n        } else {\n          job.approvals.push({ id: Date.now(), stage: job.current_stage, decision: \"APPROVED\", timestamp: new Date().toISOString() });\n          job.status = \"IN_PROGRESS\";\n          output = `\342\234\205 Job #${id} approved at stage ${job.current_stage}. Autonomous pipeline resumed.`;\n        }\n        break;\n      }\n\n      case \"/reject\": {\n        const id = parseInt(args[0]);\n        const reason = args.slice(1).join(\" \") || \"Revision requested\";\n        const job = jobsStore.find(j => j.id === id);\n        if (!job) {\n          output = `Job #${id} not found. Usage: /reject <job_id> <reason>`;\n        } else {\n          job.approvals.push({ id: Date.now(), stage: job.current_stage, decision: \"REJECTED\", timestamp: new Date().toISOString(), notes: reason });\n          job.status = \"PENDING\";\n          output = `\342\235\214 Job #${id} stage ${job.current_stage} rejected. Reason: \"${reason}\". Regeneration initiated.`;\n        }\n        break;\n      }\n\n      case \"/variants\": {\n        const id = parseInt(args[0]);\n        output = `\360\237\223\235 Script Variants for Job #${id || 101}:\\n1. Contrarian: \"Stop prompting AI like a search engine\342\200\224it\'s destroying your output.\"\\n2. Curiosity Loop: \"The secret negative constraint Silicon Valley engineers never post publicly.\"\\n3. High-Stakes: \"If your AI scripts sound generic, you missed this 1 fundamental rule.\"`;\n        break;\n      }\n\n      case \"/preview\": {\n        const id = parseInt(args[0]);\n        const job = jobsStore.find(j => j.id === id);\n        if (!job) {\n          output = `Job #${id} not found.`;\n        } else {\n          output = `\360\237\221\201\357\270\217 Preview Job #${job.id} (${job.niche}):\\n\342\200\242 Current Stage: ${job.current_stage}\\n\342\200\242 Registered Assets: ${job.assets.map(a => a.type).join(\", \") || \"None yet\"}`;\n        }\n        break;\n      }\n\n      case \"/premium\": {\n        const id = parseInt(args[0]);\n        const job = jobsStore.find(j => j.id === id);\n        if (!job) {\n          output = `Job #${id} not found.`;\n        } else {\n          job.config.premium = true;\n          output = `\360\237\214\237 Premium Veo 3.1 4K Mode enabled for Job #${id}. VideoEditor will flag AWAITING_PREMIUM.`;\n        }\n        break;\n      }\n\n      case \"/upload_premium\": {\n        const id = parseInt(args[0]);\n        const job = jobsStore.find(j => j.id === id);\n        if (!job) {\n          output = `Job #${id} not found.`;\n        } else {\n          job.config.premium_asset_uploaded = true;\n          job.status = \"IN_PROGRESS\";\n          job.assets.push({ id: Date.now(), type: \"VIDEO\", path: `vault/premium/job_${id}_veo_4k.mp4`, description: \"4K Veo render\" });\n          output = `\360\237\216\254 Premium Veo asset attached to Job #${id}. Resuming video synthesis pipeline.`;\n        }\n        break;\n      }\n\n      case \"/post\": {\n        const id = parseInt(args[0]);\n        output = `\360\237\232\200 Job #${id || 101} dispatched to Postiz for distribution across TikTok, Instagram Reels, and YouTube Shorts.`;\n        break;\n      }\n\n      case \"/analyze\": {\n        const id = parseInt(args[0]);\n        const job = jobsStore.find(j => j.id === id);\n        if (job && job.analytics) {\n          output = `\360\237\223\210 Performance for Job #${id}:\\n\342\200\242 Views: ${job.analytics.views.toLocaleString()}\\n\342\200\242 Likes: ${job.analytics.likes.toLocaleString()}\\n\342\200\242 Retention: ${job.analytics.retention_rate}%\\n\342\200\242 Creator Rewards: $${job.analytics.revenue.toFixed(2)}`;\n        } else {\n          output = `\360\237\223\210 Estimated projections for Job #${id || 101}:\\n\342\200\242 Views: 128,400\\n\342\200\242 Retention: 78.4%\\n\342\200\242 Virality Score: 93.8/100`;\n        }\n        break;\n      }\n\n      case \"/cost\": {\n        const totalSpent = jobsStore.reduce((acc, j) => acc + j.costs.reduce((cAcc, c) => cAcc + c.usd_estimate, 0), 0);\n        const totalTokens = jobsStore.reduce((acc, j) => acc + j.costs.reduce((cAcc, c) => cAcc + c.tokens, 0), 0);\n        const budget = 5.0;\n        output = `\360\237\222\260 Budget & Cost Ledger:\\n\342\200\242 Total Spent: $${totalSpent.toFixed(4)} USD\\n\342\200\242 Tokens Consumed: ${totalTokens.toLocaleString()}\\n\342\200\242 Daily Budget: $${budget.toFixed(2)} USD\\n\342\200\242 Budget Status: \360\237\237\242 Healthy (${((totalSpent / budget) * 100).toFixed(1)}% utilized)`;\n        break;\n      }\n\n      case \"/report\": {\n        const totalSpent = jobsStore.reduce((acc, j) => acc + j.costs.reduce((cAcc, c) => cAcc + c.usd_estimate, 0), 0);\n        output = `\360\237\223\213 CONTENT-FACTORY Executive Summary:\\n\342\200\242 Total Pipelines: ${jobsStore.length}\\n\342\200\242 Completed: ${jobsStore.filter(j => j.status === \'COMPLETED\').length}\\n\342\200\242 Active: ${jobsStore.filter(j => j.status !== \'COMPLETED\').length}\\n\342\200\242 Spent: $${totalSpent.toFixed(4)} / $5.00 USD\\n\342\200\242 All 9 Agents Operational`;\n        break;\n      }\n\n      default:\n        output = `Unknown command: ${cmd}. Type /help for list of available commands.`;\n    }\n\n    res.json({ command: raw, response: output });\n  });\n\n  // Project codebase files explorer endpoint (lets the user inspect all generated python files and specs)\n  app.get(\"/api/code-files\", (req, res) => {\n    const fileList = [\n      { name: \"backend/config.py\", path: \"backend/config.py\", desc: \"Pydantic Settings & environment credentials\" },\n      { name: \"backend/vault/models.py\", path: \"backend/vault/models.py\", desc: \"13 SQLAlchemy 2.0 async database models\" },\n      { name: \"backend/vault/repository.py\", path: \"backend/vault/repository.py\", desc: \"40+ async CRUD database operations\" },\n      { name: \"backend/agents/base.py\", path: \"backend/agents/base.py\", desc: \"BaseAgent class with token & cost tracker\" },\n      { name: \"backend/agents/llm_client.py\", path: \"backend/agents/llm_client.py\", desc: \"Gemini singleton with Tenacity exponential retry\" },\n      { name: \"backend/agents/implementations.py\", path: \"backend/agents/implementations.py\", desc: \"9 Agent implementations across 10 stages\" },\n      { name: \"backend/scheduler/__init__.py\", path: \"backend/scheduler/__init__.py\", desc: \"APScheduler with 5 interval/cron jobs\" },\n      { name: \"backend/telegram_bot/bot.py\", path: \"backend/telegram_bot/bot.py\", desc: \"Telegram bot with 14 HITL commands\" },\n      { name: \"dashboard/main.py\", path: \"dashboard/main.py\", desc: \"FastAPI web dashboard routes\" },\n      { name: \"run_backend.py\", path: \"run_backend.py\", desc: \"Uvicorn lifespan runner with graceful shutdown\" },\n      { name: \"requirements.txt\", path: \"requirements.txt\", desc: \"All Python production dependencies\" },\n      { name: \"docker-compose.yml\", path: \"docker-compose.yml\", desc: \"Postiz, Postgres, Redis deployment stack\" },\n      { name: \"PROJECT_SPEC.md\", path: \"PROJECT_SPEC.md\", desc: \"Full architectural specification\" },\n      { name: \"TECHNICAL_SPEC.md\", path: \"TECHNICAL_SPEC.md\", desc: \"Technical implementation guide\" },\n      { name: \"README.md\", path: \"README.md\", desc: \"Quick-start and setup instructions\" }\n    ];\n\n    const results = fileList.map(item => {\n      try {\n        const fullPath = path.join(process.cwd(), item.path);\n        if (fs.existsSync(fullPath)) {\n          return {\n            ...item,\n            content: fs.readFileSync(fullPath, \"utf-8\"),\n            exists: true\n          };\n        }\n      } catch (e) {\n        console.warn(`Could not read ${item.path}:`, e);\n      }\n      return { ...item, content: \"\", exists: false };\n    });\n\n    res.json(results);\n  });\n\n  // Vite middleware setup\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\"\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`CONTENT-FACTORY Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
