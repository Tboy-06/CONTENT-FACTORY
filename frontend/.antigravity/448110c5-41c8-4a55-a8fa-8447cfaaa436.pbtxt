        replacement_content: "    res.json(results);\n  });\n\n  // ============================================================\n  // WORKFLOW & TOOL EXECUTION REAL API ENDPOINTS\n  // ============================================================\n\n  // Get Free Tier Reference specification\n  app.get(\"/api/free-tier-reference\", (req, res) => {\n    res.json(FREE_TIER_REFERENCE);\n  });\n\n  // Get Workflow Graph Specification (Nodes, Edges, Sub-pins matching n8n architecture)\n  app.get(\"/api/workflow/spec\", (req, res) => {\n    // Defines the full node topology shown in Build powerful AI systems fast with n8n!.jfif\n    const nodes = [\n      // Top Main Orchestration Line\n      {\n        id: \"node-telegram-trigger\",\n        name: \"Telegram Trigger\",\n        label: \"Telegram Trigger\",\n        subtitle: \"updates: message\",\n        category: \"trigger\",\n        iconName: \"Send\",\n        x: 60,\n        y: 120,\n        status: \"idle\",\n        outputs: [{ id: \"out-main\", label: \"\", type: \"main\" }],\n        freeTierInfo: {\n          tierName: \"Telegram Bot API\",\n          quotaLimit: \"Unlimited (Free long-polling / webhook)\",\n          whyChosen: \"Push notifications, inline keyboards, zero hosting cost\",\n          apiKeyName: \"TELEGRAM_BOT_TOKEN\",\n          isConfigured: Boolean(process.env.TELEGRAM_BOT_TOKEN && process.env.TELEGRAM_BOT_TOKEN !== \"your_telegram_token\")\n        }\n      },\n      {\n        id: \"node-switch-type\",\n        name: \"Switch\",\n        label: \"Switch\",\n        subtitle: \"mode: Rules\",\n        category: \"routing\",\n        iconName: \"GitFork\",\n        x: 240,\n        y: 120,\n        status: \"idle\",\n        inputs: [{ id: \"in-main\", label: \"\", type: \"main\" }],\n        outputs: [\n          { id: \"out-voice\", label: \"Voice\", type: \"main\" },\n          { id: \"out-text\", label: \"Text\", type: \"main\" }\n        ]\n      },\n      {\n        id: \"node-download