    instruction: "Apply Bento Grid styling to AgentsStudio.tsx"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Overview Card */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2\">\n              <Bot className=\"w-4 h-4 text-cyan-400\" />\n              9 Autonomous Production Agents & Integrated Tools\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Each specialized agent operates autonomously with dedicated LLM prompts, input/output schemas, and toolchains.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 text-xs\">\n            <span className=\"px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-mono\">\n              9 Agents Active\n            </span>\n            <span className=\"px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono\">\n              Server-Side Only\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Agents Grid & Detail View */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left: Agent Selection List */}\n        <div className=\"lg:col-span-5 space-y-2.5\">\n          {AGENTS.map((agent) => {\n            const isSelected = selectedAgent.id === agent.id;\n            return (\n              <div\n                key={agent.id}\n                onClick={() => setSelectedAgent(agent)}\n                className={`p-3.5 rounded-xl border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"border-cyan-500 bg-cyan-950/30 shadow-md shadow-cyan-500/10\"\n                    : \"border-slate-800/80 bg-slate-900/50 hover:border-slate-700 hover:bg-slate-800/40\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div className=\"w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-cyan-400 font-bold text-xs\">\n                      {agent.name.slice(0, 2)}\n                    </div>\n                    <div>\n                      <h4 className=\"font-bold text-xs text-white\">{agent.name}</h4>\n                      <p className=\"text-[11px] text-slate-400\">{agent.role}</p>\n                    </div>\n                  </div>\n                  <span className=\"text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-800 text-cyan-300\">\n                    {agent.model}\n                  </span>\n                </div>\n                <div className=\"flex items-center gap-2 mt-2 text-[10px] text-slate-500\">\n                  <span>{agent.phase}</span>\n                  <span>\342\200\242</span>\n                  <span>{agent.tools.length} Tools</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right: Selected Agent Deep Dive */}\n        <div className=\"lg:col-span-7 space-y-5\">\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-5\">\n            <div className=\"flex items-start justify-between border-b border-slate-800/80 pb-4\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"text-base font-extrabold text-white\">{selectedAgent.name}</h3>\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\">\n                    {selectedAgent.phase}\n                  </span>\n                </div>\n                <p className=\"text-xs text-cyan-400 font-medium mt-0.5\">{selectedAgent.role}</p>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-[10px] text-slate-400 block font-mono\">PRIMARY ENGINE</span>\n                <span className=\"text-xs font-bold text-emerald-400 font-mono\">{selectedAgent.model}</span>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-300 leading-relaxed\">\n              {selectedAgent.description}\n            </p>\n\n            {/* Tools Integrated */}\n            <div>\n              <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <Wrench className=\"w-3.5 h-3.5 text-cyan-400\" />\n                Integrated Tools & External APIs\n              </h4>\n              <div className=\"flex flex-wrap gap-2\">\n                {selectedAgent.tools.map((tool, ti) => (\n                  <span key={ti} className=\"text-xs px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-slate-200 font-mono\">\n                    {tool}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            {/* Input / Output Contracts */}\n            <div className=\"space-y-3 pt-2\">\n              <div>\n                <span className=\"text-[11px] font-mono text-slate-400 block mb-1\">INPUT SCHEMA CONTRACT</span>\n                <pre className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-cyan-300 overflow-x-auto\">\n                  {selectedAgent.inputFormat}\n                </pre>\n              </div>\n              <div>\n                <span className=\"text-[11px] font-mono text-slate-400 block mb-1\">OUTPUT PAYLOAD CONTRACT</span>\n                <pre className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-emerald-300 overflow-x-auto\">\n                  {selectedAgent.outputFormat}\n                </pre>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>"
        replacement_content: "      {/* Overview Bento Card */}\n      <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h2 className=\"text-sm font-semibold uppercase tracking-wider text-zinc-300 flex items-center gap-2\">\n              <span className=\"w-2 h-2 rounded-full bg-indigo-500\"></span>\n              9 Autonomous Production Agents & Integrated Tools\n            </h2>\n            <p className=\"text-xs text-zinc-400 mt-0.5\">\n              Each specialized agent operates autonomously with dedicated LLM prompts, input/output schemas, and toolchains.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2.5 text-xs\">\n            <span className=\"px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/30 font-mono font-semibold\">\n              9 Agents Active\n            </span>\n            <span className=\"px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono font-semibold\">\n              Server-Side Only\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Agents Grid & Detail View */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left: Agent Selection List */}\n        <div className=\"lg:col-span-5 space-y-3\">\n          {AGENTS.map((agent) => {\n            const isSelected = selectedAgent.id === agent.id;\n            return (\n              <div\n                key={agent.id}\n                onClick={() => setSelectedAgent(agent)}\n                className={`p-4 rounded-2xl border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"border-indigo-500/60 bg-[#09090b] shadow-[0_0_15px_rgba(79,70,229,0.15)] ring-1 ring-indigo-500/25\"\n                    : \"border-[#27272a] bg-[#09090b] hover:border-zinc-700\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold text-xs\">\n                      {agent.name.slice(0, 2)}\n                    </div>\n                    <div>\n                      <h4 className=\"font-bold text-xs text-[#fafafa]\">{agent.name}</h4>\n                      <p className=\"text-[11px] text-zinc-400\">{agent.role}</p>\n                    </div>\n                  </div>\n                  <span className=\"text-[10px] font-mono font-semibold px-2 py-0.5 rounded-md bg-[#18181b] border border-[#27272a] text-indigo-300\">\n                    {agent.model}\n                  </span>\n                </div>\n                <div className=\"flex items-center gap-2 mt-2.5 text-[10px] text-zinc-500 font-mono\">\n                  <span>{agent.phase}</span>\n                  <span>\342\200\242</span>\n                  <span>{agent.tools.length} Tools</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right: Selected Agent Deep Dive Bento Card */}\n        <div className=\"lg:col-span-7 space-y-5\">\n          <div className=\"bg-[#18181b] border border-[#27272a] rounded-3xl p-6 shadow-sm space-y-6\">\n            <div className=\"flex items-start justify-between border-b border-[#27272a] pb-4\">\n              <div>\n                <div className=\"flex items-center gap-2.5\">\n                  <h3 className=\"text-base font-bold text-[#fafafa]\">{selectedAgent.name}</h3>\n                  <span className=\"text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-md bg-indigo-500/10 text-indigo-300 border border-indigo-500/20\">\n                    {selectedAgent.phase}\n                  </span>\n                </div>\n                <p className=\"text-xs text-indigo-400 font-medium mt-1\">{selectedAgent.role}</p>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-[10px] text-zinc-500 block font-mono uppercase tracking-wider\">PRIMARY ENGINE</span>\n                <span className=\"text-xs font-bold text-emerald-400 font-mono\">{selectedAgent.model}</span>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-zinc-300 leading-relaxed\">\n              {selectedAgent.description}\n            </p>\n\n            {/* Tools Integrated */}\n            <div>\n              <h4 className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2.5 flex items-center gap-2\">\n                <Wrench className=\"w-3.5 h-3.5 text-indigo-400\" />\n                Integrated Tools & External APIs\n              </h4>\n              <div className=\"flex flex-wrap gap-2\">\n                {selectedAgent.tools.map((tool, ti) => (\n                  <span key={ti} className=\"text-xs px-3 py-1.5 rounded-xl bg-[#09090b] border border-[#27272a] text-zinc-300 font-mono\">\n                    {tool}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            {/* Input / Output Contracts */}\n            <div className=\"space-y-4 pt-1\">\n              <div>\n                <span className=\"text-[11px] font-mono text-zinc-400 block mb-1.5 uppercase tracking-wider\">INPUT SCHEMA CONTRACT</span>\n                <pre className=\"p-3.5 rounded-2xl bg-[#09090b] border border-[#27272a] text-[11px] font-mono text-indigo-300 overflow-x-auto\">\n                  {selectedAgent.inputFormat}\n                </pre>\n              </div>\n              <div>\n                <span className=\"text-[11px] font-mono text-zinc-400 block mb-1.5 uppercase tracking-wider\">OUTPUT PAYLOAD CONTRACT</span>\n                <pre 