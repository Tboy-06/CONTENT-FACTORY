nomous Pipelines</div>\n        </div>\n      </div>\n\n      {/* Sub-Navigation */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl\">\n        <div className=\"flex space-x-2 border-b border-slate-800 pb-3 mb-4 overflow-x-auto text-xs font-semibold\">\n          <button\n            onClick={() => setActiveSubTab(\"styles\")}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition cursor-pointer ${\n              activeSubTab === \"styles\"\n                ? \"bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\"\n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Palette className=\"w-3.5 h-3.5\" />\n            <span>Style Guides & Visual DNA</span>\n          </button>\n\n          <button\n            onClick={() => setActiveSubTab(\"characters\")}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition cursor-pointer ${\n              activeSubTab === \"characters\"\n                ? \"bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\"\n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <UserCheck className=\"w-3.5 h-3.5\" />\n            <span>Character Bibles</span>\n          </button>\n\n          <button\n            onClick={() => setActiveSubTab(\"hooks\")}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition cursor-pointer ${\n              activeSubTab === \"hooks\"\n                ? \"bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\"\n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Flame className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>High-Retention Hook Formulas</span>\n          </button>\n\n          <button\n            onClick={() => setActiveSubTab(\"retention\")}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition cursor-pointer ${\n              activeSubTab === \"retention\"\n                ? \"bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\"\n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <LineChart className=\"w-3.5 h-3.5\" />\n            <span>Algorithmic Retention Curve</span>\n          </button>\n\n          <button\n            onClick={() => setActiveSubTab(\"logs\")}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition cursor-pointer ${\n              activeSubTab === \"logs\"\n                ? \"bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\"\n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <ScrollText className=\"w-3.5 h-3.5\" />\n            <span>System Event Logs</span>\n          </button>\n        </div>\n\n        {/* Tab 1: Style Guides */}\n        {activeSubTab === \"styles\" && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {styleGuides.map((sg, idx) => (\n              <div key={idx} className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-sm text-white\">{sg.niche}</h4>\n                  <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-cyan-300\">\n                    STYLE DNA\n                  </span>\n                </div>\n                <div className=\"text-xs text-slate-300 space-y-1.5\">\n                  <p><strong>Archetype:</strong> {sg.archetype}</p>\n                  <div className=\"flex items-center gap-2\">\n                    <span>Palette:</span>\n                    <span className=\"w-4 h-4 rounded border border-slate-700\" style={{ backgroundColor: sg.primaryColor }} />\n                    <span className=\"w-4 h-4 rounded border border-slate-700\" style={{ backgroundColor: sg.accentColor }} />\n                    <span className=\"text-slate-400 font-mono text-[11px]\">{sg.primaryColor}, {sg.accentColor}</span>\n                  </div>\n                  <p><strong>Typography:</strong> {sg.typography}</p>\n                  <p><strong>Cut Frequency:</strong> {sg.cutFrequency}</p>\n                  <p><strong>Audio DNA:</strong> {sg.music}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Tab 2: Character Bibles */}\n        {activeSubTab === \"characters\" && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {characterBibles.map((cb, idx) => (\n              <div key={idx} className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-sm text-cyan-300\">{cb.characterName}</h4>\n                  <span className=\"text-[10px] font-mono text-slate-400\">{cb.niche}</span>\n                </div>\n                <p className=\"text-xs text-slate-300\"><strong>Persona:</strong> {cb.persona}</p>\n                <p className=\"text-xs text-slate-300\"><strong>Visual Spec:</strong> {cb.visualDescription}</p>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Tab 3: Hook Formulas */}\n        {activeSubTab === \"hooks\" && (\n          <div className=\"space-y-2.5\">\n            {hookFormulas.map((hf, idx) => (\n              <div key={idx} className=\"p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-4\">\n                <div className=\"space-y-1 flex-1\">\n                  <div className=\"text-xs font-semibold text-white\">\"{hf.formula}\"</div>\n                  <div className=\"text-[11px] text-slate-400 flex items-center gap-3\">\n                    <span>Tested across <strong>{hf.count}</strong> videos</span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-emerald-400 font-semibold\">Average 3s Retention: {hf.score}%</span>\n                  </div>\n                </div>\n                <div className=\"text-right shrink-0\">\n                  <div className=\"text-base font-extrabold text-amber-400 font-mono\">{hf.score}</div>\n                  <div className=\"text-[10px] text-slate-500 uppercase\">VIRALITY SCORE</div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Tab 4: Retention Curve Graph */}\n        {activeSubTab === \"retention\" && (\n          <div className=\"p-5 rounded-xl bg-slate-950 border border-slate-800 space-y-4\">\n            <div>\n              <h4 className=\"text-xs font-bold text-white uppercase tracking-wider\">\n                Average Second-by-Second Audience Retention (38s Short-Form Video)\n              </h4>\n              <p className=\"text-xs text-slate-400\">\n                Audience retention benchmarks analyzed across TikTok, Instagram Reels, and YouTube Shorts.\n              </p>\n            </div>\n\n            {/* SVG Retention Graph */}\n            <div className=\"h-64 w-full relative pt-4\">\n              <svg className=\"w-full h-full overflow-visible\" viewBox=\"0 0 500 180\" preserveAspectRatio=\"none\">\n                {/* Horizontal Grid lines */}\n                <line x1=\"0\" y1=\"0\" x2=\"500\" y2=\"0\" stroke=\"#334155\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n                <line x1=\"0\" y1=\"45\" x2=\"500\" y2=\"45\" stroke=\"#334155\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n                <line x1=\"0\" y1=\"90\" x2=\"500\" y2=\"90\" stroke=\"#334155\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n                <line x1=\"0\" y1=\"135\" x2=\"500\" y2=\"135\" stroke=\"#334155\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n                <line x1=\"0\" y1=\"180\" x2=\"500\" y2=\"180\" stroke=\"#475569\" strokeWidth=\"1\" />\n\n                {/* Shaded area */}\n                <path\n                  d=\"M 0 0 L 50 14 L 120 28 L 240 42 L 360 48 L 500 52 L 500 180 L 0 180 Z\"\n                  fill=\"url(#retentionGrad)\"\n                  opacity=\"0.3\"\n                />\n\n                {/* Line */}\n                <path\n                  d=\"M 0 0 L 50 14 L 120 28 L 240 42 L 360 48 L 500 52\"\n                  fill=\"none\"\n                  stroke=\"#06b6d4\"\n                  strokeWidth=\"3\"\n                />\n\n                {/* Data Points */}\n                <circle cx=\"0\" cy=\"0\" r=\"4\" fill=\"#06b6d4\" />\n                <circle cx=\"50\" cy=\"14\" r=\"4\" fill=\"#06b6d4\" />\n                <circle cx=\"120\" cy=\"28\" r=\"4\" fill=\"#06b6d4\" />\n                <circle cx=\"240\" cy=\"42\" r=\"4\" fill=\"#06b6d4\" />\n                <circle cx=\"360\" cy=\"48\" r=\"4\" fill=\"#06b6d4\" />\n                <circle cx=\"500\" cy=\"52\" r=\"4\" fill=\"#06b6d4\" />\n\n                <defs>\n                  <linearGradient id=\"retentionGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                    <stop offset=\"0%\" stopColor=\"#06b6d4\" />\n                    <stop offset=\"100%\" stopColor=\"#06b6d4\" stopOpacity=\"0\" />\n                  </linearGradient>\n                </defs>\n              </svg>\n\n              {/* Labels below */}\n              <div className=\"flex justify-between text-[10px] text-slate-400 font-mono mt-2\">\n                <span>0s (Hook) \342\200\242 100%</span>\n                <span>3s (Filter) \342\200\242 92%</span>\n                <span>10s (Act 1) \342\200\242 84%</span>\n                <span>20s (Act 2) \342\200\242 77%</span>\n                <span>30s (Act 3) \342\200\242 73%</span>\n                <span>38s (CTA) \342\200\242 71%</span>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 5: Logs */}\n        {activeSubTab === \"logs\" && (\n          <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2 font-mono text-xs max-h-80 overflow-y-auto\">\n            {logs.map((log) => (\n              <div key={log.id} className=\"flex items-start gap-3 py-1 border-b border-slate-900 last:border-0\">\n                <span className=\"text-slate-500 shrink-0\">{log.time}</span>\n                <span className=\"text-slate-300\">{log.message}</span>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>"
