        lines {
          text: "      const deltaY = endY - startY;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return `M ${startX} ${startY} C ${startX} ${startY + deltaY * 0.5}, ${endX} ${endY - deltaY * 0.5}, ${endX} ${endY}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
