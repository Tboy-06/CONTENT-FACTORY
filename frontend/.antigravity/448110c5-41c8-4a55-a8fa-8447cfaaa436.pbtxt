      replacement_content: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>CONTENT-FACTORY Dashboard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: \'Plus Jakarta Sans\', sans-serif; }\n        code, pre { font-family: \'JetBrains Mono\', monospace; }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 min-h-screen\">\n    <!-- Header -->\n    <header class=\"border-b border-slate-800 bg-slate-900/60 backdrop-blur px-6 py-4 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"w-9 h-9 rounded-lg bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-lg text-white shadow-lg shadow-cyan-500/20\">\n                    CF\n                </div>\n                <div>\n                    <h1 class=\"text-lg font-bold text-white tracking-tight\">CONTENT-FACTORY</h1>\n                    <p class=\"text-xs text-slate-400\">9-Agent Autonomous Content Pipeline</p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 text-xs\">\n                <div class=\"px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 flex items-center gap-2\">\n                    <span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                    <span class=\"text-slate-300\">Telegram Bot Online</span>\n                </div>\n                <div class=\"px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700\">\n                    <span class=\"text-slate-400\">Daily Spend:</span>\n                    <span class=\"font-semibold text-emerald-400 ml-1\">${{ total_costs }} / ${{ budget }}</span>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content -->\n    <main class=\"max-w-7xl mx-auto px-6 py-8 space-y-8\">\n        <!-- Metric Cards -->\n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n            <div class=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n                <div class=\"text-xs text-slate-400 uppercase tracking-wider font-semibold\">Active Jobs</div>\n                <div class=\"text-3xl font-extrabold text-white mt-1\">{{ jobs|length }}</div>\n                <div class=\"text-xs text-cyan-400 mt-2\">10 Pipeline Stages</div>\n            </div>\n            <div class=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n                <div class=\"text-xs text-slate-400 uppercase tracking-wider font-semibold\">Total Tokens</div>\n                <div class=\"text-3xl font-extrabold text-white mt-1\">{{ total_tokens }}</div>\n                <div class=\"text-xs text-slate-400 mt-2\">Gemini 3.7 / 2.5 Pro</div>\n            </div>\n            <div class=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n                <div class=\"text-xs text-slate-400 uppercase tracking-wider font-semibold\">API Spend</div>\n                <div class=\"text-3xl font-extrabold text-emerald-400 mt-1\">${{ total_costs }}</div>\n                <div class=\"text-xs text-slate-400 mt-2\">Daily Budget ${{ budget }}</div>\n            </div>\n            <div class=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n                <div class=\"text-xs text-slate-400 uppercase tracking-wider font-semibold\">HITL Status</div>\n                <div class=\"text-3xl font-extrabold text-amber-400 mt-1\">3 Gates</div>\n                <div class=\"text-xs text-slate-400 mt-2\">SCRIPT, QC1, QC2 Telegram gates</div>\n            </div>\n        </div>\n\n        <!-- 10-Stage Visual Map -->\n        <div class=\"bg-slate-900/80 border border-slate-800 rounded-xl p-6\">\n            <h2 class=\"text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4\">Pipeline Execution Stages</h2>\n            <div class=\"flex flex-wrap items-center gap-2 text-xs\">\n                {% set stages = [\"IDEA\", \"RESEARCH\", \"SCRIPT\", \"QC1\", \"STYLE\", \"ART\", \"VIDEO\", \"QC2\", \"POST\", \"ANALYZE\"] %}\n                {% for st in stages %}\n                    <div class=\"px-3 py-2 rounded-lg bg-slate-800/80 border border-slate-700 text-slate-200 flex items-center gap-1.5 font-mono\">\n                        <span class=\"text-cyan-400 font-bold\">{{ loop.index }}.</span>\n                        <span>{{ st }}</span>\n                        {% if st in [\"SCRIPT\", \"QC1\", \"QC2\"] %}\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-amber-400\" title=\"Approval Gate\"></span>\n                        {% endif %}\n                    </div>\n                    {% if not loop.last %}\n                        <span class=\"text-slate-600\">\342\206\222</span>\n                    {% endif %}\n                {% endfor %}\n            </div>\n        </div>\n\n        <!-- Active Jobs Table -->\n        <div class=\"bg-slate-900/80 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n            <div class=\"p-6 border-b border-slate-800 flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-lg font-bold text-white\">Active Pipelines</h2>\n                    <p class=\"text-xs text-slate-400\">Content production queues managed by 9 agents</p>\n                </div>\n            </div>\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left text-sm\">\n                    <thead class=\"bg-slate-950/60 text-xs uppercase text-slate-400 border-b border-slate-800\">\n                        <tr>\n                            <th class=\"px-6 py-4 font-semibold\">Job ID</th>\n                            <th class=\"px-6 py-4 font-semibold\">Niche & Topic</th>\n                            <th class=\"px-6 py-4 font-semibold\">Current Stage</th>\n                            <th class=\"px-6 py-4 font-semibold\">Status</th>\n                            <th class=\"px-6 py-4 font-semibold text-right\">Actions</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-slate-800/60\">\n                        {% for job in jobs %}\n                        <tr class=\"hover:bg-slate-800/30 transition-colors\">\n                            <td class=\"px-6 py-4 font-mono text-cyan-400 font-semibold\">#{{ job.id }}</td>\n                            <td class=\"px-6 py-4 font-medium text-white\">{{ job.niche }}</td>\n                            <td class=\"px-6 py-4\">\n                                <span class=\"px-2.5 py-1 rounded-md bg-blue-950/80 border border-blue-800/60 text-blue-300 font-mono text-xs\">\n                                    {{ job.current_stage.value }}\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4\">\n                                <span class=\"px-2.5 py-1 rounded-md text-xs font-semibold\n                                    {% if job.status.value == \'COMPLETED\' %}bg-emerald-950/80 border border-emerald-800/60 text-emerald-300\n                                    {% elif job.status.value == \'IN_PROGRESS\' %}bg-cyan-950/80 border border-cyan-800/60 text-cyan-300\n                                    {% elif job.status.value == \'AWAITING_APPROVAL\' %}bg-amber-950/80 border border-amber-800/60 text-amber-300\n                                    {% elif job.status.value == \'AWAITING_PREMIUM\' %}bg-purple-950/80 border border-purple-800/60 text-purple-300\n                                    {% else %}bg-slate-800 border border-slate-700 text-slate-300{% endif %}\">\n                                    {{ job.status.value }}\n                                </span>\n                            </td>\n                            <td class=\"px-6 py-4 text-right\">\n                                <a href=\"/job/{{ job.id }}\" class=\"text-xs font-semibold text-cyan-400 hover:text-cyan-300 underline\">\n                                    View Timeline \342\206\222\n                                </a>\n                            </td>\n                        </tr>\n                        {% else %}\n                        <tr>\n                            <td colspan=\"5\" class=\"px-6 py-8 text-center text-slate-500\">\n                                No active jobs. Trigger a job via Telegram `/goal &lt;niche&gt;` or web control panel.\n                            </td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </div>\n        </div>\n    </main>\n</body>\n</html>\n"
    }
