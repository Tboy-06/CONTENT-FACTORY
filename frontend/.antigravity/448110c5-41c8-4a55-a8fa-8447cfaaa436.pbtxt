  file_change {
    absolute_path_uri: "file:///src/components/CodeExplorer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { CodeFile } from \"../types\";\nimport { FileCode, Copy, Check, Terminal, ExternalLink, Download } from \"lucide-react\";\n\nexport const CodeExplorer: React.FC = () => {\n  const [files, setFiles] = useState<CodeFile[]>([]);\n  const [selectedFile, setSelectedFile] = useState<CodeFile | null>(null);\n  const [copied, setCopied] = useState(false);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetch(\"/api/code-files\")\n      .then(r => r.json())\n      .then((data: CodeFile[]) => {\n        setFiles(data);\n        if (data.length > 0) setSelectedFile(data[0]);\n        setLoading(false);\n      })\n      .catch(() => setLoading(false));\n  }, []);\n\n  const handleCopy = () => {\n    if (!selectedFile) return;\n    navigator.clipboard.writeText(selectedFile.content);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  if (loading) {\n    return <div className=\"p-8 text-center text-slate-400\">Loading codebase files...</div>;\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Overview Card */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2\">\n              <FileCode className=\"w-4 h-4 text-cyan-400\" />\n              Content-Factory Production Codebase & Specifications\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Browse, inspect, and copy the full Python 3.11+ backend files, SQLAlchemy 2.0 models, 9 Agents, and Docker deployment configs.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 font-mono text-xs text-slate-400\">\n            <span>{files.length} Source Files Generated</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Two Column Layout: File Tree & Code Viewer */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: File List */}\n        <div className=\"lg:col-span-4 space-y-2 max-h-[640px] overflow-y-auto pr-1\">\n          {files.map((f, idx) => {\n            const isSelected = selectedFile?.path === f.path;\n            return (\n              <div\n                key={idx}\n                onClick={() => setSelectedFile(f)}\n                className={`p-3 rounded-xl border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"border-cyan-500 bg-cyan-950/30 shadow-md shadow-cyan-500/10\"\n                    : \"border-slate-800/80 bg-slate-900/40 hover:border-slate-700 hover:bg-slate-800/40\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-mono font-bold text-xs text-white truncate\">\n                    {f.name}\n                  </span>\n                  <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-800 text-slate-400 shrink-0\">\n                    {f.path.endsWith(\".py\") ? \"PYTHON\" : f.path.endsWith(\".md\") ? \"DOCS\" : \"CONFIG\"}\n                  </span>\n                </div>\n                <p className=\"text-[11px] text-slate-400 mt-1 line-clamp-1\">{f.desc}</p>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right Column: Code Viewer */}\n        <div className=\"lg:col-span-8\">\n          {selectedFile ? (\n            <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl flex flex-col h-[640px]\">\n              {/* Header */}\n              <div className=\"bg-slate-950 px-5 py-3.5 border-b border-slate-800 flex items-center justify-between\">\n                <div>\n                  <div className=\"font-mono font-bold text-xs text-cyan-400\">{selectedFile.path}</div>\n                  <div className=\"text-[11px] text-slate-400\">{selectedFile.desc}</div>\n                </div>\n                <button\n                  onClick={handleCopy}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition cursor-pointer border border-slate-700\"\n                >\n                  {copied ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                      <span className=\"text-emerald-400\">Copied!</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy Code</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              {/* Code text */}\n              <div className=\"flex-1 overflow-auto p-4 bg-slate-950 text-slate-200 font-mono text-xs leading-relaxed\">\n                <pre className=\"whitespace-pre-wrap select-text\">\n                  {selectedFile.content || \"# File empty or not loaded\"}\n                </pre>\n              </div>\n            </div>\n          ) : (\n            <div className=\"p-12 text-center text-slate-500\">Select a file to inspect code.</div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
