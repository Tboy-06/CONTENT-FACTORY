        }
        lines {
          text: "    const deltaX = Math.abs(endX - startX);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cp1X = startX + deltaX * 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cp1Y = startY;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
