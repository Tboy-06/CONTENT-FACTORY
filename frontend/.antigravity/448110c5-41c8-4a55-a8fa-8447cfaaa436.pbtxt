      replacement_content: "    { id: 1, time: new Date().toLocaleTimeString(), message: \"System initialized. 9 Agents active. Scheduler running.\" },\n    { id: 2, time: new Date().toLocaleTimeString(), message: \"Telegram HITL Bot connected. Polling for commands.\" }\n  ]\n};\n\n// ============================================================\n// FREE TIER REFERENCE & REAL SPEC METADATA\n// ============================================================\nconst FREE_TIER_REFERENCE = {\n  models: [\n    {\n      model: \"gemini-3.6-flash\",\n      purpose: \"Primary LLM (Researcher, Scriptwriter, Manager, QC, Analyst)\",\n      limits: \"15 RPM, 1,500 RPD, 1M tokens/min\",\n      why: \"Latest flash model, fastest/cheapest, supports JSON schema, function calling, 1M context\",\n      keyName: \"GEMINI_API_KEY\",\n      isConfigured: Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \"MY_GEMINI_API_KEY\"),\n      docUrl: \"https://aistudio.google.com/apikey\"\n    },\n    {\n      model: \"gemini-3.7-flash\",\n      purpose: \"Complex reasoning (Art Director, Style Analyst prompts)\",\n      limits: \"10 RPM, 1,000 RPD\",\n      why: \"Slightly higher quality for creative tasks and visual prompt packs\",\n      keyName: \"GEMINI_API_KEY\",\n      isConfigured: Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \"MY_GEMINI_API_KEY\"),\n      docUrl: \"https://aistudio.google.com/apikey\"\n    },\n    {\n      model: \"gemini-2.5-pro\",\n      purpose: \"Vision analysis (Style Analyst, Video Editor frame review)\",\n      limits: \"5 RPM, 100 RPD\",\n      why: \"Best vision understanding, handles video frames + images natively\",\n      keyName: \"GEMINI_API_KEY\",\n      isConfigured: Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \"MY_GEMINI_API_KEY\"),\n      docUrl: \"https://aistudio.google.com/apikey\"\n    }\n  ],\n  videoSearch: [\n    {\n      api: \"YouTube Data API v3\",\n      purpose: \"Search trending videos by niche/keyword, get view counts, metadata\",\n      freeTier: \"10,000 units/day (~500 searches)\",\n      why: \"Only reliable source for real YouTube trend data; required for Researcher\",\n      keyName: \"YOUTUBE_API_KEY\",\n      isConfigured: Boolean(process.env.YOUTUBE_API_KEY)\n    },\n    {\n      api: \"Tavily Search\",\n      purpose: \"Web search for trending topics, news, statistics\",\n      freeTier: \"1,000 requests/month\",\n      why: \"Built for AI agents, returns clean JSON, includes citations\",\n      keyName: \"TAVILY_API_KEY\",\n      isConfigured: Boolean(process.env.TAVILY_API_KEY)\n    },\n    {\n      api: \"SerpAPI\",\n      purpose: \"Google search fallback (shopping, local, news)\",\n      freeTier: \"100 searches/month\",\n      why: \"Broader web coverage when Tavily misses\",\n      keyName: \"SERPAPI_KEY\",\n      isConfigured: Boolean(process.env.SERPAPI_KEY)\n    },\n    {\n      api: \"Firecrawl\",\n      purpose: \"Scrape full article content from URLs\",\n      freeTier: \"500 credits/month (free tier)\",\n      why: \"Extracts clean markdown from any URL for research depth\",\n      keyName: \"FIRECRAWL_KEY\",\n      isConfigured: Boolean(process.env.FIRECRAWL_KEY)\n    },\n    {\n      api: \"Jina AI Reader\",\n      purpose: \"Free URL -> markdown (no key needed)\",\n      freeTier: \"Unlimited\",\n      why: \"Zero-cost fallback for content extraction\",\n      keyName: \"NONE\",\n      isConfigured: true\n    }\n  ],\n  media: [\n    {\n      service: \"Pexels API\",\n      purpose: \"Stock photos/videos for B-roll, thumbnails\",\n      freeTier: \"200 requests/hour, 20,000/month\",\n      why: \"High quality, royalty-free, no attribution required, vertical video clips available\",\n      keyName: \"PEXELS_API_KEY\",\n      isConfigured: Boolean(process.env.PEXELS_API_KEY),\n      docUrl: \"https://www.pexels.com/api/\"\n    },\n    {\n      service: \"ComfyUI (local)\",\n      purpose: \"Custom image generation (optional)\",\n      freeTier: \"Unlimited (run locally on GPU)\",\n      why: \"Zero cost, full control, runs on your local GPU\",\n      keyName: \"LOCAL\",\n      isConfigured: true\n    },\n    {\n      service: \"Edge-TTS (Microsoft)\",\n      purpose: \"Narration for all videos\",\n      freeTier: \"FREE (no API key required)\",\n      why: \"100+ voices, SSML support, runs via edge-tts Python pkg, no rate limits\",\n      keyName: \"NONE\",\n      isConfigured: true\n    },\n    {\n      service: \"FFmpeg\",\n      purpose: \"Concatenate clips, add audio, burn captions, encode final MP4\",\n      freeTier: \"FREE (local binary in PATH)\",\n      why: \"Industry standard, hardware acceleration, zero cost, full control\",\n      keyName: \"LOCAL\",\n      isConfigured: true\n    }\n  ],\n  socialAndOps: [\n    {\n      service: \"Postiz (self-hosted)\",\n      purpose: \"Schedule/post to TikTok, IG, YT, LinkedIn, X, FB\",\n      freeTier: \"FREE (self-hosted via docker-compose)\",\n      why: \"Only free, open-source multi-platform scheduler with API\",\n      keyName: \"POSTIZ_API_KEY\",\n      isConfigured: Boolean(process.env.POSTIZ_API_KEY)\n    },\n    {\n      service: \"Telegram Bot\",\n      purpose: \"Approve/reject stages, set goals, view status, upload premium videos\",\n      freeTier: \"FREE (BotFather long polling)\",\n      why: \"Push notifications, file upload, inline keyboards, no webhook hosting needed\",\n      keyName: \"TELEGRAM_BOT_TOKEN\",\n      isConfigured: Boolean(process.env.TELEGRAM_BOT_TOKEN && process.env.TELEGRAM_BOT_TOKEN !== \"your_telegram_token\")\n    },\n    {\n      service: \"SQLite (default)\",\n      purpose: \"Local dev, single-user metadata storage (vault.db)\",\n      freeTier: \"FREE (Zero config, file-based)\",\n      why: \"Zero config, file-based, instant startup, scales to PostgreSQL\",\n      keyName: \"DATABASE_URL\",\n      isConfigured: true\n    },\n    {\n      service: \"Google Veo / Flow (manual)\",\n      purpose: \"Cinematic video generation (optional)\",\n      freeTier: \"$20/mo (Gemini Pro plan browser access)\",\n      why: \"Manual: Art Director outputs prompt packs -> user pastes in browser -> uploads via /upload_premium\",\n      keyName: \"MANUAL\",\n      isConfigured: true\n    }\n  ]\n};\n\n// Executions History Store\ninterface ExecutionRecord {\n  id: string;\n  workflowName: string;\n  status: \"SUCCESS\" | \"RUNNING\" | \"WAITING\" | \"ERROR\";\n  triggerType: \"TELEGRAM_WEBHOOK\" | \"MANUAL_TEST\" | \"CRON_SCHEDULER\";\n  startedAt: string;\n  durationMs: number;\n  niche: string;\n  nodesCount: number;\n  steps: Array<{\n    nodeId: string;\n    nodeName: string;\n    status: \"success\" | \"error\" | \"running\" | \"skipped\";\n    durationMs: number;\n    inputData?: any;\n    outputData?: any;\n    error?: string;\n  }>;\n}\n\nlet executionsStore: ExecutionRecord[] = [\n  {\n    id: \"exec_1092\",\n    workflowName: \"CONTENT-FACTORY \342\200\224 Autonomous Free-Tier Media Pipeline\",\n    status: \"SUCCESS\",\n    triggerType: \"TELEGRAM_WEBHOOK\",\n    startedAt: new Date(Date.now() - 1000 * 60 * 50).toISOString(),\n    durationMs: 3840,\n    niche: \"AI Productivity Hacks\",\n    nodesCount: 16,\n    steps: [\n      { nodeId: \"node-telegram-trigger\", nodeName: \"Telegram Trigger\", status: \"success\", durationMs: 45, outputData: { text: \"/goal AI Productivity Hacks\", sender_id: 8492019 } },\n      { nodeId: \"node-switch-type\", nodeName: \"Switch: Voice vs Text\", status: \"success\", durationMs: 12, outputData: { branch: \"text\", content: \"AI Productivity Hacks\" } },\n      { nodeId: \"node-input-prep\", nodeName: \"Input Formatter\", status: \"success\", durationMs: 25, outputData: { niche: \"AI Productivity Hacks\", format: \"9:16 Vertical\" } },\n      { nodeId: \"node-ai-agent\", nodeName: \"AI Agent Orchestrator\", status: \"success\", durationMs: 820, outputData: { decision: \"DECOMPOSE_AND_DISPATCH\", sub_agents: [\"Researcher\", \"Scriptwriter\", \"ArtDirector\"] } },\n      { nodeId: \"node-tool-youtube\", nodeName: \"YouTube Data API v3\", status: \"success\", durationMs: 310, outputData: { trending_videos_found: 5, top_view_count: \"2.4M\" } },\n      { nodeId: \"node-tool-scriptwriter\", nodeName: \"Scriptwriter Sub-Agent\", status: \"success\", durationMs: 650, outputData: { hook: \"Wait\342\200\224if you are still prompting AI like a Google search...\", duration: 38 } },\n      { nodeId: \"node-tool-pexels\", nodeName: \"Pexels Stock API\", status: \"success\", durationMs: 280, outputData: { b_roll_clips: 4, orientation: \"portrait\" } },\n      { nodeId: \"node-tool-edge-tts\", nodeName: \"Edge-TTS (Microsoft)\", status: \"success\", durationMs: 410, outputData: { voice: \"en-US-AriaNeural\", duration_sec: 38.2 } },\n      { nodeId: \"node-tool-ffmpeg\", nodeName: \"FFmpeg Assembler\", status: \"success\", durationMs: 740, outputData: { resolution: \"1080x1920\", fps: 60, status: \"ASSEMBLED\" } },\n      { nodeId: \"node-append-vault\", nodeName: \"Append to SQLite Vault\", status: \"success\", durationMs: 80, outputData: { vault_id: 101, status: \"PERSISTED\" } },\n      { nodeId: \"node-telegram-response\", nodeName: \"Telegram Response\", status: \"success\", durationMs: 110, outputData: { sent: true, recipient: 8492019 } }\n    ]\n  },\n  {\n    id: \"exec_1091\",\n    workflowName: \"CONTENT-FACTORY \342\200\224 Autonomous Free-Tier Media Pipeline\",\n    status: \"WAITING\",\n    triggerType: \"MANUAL_TEST\",\n    startedAt: new Date(Date.now() - 1000 * 60 * 120).toISOString(),\n    durationMs: 2150,\n    niche: \"Stoic Mindset & Focus\",\n    nodesCount: 9,\n    steps: [\n      { nodeId: \"node-input-prep\", nodeName: \"Input Formatter\", status: \"success\", durationMs: 20, outputData: { niche: \"Stoic Mindset & Focus\" } },\n      { nodeId: \"node-ai-agent\", nodeName: \"AI Agent Orchestrator\", status: \"success\", durationMs: 780, outputData: { directive: \"Hig