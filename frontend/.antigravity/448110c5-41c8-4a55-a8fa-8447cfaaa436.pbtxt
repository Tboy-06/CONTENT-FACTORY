      replacement_content: "import React, { useState, useEffect, useRef } from \"react\";\nimport { \n  Job, \n  WorkflowNode, \n  WorkflowEdge, \n  WorkflowExecution \n} from \"../types\";\nimport { \n  Play, \n  Sparkles, \n  Bot, \n  Maximize2, \n  Plus, \n  Minus, \n  RotateCcw, \n  Zap, \n  Send, \n  Video, \n  Image as ImageIcon, \n  Volume2, \n  Layers, \n  Database, \n  CheckCircle2, \n  AlertCircle, \n  Clock, \n  Activity, \n  ShieldCheck, \n  Settings, \n  Sliders, \n  ChevronRight, \n  ExternalLink,\n  Table,\n  Cpu,\n  GitFork,\n  DownloadCloud,\n  Mic,\n  FileText,\n  FileSpreadsheet,\n  Code,\n  AlertTriangle,\n  Brain,\n  Compass,\n  Search,\n  FileCode,\n  PenTool,\n  Bookmark,\n  UserCheck,\n  Palette,\n  Clapperboard,\n  Film,\n  Eye,\n  Globe,\n  TrendingUp,\n  Repeat,\n  Star,\n  Share2,\n  Check\n} from \"lucide-react\";\nimport { NodeInspectorModal } from \"./NodeInspectorModal\";\nimport { FreeTierReferenceModal } from \"./FreeTierReferenceModal\";\nimport { WorkflowExecutionsView } from \"./WorkflowExecutionsView\";\n\ninterface N8nWorkflowCanvasProps {\n  jobs: Job[];\n  selectedJob: Job | null;\n  onSelectJob: (job: Job) => void;\n  onAdvanceStage: (jobId: number) => Promise<void>;\n  onApproveStage: (jobId: number) => Promise<void>;\n  onRejectStage: (jobId: number, reason: string) => Promise<void>;\n  onUploadPremium: (jobId: number) => Promise<void>;\n  onOpenNewJob: () => void;\n  isAdvancing: boolean;\n}\n\nexport const N8nWorkflowCanvas: React.FC<N8nWorkflowCanvasProps> = ({\n  jobs,\n  selectedJob,\n  onSelectJob,\n  onAdvanceStage,\n  onApproveStage,\n  onRejectStage,\n  onUploadPremium,\n  onOpenNewJob,\n  isAdvancing\n}) => {\n  // Canvas View Mode: \"editor\" or \"executions\"\n  const [canvasViewMode, setCanvasViewMode] = useState<\"editor\" | \"executions\">(\"editor\");\n\n  // Workflow graph specification\n  const [nodes, setNodes] = useState<WorkflowNode[]>([]);\n  const [edges, setEdges] = useState<WorkflowEdge[]>([]);\n  const [isLoadingSpec, setIsLoadingSpec] = useState(true);\n\n  // Pan & Zoom\n  const [zoom, setZoom] = useState(0.88);\n  const [pan, setPan] = useState({ x: 30, y: 10 });\n  const [isPanning, setIsPanning] = useState(false);\n  const [startPan, setStartPan] = useState({ x: 0, y: 0 });\n\n  // Selected Node for NodeInspectorModal\n  const [inspectedNode, setInspectedNode] = useState<WorkflowNode | null>(null);\n\n  // Free Tier Reference Modal\n  const [isFreeTierModalOpen, setIsFreeTierModalOpen] = useState(false);\n\n  // Live Workflow Execution State\n  const [isExecutingWorkflow, setIsExecutingWorkflow] = useState(false);\n  const [executionMessage, setExecutionMessage] = useState<string | null>(null);\n\n  // Quick Chat / Prompt Drawer\n  const [quickPrompt, setQuickPrompt] = useState(\"AI Productivity Hacks\");\n  const [showPromptBar, setShowPromptBar] = useState(false);\n\n  // Workflow Active Toggle Switch\n  const [isWorkflowActive, setIsWorkflowActive] = useState(true);\n\n  // Fetch Workflow Graph Spec from backend\n  const fetchWorkflowSpec = async () => {\n    try {\n      const res = await fetch(\"/api/workflow/spec\");\n      if (res.ok) {\n        const data = await res.json();\n        setNodes(data.workflow.nodes || []);\n        setEdges(data.workflow.edges || []);\n      }\n    } catch (e) {\n      console.error(\"Failed to load workflow spec:\", e);\n    } finally {\n      setIsLoadingSpec(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchWorkflowSpec();\n  }, []);\n\n  // Run the full workflow execution with real backend pipeline\n  const handleExecuteWorkflow = async (nicheToRun?: string) => {\n    const targetNiche = nicheToRun || quickPrompt || selectedJob?.niche || \"AI Productivity Hacks\";\n    setIsExecutingWorkflow(true);\n    setExecutionMessage(`Executing pipeline for \"${targetNiche}\"...`);\n    try {\n      const res = await fetch(\"/api/workflow/run\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          niche: targetNiche,\n          triggerType: \"MANUAL_TEST\"\n        })\n      });\n      if (res.ok) {\n        const result = await res.json();\n        setExecutionMessage(`Execution successful (${(result.execution.durationMs / 1000).toFixed(2)}s). Job #${result.job.id} created!`);\n        if (result.job) {\n          onSelectJob(result.job);\n        }\n        setTimeout(() => setExecutionMessage(null), 5000);\n      }\n    } catch (e) {\n      console.error(\"Workflow execution error:\", e);\n      setExecutionMessage(\"Execution failed. Check backend logs.\");\n    } finally {\n      setIsExecutingWorkflow(false);\n    }\n  };\n\n  // Pan interaction handlers\n  const handleMouseDown = (e: React.MouseEvent) => {\n    if ((e.target as HTMLElement).closest(\".n8n-node-card\") || (e.target as HTMLElement).closest(\"button\") || (e.target as HTMLElement).closest(\"input\")) {\n      return;\n    }\n    setIsPanning(true);\n    setStartPan({ x: e.clientX - pan.x, y: e.clientY - pan.y });\n  };\n\n  const handleMouseMove = (e: React.MouseEvent) => {\n    if (!isPanning) return;\n    setPan({\n      x: e.clientX - startPan.x,\n      y: e.clientY - startPan.y\n    });\n  };\n\n  const handleMouseUp = () => {\n    setIsPanning(false);\n  };\n\n  // Icon Resolver\n  const renderNodeIcon = (iconName: string) => {\n    switch (iconName) {\n      case \"Send\": return <Send className=\"w-4 h-4 text-emerald-400\" />;\n      case \"GitFork\": return <GitFork className=\"w-4 h-4 text-sky-400\" />;\n      case \"DownloadCloud\": return <DownloadCloud className=\"w-4 h-4 text-blue-400\" />;\n      case \"Mic\": return <Mic className=\"w-4 h-4 text-purple-400\" />;\n      case \"FileText\": return <FileText className=\"w-4 h-4 text-amber-400\" />;\n      case \"FileSpreadsheet\": return <FileSpreadsheet className=\"w-4 h-4 text-cyan-400\" />;\n      case \"Bot\": return <Bot className=\"w-5 h-5 text-rose-400\" />;\n      case \"Code\": return <Code className=\"w-4 h-4 text-emerald-400\" />;\n      case \"Database\": return <Database className=\"w-4 h-4 text-amber-400\" />;\n      case \"AlertTriangle\": return <AlertTriangle className=\"w-4 h-4 text-rose-400\" />;\n      case \"Cpu\": return <Cpu className=\"w-4 h-4 text-sky-400\" />;\n      case \"Brain\": return <Brain className=\"w-4 h-4 text-violet-400\" />;\n      case \"Compass\": return <Compass className=\"w-4 h-4 text-teal-400\" />;\n      case \"Video\": return <Video className=\"w-4 h-4 text-rose-400\" />;\n      case \"Search\": return <Search className=\"w-4 h-4 text-sky-400\" />;\n      case \"FileCode\": return <FileCode className=\"w-4 h-4 text-indigo-400\" />;\n      case \"PenTool\": return <PenTool className=\"w-4 h-4 text-amber-400\" />;\n      case \"Bookmark\": return <Bookmark className=\"w-4 h-4 text-orange-400\" />;\n      case \"UserCheck\": return <UserCheck className=\"w-4 h-4 text-pink-400\" />;\n      case \"Palette\": return <Palette className=\"w-4 h-4 text-pink-400\" />;\n      case \"Sparkles\": return <Sparkles className=\"w-4 h-4 text-amber-300\" />;\n      case \"Image\": return <ImageIcon className=\"w-4 h-4 text-purple-400\" />;\n      case \"Clapperboard\": return <Clapperboard className=\"w-4 h-4 text-yellow-400\" />;\n      case \"Film\": return <Film className=\"w-4 h-4 text-blue-400\" />;\n      case \"Volume2\": return <Volume2 className=\"w-4 h-4 text-cyan-400\" />;\n      case \"Layers\": return <Layers className=\"w-4 h-4 text-indigo-400\" />;\n      case \"Eye\": return <Eye className=\"w-4 h-4 text-sky-400\" />;\n      case \"ShieldCheck\": return <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />;\n      case \"CheckCircle\": return <CheckCircle2 className=\"w-4 h-4 text-teal-400\" />;\n      case \"Globe\": return <Globe className=\"w-4 h-4 text-emerald-400\" />;\n      case \"TrendingUp\": return <TrendingUp className=\"w-4 h-4 text-green-400\" />;\n      case \"Repeat\": return <Repeat className=\"w-4 h-4 text-cyan-400\" />;\n      default: return <Bot className=\"w-4 h-4 text-sky-400\" />;\n    }\n  };\n\n  // Calculate SVG spline bezier path between two nodes\n  const calculatePath = (fromNode: WorkflowNode, toNode: WorkflowNode, type: \"main\" | \"dashed\" | \"subpin\") => {\n    let startX = fromNode.x + (fromNode.width || 180);\n    let startY = fromNode.y + ((fromNode.height || 74) / 2);\n\n    let endX = toNode.x;\n    let endY = toNode.y + ((toNode.height || 74) / 2);\n\n    // If subpin from bottom of AI Agent\n    if (type === \"subpin\") {\n      startX = fromNode.x + ((fromNode.width || 220) / 2);\n      startY = fromNode.y + (fromNode.height || 100);\n      endX = toNode.x + ((toNode.width || 180) / 2);\n      endY = toNode.y;\n\n      const deltaY = endY - startY;\n      const cp1X = startX;\n      const cp1Y = startY + deltaY * 0.5;\n      const cp2X = endX;\n      const cp2Y = endY - deltaY * 0.5;\n      return `M ${startX} ${startY} C ${cp1X} ${cp1Y}, ${cp2X} ${cp2Y}, ${endX} ${endY}`;\n    }\n\n    if (type === \"dashed\") {\n      startX = fromNode.x + ((fromNode.width || 180) / 2);\n      startY = fromNode.y + (fromNode.height || 74);\n      endX = toNode.x + ((toNode.width || 180) / 2);\n      endY = toNode.y;\n\n      const deltaY = endY - startY;\n      return `M ${startX} ${startY} C ${startX} ${startY + deltaY * 0.5}, ${endX} ${endY - deltaY * 0.5}, ${endX} ${endY}`;\n    }\n\n    // Normal horizontal spline\n    const deltaX = Math.abs(endX - startX);\n    const cp1X = startX + deltaX * 0.5;\n    const cp1Y = startY;\n    const cp2X = endX - deltaX * 0.5;\n    const cp2Y = endY;\n\n    return `M ${startX} ${startY} C ${cp1X} ${cp1Y}, ${cp2X} ${cp2Y}, ${endX} ${endY}`;\n  };\n\n  return (\n    <div className=\"flex-1 flex flex-col h-full min-h-0 bg-[#0c0f17] text-slate-100 overflow-hidden font-sans select-none relative\">\n      {/* ============================================================ */}\n      {/* AUTHENTIC n8n WORKFLOW TOP BAR (matching screenshot)        */}\n      {/* ============================================================ */}\n      <div className=\"h-12 bg-[#10131d] border-b border-[#1c2436] px-4 flex items-center justify-between z-30 shrink-0 select-none\">\n        {/* Left Brand Mark & Workflow Name */}\n        <div className=\"flex items-center gap-3\">\n          {/* Coral red n8n mark */}\n          <div className=\"w-6 h-6 rounded-md bg-[#ea4b71] flex items-center justify-center font-black text-white text-xs shadow-sm\">\n            n8n\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold text-white tracking-wide\">\n              CONTENT-FACTORY \342\200\224 Autonomous Free-Tier Media Pipeline\n            </span>\n            <span className=\"hidden md:inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono\">\n              <Check className=\"w-3 h-3\" /> Saved\n            </span>\n            <span className=\"hidden lg:inline-flex text-[10px] px-2 py-0.5 rounded-full bg-[#1b2538] text-slate-300 font-mono\">\n              free-tier-stack\n            </span>\n            <span className=\"hidden lg:inline-flex text-[10px] px-2 py-0.5 rounded-full bg-[#1b2538] text-slate-300 font-mono\">\n              v2.4\n            </span>\n          </div>\n        </div>\n\n        {/* Center: View Switcher (Editor vs Executions) */}\n        <div className=\"flex items-center bg-[#0a0d14] border border-[#1b2436] rounded-xl p-0.5 text-xs\">\n          <button\n            onClick={() => setCanvasViewMode(\"editor\")}\n            className={`px-4 py-1 rounded-lg font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n              canvasViewMode === \"editor\" \n                ? \"bg-[#1e293e] text-white shadow-sm\" \n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5 text-coral-400\" />\n            Editor\n          </button>\n          <button\n            onClick={() => setCanvasViewMode(\"executions\")}\n            className={`px-4 py-1 rounded-lg font-semibold transition cursor-pointer flex items-center gap-1.5 ${\n              canvasViewMode === \"executions\" \n                ? \"bg-[#1e293e] text-white shadow-sm\" \n                : \"text-slate-400 hover:text-slate-200\"\n            }`}\n          >\n            <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Executions\n          </button>\n        </div>\n\n        {/* Right Action Controls */}\n        <div className=\"flex items-center gap-2.5\">\n          {/* Free Tier Reference Button */}\n          <button\n            onClick={() => setIsFreeTierModalOpen(true)}\n            className=\"px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer\"\n          >\n            <Zap className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Free Tier Stack</span>\n          </button>\n\n          {/* Active / Inactive Toggle Switch */}\n          <div className=\"flex items-center gap-2 px-2.5 py-1 rounded-lg bg-[#0a0d14] border border-[#1b2436]\">\n            <span className={`text-[11px] font-bold ${isWorkflowActive ? \"text-emerald-400\" : \"text-slate-400\"}`}>\n              {isWorkflowActive ? \"Active\" : \"Inactive\"}\n            </span>\n            <button\n              onClick={() => setIsWorkflowActive(!isWorkflowActive)}\n              className={`w-8 h-4.5 rounded-full p-0.5 transition cursor-pointer flex items-center ${\n                isWorkflowActive ? \"bg-emerald-500 justify-end\" : \"bg-slate-700 justify-start\"\n              }`}\n            >\n              <div className=\"w-3.5 h-3.5 rounded-full bg-white shadow-sm\" />\n            </button>\n          </div>\n\n          {/* Star GitHub Badge (matching screenshot) */}\n          <div className=\"hidden xl:flex items-center gap-1 text-[11px] px-2.5 py-1 rounded-lg bg-[#141a27] border border-[#202c42] text-slate-300 font-medium\">\n            <Star className=\"w-3.5 h-3.5 text-amber-400 fill-amber-400\" />\n            <span>Star</span>\n            <span className=\"font-mono text-slate-400\">51,309</span>\n          </div>\n        </div>\n      </div>\n\n      {/* ============================================================ */}\n      {/* MAIN CONTENT AREA: WORKFLOW CANVAS OR EXECUTIONS VIEW        */}\n      {/* ============================================================ */}\n      {canvasViewMode === \"executions\" ? (\n        <WorkflowExecutionsView\n          onRunWorkflow={() => handleExecuteWorkflow()}\n          isRunning={isExecutingWorkflow}\n        />\n      ) : (\n        <div \n          className=\"flex-1 relative overflow-hidden cursor-grab active:cursor-grabbing bg-[#0b0e17]\"\n          onMouseDown={handleMouseDown}\n          onMouseMove={handleMouseMove}\n          onMouseUp={handleMouseUp}\n          onMouseLeave={handleMouseUp}\n        >\n          {/* Subtle n8n Dot Matrix Canvas Background */}\n          <svg className=\"absolute inset-0 w-full h-full pointer-events-none opacity-20\">\n            <defs>\n              <pattern id=\"dotPattern\" width=\"24\" height=\"24\" patternUnits=\"userSpaceOnUse\">\n                <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"#475569\" />\n              </pattern>\n            </defs>\n            <rect width=\"100%\" height=\"100%\" fill=\"url(#dotPattern)\" />\n          </svg>\n\n          {/* Canvas Transform Container */}\n          <div \n            className=\"absolute transition-transform duration-75 origin-top-left\"\n            style={{\n              transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,\n              width: \"2400px\",\n              height: \"1200px\"\n            }}\n          >\n            {/* SVG Connector Splines Layer */}\n            <svg className=\"absolute inset-0 w-full h-full pointer-events-none\" style={{ overflow: \"visible\" }}>\n              <defs>\n                <linearGradient id=\"mainFlowGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                  <stop offset=\"0%\" stopColor=\"#ea4b71\" />\n                  <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                </linearGradient>\n                <linearGradient id=\"subpinGradient\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                  <stop offset=\"0%\" stopColor=\"#a855f7\" />\n                  <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                </linearGradient>\n              </defs>\n\n              {edges.map(edge => {\n                const fromNode = nodes.find(n => n.id === edge.fromNode);\n                const toNode = nodes.find(n => n.id === edge.toNode);\n                if (!fromNode || !toNode) return null;\n\n                const pathData = calculatePath(fromNode, toNode, edge.type || \"main\");\n\n                const strokeColor = edge.type === \"subpin\" \n                  ? \"#a855f7\" \n                  : edge.type === \"dashed\" \n                    ? \"#38bdf8\" \n                    : \"#ea4b71\";\n\n                const isDashed = edge.type === \"dashed\" || edge.type === \"subpin\";\n\n                return (\n                  <g key={edge.id}>\n                    {/* Glow backdrop */}\n                    <path\n                      d={pathData}\n                      fill=\"none\"\n                      stroke={strokeColor}\n                      strokeWidth={edge.type === \"main\" ? \"3\" : \"2\"}\n                      strokeOpacity={edge.type === \"main\" ? \"0.6\" : \"0.4\"}\n                      strokeDasharray={isDashed ? \"5,5\" : undefined}\n                    />\n                    {/* Animated running pulse */}\n                    {(isExecutingWorkflow || isAdvancing) && (\n                      <circle r=\"3\" fill=\"#ffffff\">\n                        <animateMotion\n                          path={pathData}\n                          dur=\"2.5s\"\n                          repeatCount=\"indefinite\"\n                        />\n                      </circle>\n                    )}\n                  </g>\n                );\n              })}\n            </svg>\n\n            {/* Nodes Render Layer */}\n            {nodes.map(node => {\n              const isCentralAgent = node.category === \"agent\";\n              const isSubAgent = node.category === \"subagent\";\n              const isTrigger = node.category === \"trigger\";\n              const isModel = node.category === \"model\";\n              const isTool = node.category === \"tool\";\n\n              return (\n                <div\n                  key={node.id}\n                  id={`workflow-node-${node.id}`}\n                  onClick={() => setInspectedNode(node)}\n                  className={`n8n-node-card absolute rounded-xl border transition-all duration-150 cursor-pointer shadow-xl flex flex-col justify-between p-3 select-none ${\n                    isCentralAgent\n                      ? \"bg-gradient-to-br from-[#1d1628] to-[#121626] border-purple-500/60 ring-2 ring-purple-500/20 w-[220px] h-[100px] hover:border-purple-400\"\n                      : isSubAgent\n                        ? \"bg-[#141b2b] border-[#293b58] w-[190px] h-[78px] hover:border-sky-400 hover:bg-[#182337]\"\n                        : isModel\n                          ? \"bg-[#131a29] border-[#283854] w-[170px] h-[70px] hover:border-blue-400\"\n                          : isTool\n                            ? \"bg-[#101622] border-[#202c42] w-[170px] h-[70px] hover:border-teal-400\"\n                            : \"bg-[#141b2a] border-[#24334a] w-[180px] h-[74px] hover:border-slate-300\"\n                  }`}\n                  style={{\n                    left: `${node.x}px`,\n                    top: `${node.y}px`\n                  }}\n                >\n                  {/* Node Header Row */}\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className={`w-6 h-6 rounded-lg flex items-center justify-center ${\n                        isCentralAgent ? \"bg-purple-500/20 border border-purple-500/40 text-purple-300\" :\n                        isSubAgent ? \"bg-sky-500/20 border border-sky-500/40 text-sky-300\" :\n                        isModel ? \"bg-blue-500/20 border border-blue-500/40 text-blue-300\" :\n                        isTool ? \"bg-teal-500/20 border border-teal-500/40 text-teal-300\" :\n                        \"bg-slate-800 border border-slate-700 text-slate-300\"\n                      }`}>\n                        {renderNodeIcon(node.iconName)}\n                      </div>\n                      <span className=\"text-xs font-bold text-white tracking-wide truncate max-w-[120px]\">\n                        {node.label}\n                      </span>\n                    </div>\n\n                    {/* Status or Active Badge */}\n                    {node.freeTierInfo?.isConfigured && (\n                      <span className=\"w-2 h-2 rounded-full bg-emerald-400 shadow-sm\" title=\"Configured / Active\" />\n                    )}\n                  </div>\n\n                  {/* Node Subtitle */}\n                  <div className=\"flex items-center justify-between text-[11px] text-slate-400\">\n                    <span className=\"truncate max-w-[130px] font-mono text-[10px]\">\n                      {node.subtitle}\n                    </span>\n                    <span className=\"text-[9px] uppercase font-mono px-1 rounded bg-slate-900/60 text-slate-400 border border-slate-800\">\n                      {node.category}\n                    </span>\n                  </div>\n\n                  {/* Left Input Port Dot */}\n                  {node.inputs && node.inputs.length > 0 && (\n                    <div \n                      className=\"absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-slate-300 border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                      title=\"Input Port\"\n                    />\n                  )}\n\n                  {/* Right Output Port Dot */}\n                  {node.outputs && node.outputs.length > 0 && (\n                    <div \n                      className=\"absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-[#ea4b71] border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                      title=\"Output Port\"\n                    />\n                  )}\n\n                  {/* AI Agent Bottom Sub-Pins (matching screenshot) */}\n                  {isCentralAgent && (\n                    <div className=\"absolute -bottom-3 left-0 right-0 flex items-center justify-around px-2 pointer-events-none\">\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-purple-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-purple-300 mt-0.5\">Model</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-violet-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-violet-300 mt-0.5\">Think</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-sky-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-sky-300 mt-0.5\">Memory</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-teal-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-teal-300 mt-0.5\">Tools</span>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n\n          {/* ============================================================ */}\n          {/* FLOATING ZOOM & CANVAS TOOLBAR (Bottom Left)                */}\n          {/* ============================================================ */}\n          <div className=\"absolute bottom-5 left-5 z-20 flex items-center gap-1 p-1 bg-[#10141f]/90 border border-[#222d42] rounded-xl shadow-2xl backdrop-blur-md\">\n            <button\n              onClick={() => {\n                setZoom(0.85);\n                setPan({ x: 30, y: 10 });\n              }}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Fit to Screen\"\n            >\n              <Maximize2 className=\"w-4 h-4\" />\n            </button>\n            <div className=\"w-px h-4 bg-slate-800\" />\n            <button\n              onClick={() => setZoom(prev => Math.max(0.4, prev - 0.1))}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Zoom Out\"\n            >\n              <Minus className=\"w-4 h-4\" />\n            </button>\n            <span className=\"font-mono text-xs text-slate-300 px-2 font-medium\">\n              {Math.round(zoom * 100)}%\n            </span>\n            <button\n              onClick={() => setZoom(prev => Math.min(1.8, prev + 0.1))}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Zoom In\"\n            >\n              <Plus className=\"w-4 h-4\" />\n            </button>\n            <div className=\"w-px h-4 bg-slate-800\" />\n            <button\n              onClick={() => {\n                setZoom(1.0);\n                setPan({ x: -200, y: -40 });\n              }}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Center AI Agent\"\n            >\n              <Bot className=\"w-4 h-4 text-purple-400\" />\n            </button>\n          </div>\n\n          {/* ============================================================ */}\n          {/* FLOATING PRIMARY EXECUTION BAR (Bottom Center)              */}\n          {/* ============================================================ */}\n          <div className=\"absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 p-1.5 bg-[#10141f]/95 border border-[#243149] rounded-2xl shadow-2xl backdrop-blur-md\">\n            {/* Quick Niche Prompt Input */}\n            <div className=\"flex items-center gap-2 px-3 py-1 bg-[#0b0e17] rounded-xl border border-[#1d273a]\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <input\n                type=\"text\"\n                value={quickPrompt}\n                onChange={e => setQuickPrompt(e.target.value)}\n                placeholder=\"Enter Niche (e.g. Stoic Mindset)...\"\n                className=\"w-48 sm:w-64 bg-transparent text-xs text-white placeholder-slate-500 focus:outline-none\"\n              />\n            </div>\n\n            {/* Big Execute Workflow Button */}\n            <button\n              id=\"execute-workflow-btn\"\n              onClick={() => handleExecuteWorkflow()}\n              disabled={isExecutingWorkflow}\n              className=\"px-5 py-2 rounded-xl bg-gradient-to-r from-[#ea4b71] to-[#d6335a] hover:from-[#f05c80] hover:to-[#e04369] text-white text-xs font-bold shadow-lg transition flex items-center gap-2 cursor-pointer disabled:opacity-50\"\n            >\n              <Play className={`w-3.5 h-3.5 fill-current ${isExecutingWorkflow ? \"animate-pulse\" : \"\"}`} />\n              {isExecutingWorkflow ? \"Executing...\" : \"Execute Workflow\"}\n            </button>\n          </div>\n\n          {/* ============================================================ */}\n          {/* FREE-TIER QUOTA TELEMETRY CHIPS (Top Right)                 */}\n          {/* ============================================================ */}\n          <div className=\"absolute top-4 right-4 z-20 hidden md:flex items-center gap-2 p-2 bg-[#10141f]/90 border border-[#202c42] rounded-xl shadow-xl backdrop-blur-md text-xs\">\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Cpu className=\"w-3.5 h-3.5 text-sky-400\" />\n              Gemini: 15 RPM Free\n            </span>\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Video className=\"w-3.5 h-3.5 text-rose-400\" />\n              YouTube: 10k Units\n            </span>\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Volume2 className=\"w-3.5 h-3.5 text-purple-400\" />\n              Edge-TTS: 100% Free\n            </span>\n          </div>\n\n          {/* Status Message Notification Toast */}\n          {executionMessage && (\n            <div className=\"absolute top-4 left-1/2 -translate-x-1/2 z-30 px-4 py-2 rounded-xl bg-emerald-950/90 border border-emerald-500/50 text-emerald-200 text-xs font-medium shadow-2xl flex items-center gap-2 animate-in fade-in\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n              {executionMessage}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Node Inspector Modal */}\n      {inspectedNode && (\n        <NodeInspectorModal\n          node={inspectedNode}\n          onClose={() => setInspectedNode(null)}\n        />\n      )}\n\n      {/* Free Tier Reference Modal */}\n      <FreeTierReferenceModal\n        isOpen={isFreeTierModalOpen}\n        onClose={() => setIsFreeTierModalOpen(false)}\n      />\n    </div>\n  );\n};\n"
    }
