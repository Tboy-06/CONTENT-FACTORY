    instruction: "Apply Bento Grid styling to Header component"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <header className=\"border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Title */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-600 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-cyan-500/20\">\n              CF\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-extrabold text-lg text-white tracking-tight\">CONTENT-FACTORY</span>\n                <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30\">\n                  9 AGENTS\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 hidden sm:block\">\n                Multi-Agent AI Content Automation Pipeline \342\200\242 10 Stages \342\200\242 HITL\n              </p>\n            </div>\n          </div>\n\n          {/* Center / Right controls */}\n          <div className=\"flex items-center gap-4\">\n            {/* Daily Budget Tracker */}\n            <div className=\"hidden md:flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 rounded-lg px-3 py-1.5 text-xs\">\n              <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <div className=\"flex flex-col\">\n                <div className=\"flex items-center gap-1.5 font-medium\">\n                  <span className=\"text-slate-400\">Budget:</span>\n                  <span className=\"text-emerald-400 font-bold font-mono\">${spent.toFixed(3)}</span>\n                  <span className=\"text-slate-500\">/ ${budget.toFixed(2)}</span>\n                </div>\n                <div className=\"w-24 bg-slate-700 rounded-full h-1 mt-0.5 overflow-hidden\">\n                  <div \n                    className=\"bg-emerald-400 h-full rounded-full transition-all duration-500\" \n                    style={{ width: `${budgetPct}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Telegram Live Badge */}\n            <div className=\"hidden lg:flex items-center gap-2 bg-slate-800/60 border border-slate-700/60 rounded-lg px-2.5 py-1.5 text-xs\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n              <span className=\"text-slate-300 font-medium\">HITL Active</span>\n            </div>\n\n            {/* Create Job CTA */}\n            <button\n              id=\"header-create-job-button\"\n              onClick={onOpenNewJob}\n              className=\"flex items-center gap-1.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-lg shadow-md shadow-cyan-500/20 transition-all cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>New Job</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex space-x-1 overflow-x-auto py-2 border-t border-slate-800/80 scrollbar-none text-xs sm:text-sm\">\n          <button\n            id=\"nav-tab-pipeline\"\n            onClick={() => setActiveTab(\"pipeline\")}\n            className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n              activeTab === \"pipeline\"\n                ? \"bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\"\n                : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n            }`}\n          >\n            <Workflow className=\"w-4 h-4\" />\n            <span>10-Stage Pipeline</span>\n            {vaultData?.metrics.activeJobsCount ? (\n              <span className=\"ml-1 text-[10px] px-1.5 py-0.2 rounded-full bg-cyan-500/20 text-cyan-300 font-mono\">\n                {vaultData.metrics.activeJobsCount}\n              </span>\n            ) : null}\n          </button>\n\n          <button\n            id=\"nav-tab-telegram\"\n            onClick={() => setActiveTab(\"telegram\")}\n            className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n              activeTab === \"telegram\"\n                ? \"bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\"\n                : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n            }`}\n          >\n            <Send className=\"w-4 h-4\" />\n            <span>Telegram HITL Bot</span>\n          </button>\n\n          <button\n            id=\"nav-tab-agents\"\n            onClick={() => setActiveTab(\"agents\")}\n            className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n              activeTab === \"agents\"\n                ? \"bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\"\n                : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n            }`}\n          >\n            <Bot className=\"w-4 h-4\" />\n            <span>9 Agents & Tools</span>\n          </button>\n\n          <button\n            id=\"nav-tab-vault\"\n            onClick={() => setActiveTab(\"vault\")}\n            className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n              activeTab === \"vault\"\n                ? \"bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\"\n                : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n            }`}\n          >\n            <Database className=\"w-4 h-4\" />\n            <span>Vault & Analytics</span>\n          </button>\n\n          <button\n            id=\"nav-tab-code\"\n            onClick={() => setActiveTab(\"code\")}\n            className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n              activeTab === \"code\"\n                ? \"bg-cyan-500/15 text-cyan-300 border border-cyan-500/30\"\n                : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n            }`}\n          >\n            <FileCode className=\"w-4 h-4\" />\n            <span>Backend Codebase & Specs</span>\n          </button>\n        </div>\n      </div>\n    </header>"
        replacement_content: "  return (\n    <header className=\"sticky top-0 z-40 bg-[#09090b]/80 backdrop-blur-md pt-3 pb-1\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6\">\n        <div className=\"bg-[#18181b] border border-[#27272a] rounded-2xl p-4 sm:p-5 shadow-sm\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            {/* Logo & Title */}\n            <div className=\"flex items-center gap-3.5\">\n              <div className=\"w-10 h-10 bg-indigo-600 rounded-lg flex items-center justify-center shadow-[0_0_15px_rgba(79,70,229,0.4)] shrink-0\">\n                <Cpu className=\"w-5 h-5 text-white\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h1 className=\"text-lg sm:text-xl font-bold tracking-tight text-[#fafafa]\">\n                    CONTENT-FACTORY <span className=\"text-indigo-400 font-semibold\">v2.1</span>\n                  </h1>\n                  <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-indigo-500/10 text-indigo-400 border border-indigo-500/20\">\n                    9 AGENTS\n                  </span>\n                </div>\n                <p className=\"text-xs text-zinc-400\">\n                  9 Autonomous Agents Online \342\200\242 10-Stage Pipeline \342\200\242 HITL\n                </p>\n              </div>\n            </div>\n\n            {/* Bento Metrics & Action CTA */}\n            <div className=\"flex items-center flex-wrap gap-4 sm:gap-6 justify-between md:justify-end\">\n              {/* Uptime Bento Pill */}\n              <div className=\"text-left sm:text-right hidden sm:block\">\n                <p className=\"text-[10px] uppercase tracking-widest text-zinc-500 mb-0.5 font-semibold\">Uptime</p>\n                <p className=\"text-sm font-mono text-emerald-400 font-medium\">142:22:09</p>\n              </div>\n\n              {/* Daily Budget Bento Stat */}\n              <div className=\"text-left sm:text-right\">\n                <p className=\"text-[10px] uppercase tracking-widest text-zinc-500 mb-0.5 font-semibold\">Daily Budget</p>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-sm font-mono text-zinc-200 font-medium\">\n                    ${spent.toFixed(2)} <span className=\"text-zinc-500\">/ ${budget.toFixed(2)}</span>\n                  </span>\n                  <div className=\"w-12 sm:w-16 bg-[#09090b] border border-[#27272a] rounded-full h-1.5 overflow-hidden\">\n                    <div \n                      className=\"bg-indigo-500 h-full rounded-full transition-all duration-500\" \n                      style={{ width: `${budgetPct}%` }}\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Telegram HITL status */}\n              <div className=\"hidden lg:flex items-center gap-2 bg-[#09090b] border border-[#27272a] rounded-xl px-3 py-1.5\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n                <span className=\"text-xs text-zinc-300 font-medium\">Telegram HITL</span>\n              </div>\n\n              {/* Create Job CTA */}\n              <button\n                id=\"header-create-job-button\"\n                onClick={onOpenNewJob}\n                className=\"flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl shadow-[0_0_15px_rgba(79,70,229,0.3)] transition-all cursor-pointer\"\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>New Job</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Navigation Tabs */}\n          <div className=\"flex space-x-1.5 overflow-x-auto pt-4 mt-4 border-t border-[#27272a] scrollbar-none text-xs\">\n            <button\n              id=\"nav-tab-pipeline\"\n              onClick={() => setActiveTab(\"pipeline\")}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                activeTab === \"pipeline\"\n                  ? \"bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\"\n                  : \"text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50\"\n              }`}\n            >\n              <Workflow className=\"w-4 h-4\" />\n              <span>Active Pipeline</span>\n              {vaultData?.metrics.activeJobsCount ? (\n                <span className=\"ml-1 text-[10px] px-1.5 py-0.2 rounded-md bg-indigo-500/20 text-indigo-300 font-mono\">\n                  {vaultData.metrics.activeJobsCount}\n                </span>\n              ) : null}\n            </button>\n\n            <button\n              id=\"nav-tab-telegram\"\n              onClick={() => setActiveTab(\"telegram\")}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                activeTab === \"telegram\"\n                  ? \"bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\"\n                  : \"text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50\"\n              }`}\n            >\n              <Send className=\"w-4 h-4\" />\n              <span>Telegram HITL Bot</span>\n            </button>\n\n            <button\n              id=\"nav-tab-agents\"\n              onClick={() => setActiveTab(\"agents\")}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                activeTab === \"agents\"\n                  ? \"bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\"\n                  : \"text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50\"\n              }`}\n            >\n              <Bot className=\"w-4 h-4\" />\n              <span>Fleet Status & Agents</span>\n            </button>\n\n            <button\n              id=\"nav-tab-vault\"\n              onClick={() => setActiveTab(\"vault\")}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                activeTab === \"vault\"\n                  ? \"bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\"\n                  : \"text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50\"\n              }`}\n            >\n              <Database className=\"w-4 h-4\" />\n              <span>Vault & Analytics</span>\n            </button>\n\n            <button\n              id=\"nav-tab-code\"\n              onClick={() => setActiveTab(\"code\")}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                activeTab === \"code\"\n                  ? \"bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\"\n                  : \"text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50\"\n              }`}\n            >\n              <FileCode className=\"w-4 h-4\" />\n              <span>Backend Codebase</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );"
      }
      num_matches: 1
    }
  }
}
