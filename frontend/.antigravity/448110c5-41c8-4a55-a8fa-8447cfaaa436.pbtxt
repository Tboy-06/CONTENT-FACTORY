    instruction: "Render spacious canvas with node hover tooltips, selection rings, and integrate N8nBottomDock directly below canvas"
    replacement_infos {
      original_chunk {
        target_content: "          {/* Canvas Transform Container */}\n          <div \n            className=\"absolute transition-transform duration-75 origin-top-left\"\n            style={{\n              transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,\n              width: \"2400px\",\n              height: \"1200px\"\n            }}\n          >\n            {/* SVG Connector Splines Layer */}\n            <svg className=\"absolute inset-0 w-full h-full pointer-events-none\" style={{ overflow: \"visible\" }}>\n              <defs>\n                <linearGradient id=\"mainFlowGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                  <stop offset=\"0%\" stopColor=\"#ea4b71\" />\n                  <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                </linearGradient>\n                <linearGradient id=\"subpinGradient\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                  <stop offset=\"0%\" stopColor=\"#a855f7\" />\n                  <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                </linearGradient>\n              </defs>\n\n              {edges.map(edge => {\n                const fromNode = nodes.find(n => n.id === edge.fromNode);\n                const toNode = nodes.find(n => n.id === edge.toNode);\n                if (!fromNode || !toNode) return null;\n\n                const pathData = calculatePath(fromNode, toNode, edge.type || \"main\");\n\n                const strokeColor = edge.type === \"subpin\" \n                  ? \"#a855f7\" \n                  : edge.type === \"dashed\" \n                    ? \"#38bdf8\" \n                    : \"#ea4b71\";\n\n                const isDashed = edge.type === \"dashed\" || edge.type === \"subpin\";\n\n                return (\n                  <g key={edge.id}>\n                    {/* Glow backdrop */}\n                    <path\n                      d={pathData}\n                      fill=\"none\"\n                      stroke={strokeColor}\n                      strokeWidth={edge.type === \"main\" ? \"3\" : \"2\"}\n                      strokeOpacity={edge.type === \"main\" ? \"0.6\" : \"0.4\"}\n                      strokeDasharray={isDashed ? \"5,5\" : undefined}\n                    />\n                    {/* Animated running pulse */}\n                    {(isExecutingWorkflow || isAdvancing) && (\n                      <circle r=\"3\" fill=\"#ffffff\">\n                        <animateMotion\n                          path={pathData}\n                          dur=\"2.5s\"\n                          repeatCount=\"indefinite\"\n                        />\n                      </circle>\n                    )}\n                  </g>\n                );\n              })}\n            </svg>\n\n            {/* Nodes Render Layer */}\n            {nodes.map(node => {\n              const isCentralAgent = node.category === \"agent\";\n              const isSubAgent = node.category === \"subagent\";\n              const isTrigger = node.category === \"trigger\";\n              const isModel = node.category === \"model\";\n              const isTool = node.category === \"tool\";\n\n              return (\n                <div\n                  key={node.id}\n                  id={`workflow-node-${node.id}`}\n                  onClick={() => setInspectedNode(node)}\n                  className={`n8n-node-card absolute rounded-xl border transition-all duration-150 cursor-pointer shadow-xl flex flex-col justify-between p-3 select-none ${\n                    isCentralAgent\n                      ? \"bg-gradient-to-br from-[#1d1628] to-[#121626] border-purple-500/60 ring-2 ring-purple-500/20 w-[220px] h-[100px] hover:border-purple-400\"\n                      : isSubAgent\n                        ? \"bg-[#141b2b] border-[#293b58] w-[190px] h-[78px] hover:border-sky-400 hover:bg-[#182337]\"\n                        : isModel\n                          ? \"bg-[#131a29] border-[#283854] w-[170px] h-[70px] hover:border-blue-400\"\n                          : isTool\n                            ? \"bg-[#101622] border-[#202c42] w-[170px] h-[70px] hover:border-teal-400\"\n                            : \"bg-[#141b2a] border-[#24334a] w-[180px] h-[74px] hover:border-slate-300\"\n                  }`}\n                  style={{\n                    left: `${node.x}px`,\n                    top: `${node.y}px`\n                  }}\n                >\n                  {/* Node Header Row */}\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className={`w-6 h-6 rounded-lg flex items-center justify-center ${\n                        isCentralAgent ? \"bg-purple-500/20 border border-purple-500/40 text-purple-300\" :\n                        isSubAgent ? \"bg-sky-500/20 border border-sky-500/40 text-sky-300\" :\n                        isModel ? \"bg-blue-500/20 border border-blue-500/40 text-blue-300\" :\n                        isTool ? \"bg-teal-500/20 border border-teal-500/40 text-teal-300\" :\n                        \"bg-slate-800 border border-slate-700 text-slate-300\"\n                      }`}>\n                        {renderNodeIcon(node.iconName)}\n                      </div>\n                      <span className=\"text-xs font-bold text-white tracking-wide truncate max-w-[120px]\">\n                        {node.label}\n                      </span>\n                    </div>\n\n                    {/* Status or Active Badge */}\n                    {node.freeTierInfo?.isConfigured && (\n                      <span className=\"w-2 h-2 rounded-full bg-emerald-400 shadow-sm\" title=\"Configured / Active\" />\n                    )}\n                  </div>\n\n                  {/* Node Subtitle */}\n                  <div className=\"flex items-center justify-between text-[11px] text-slate-400\">\n                    <span className=\"truncate max-w-[130px] font-mono text-[10px]\">\n                      {node.subtitle}\n                    </span>\n                    <span className=\"text-[9px] uppercase font-mono px-1 rounded bg-slate-900/60 text-slate-400 border border-slate-800\">\n                      {node.category}\n                    </span>\n                  </div>\n\n                  {/* Left Input Port Dot */}\n                  {node.inputs && node.inputs.length > 0 && (\n                    <div \n                      className=\"absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-slate-300 border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                      title=\"Input Port\"\n                    />\n                  )}\n\n                  {/* Right Output Port Dot */}\n                  {node.outputs && node.outputs.length > 0 && (\n                    <div \n                      className=\"absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-[#ea4b71] border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                      title=\"Output Port\"\n                    />\n                  )}\n\n                  {/* AI Agent Bottom Sub-Pins (matching screenshot) */}\n                  {isCentralAgent && (\n                    <div className=\"absolute -bottom-3 left-0 right-0 flex items-center justify-around px-2 pointer-events-none\">\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-purple-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-purple-300 mt-0.5\">Model</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-violet-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-violet-300 mt-0.5\">Think</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-sky-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-sky-300 mt-0.5\">Memory</span>\n                      </div>\n                      <div className=\"flex flex-col items-center\">\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-teal-400 border border-slate-900\" />\n                        <span className=\"text-[8px] font-bold text-teal-300 mt-0.5\">Tools</span>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n\n          {/* ============================================================ */}\n          {/* FLOATING ZOOM & CANVAS TOOLBAR (Bottom Left)                */}\n          {/* ============================================================ */}\n          <div className=\"absolute bottom-5 left-5 z-20 flex items-center gap-1 p-1 bg-[#10141f]/90 border border-[#222d42] rounded-xl shadow-2xl backdrop-blur-md\">\n            <button\n              onClick={() => {\n                setZoom(0.85);\n                setPan({ x: 30, y: 10 });\n              }}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Fit to Screen\"\n            >\n              <Maximize2 className=\"w-4 h-4\" />\n            </button>\n            <div className=\"w-px h-4 bg-slate-800\" />\n            <button\n              onClick={() => setZoom(prev => Math.max(0.4, prev - 0.1))}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Zoom Out\"\n            >\n              <Minus className=\"w-4 h-4\" />\n            </button>\n            <span className=\"font-mono text-xs text-slate-300 px-2 font-medium\">\n              {Math.round(zoom * 100)}%\n            </span>\n            <button\n              onClick={() => setZoom(prev => Math.min(1.8, prev + 0.1))}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Zoom In\"\n            >\n              <Plus className=\"w-4 h-4\" />\n            </button>\n            <div className=\"w-px h-4 bg-slate-800\" />\n            <button\n              onClick={() => {\n                setZoom(1.0);\n                setPan({ x: -200, y: -40 });\n              }}\n              className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n              title=\"Center AI Agent\"\n            >\n              <Bot className=\"w-4 h-4 text-purple-400\" />\n            </button>\n          </div>\n\n          {/* ============================================================ */}\n          {/* FLOATING PRIMARY EXECUTION BAR (Bottom Center)              */}\n          {/* ============================================================ */}\n          <div className=\"absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 p-1.5 bg-[#10141f]/95 border border-[#243149] rounded-2xl shadow-2xl backdrop-blur-md\">\n            {/* Quick Niche Prompt Input */}\n            <div className=\"flex items-center gap-2 px-3 py-1 bg-[#0b0e17] rounded-xl border border-[#1d273a]\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <input\n                type=\"text\"\n                value={quickPrompt}\n                onChange={e => setQuickPrompt(e.target.value)}\n                placeholder=\"Enter Niche (e.g. Stoic Mindset)...\"\n                className=\"w-48 sm:w-64 bg-transparent text-xs text-white placeholder-slate-500 focus:outline-none\"\n              />\n            </div>\n\n            {/* Big Execute Workflow Button */}\n            <button\n              id=\"execute-workflow-btn\"\n              onClick={() => handleExecuteWorkflow()}\n              disabled={isExecutingWorkflow}\n              className=\"px-5 py-2 rounded-xl bg-gradient-to-r from-[#ea4b71] to-[#d6335a] hover:from-[#f05c80] hover:to-[#e04369] text-white text-xs font-bold shadow-lg transition flex items-center gap-2 cursor-pointer disabled:opacity-50\"\n            >\n              <Play className={`w-3.5 h-3.5 fill-current ${isExecutingWorkflow ? \"animate-pulse\" : \"\"}`} />\n              {isExecutingWorkflow ? \"Executing...\" : \"Execute Workflow\"}\n            </button>\n          </div>\n\n          {/* ============================================================ */}\n          {/* FREE-TIER QUOTA TELEMETRY CHIPS (Top Right)                 */}\n          {/* ============================================================ */}\n          <div className=\"absolute top-4 right-4 z-20 hidden md:flex items-center gap-2 p-2 bg-[#10141f]/90 border border-[#202c42] rounded-xl shadow-xl backdrop-blur-md text-xs\">\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Cpu className=\"w-3.5 h-3.5 text-sky-400\" />\n              Gemini: 15 RPM Free\n            </span>\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Video className=\"w-3.5 h-3.5 text-rose-400\" />\n              YouTube: 10k Units\n            </span>\n            <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n              <Volume2 className=\"w-3.5 h-3.5 text-purple-400\" />\n              Edge-TTS: 100% Free\n            </span>\n          </div>\n\n          {/* Status Message Notification Toast */}\n          {executionMessage && (\n            <div className=\"absolute top-4 left-1/2 -translate-x-1/2 z-30 px-4 py-2 rounded-xl bg-emerald-950/90 border border-emerald-500/50 text-emerald-200 text-xs font-medium shadow-2xl flex items-center gap-2 animate-in fade-in\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n              {executionMessage}\n            </div>\n          )}\n        </div>"
        replacement_content: "        <div className=\"flex-1 flex flex-col min-h-0 relative\">\n          <div \n            className=\"flex-1 relative overflow-hidden cursor-grab active:cursor-grabbing bg-[#0b0e17] min-h-[280px]\"\n            onMouseDown={handleMouseDown}\n            onMouseMove={handleMouseMove}\n            onMouseUp={handleMouseUp}\n            onMouseLeave={handleMouseUp}\n          >\n            {/* Subtle n8n Dot Matrix Canvas Background */}\n            <svg className=\"absolute inset-0 w-full h-full pointer-events-none opacity-20\">\n              <defs>\n                <pattern id=\"dotPattern\" width=\"24\" height=\"24\" patternUnits=\"userSpaceOnUse\">\n                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"#475569\" />\n                </pattern>\n              </defs>\n              <rect width=\"100%\" height=\"100%\" fill=\"url(#dotPattern)\" />\n            </svg>\n\n            {/* Canvas Transform Container (Spacious dimensions for wide workflow layout) */}\n            <div \n              className=\"absolute transition-transform duration-75 origin-top-left\"\n              style={{\n                transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,\n                width: \"3600px\",\n                height: \"1400px\"\n              }}\n            >\n              {/* SVG Connector Splines Layer */}\n              <svg className=\"absolute inset-0 w-full h-full pointer-events-none\" style={{ overflow: \"visible\" }}>\n                <defs>\n                  <linearGradient id=\"mainFlowGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#ea4b71\" />\n                    <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                  </linearGradient>\n                  <linearGradient id=\"subpinGradient\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                    <stop offset=\"0%\" stopColor=\"#a855f7\" />\n                    <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                  </linearGradient>\n                </defs>\n\n                {edges.map(edge => {\n                  const fromNode = nodes.find(n => n.id === edge.fromNode);\n                  const toNode = nodes.find(n => n.id === edge.toNode);\n                  if (!fromNode || !toNode) return null;\n\n                  const pathData = calculatePath(fromNode, toNode, edge.type || \"main\");\n\n                  const strokeColor = edge.type === \"subpin\" \n                    ? \"#a855f7\" \n                    : edge.type === \"dashed\" \n                      ? \"#38bdf8\" \n                      : \"#ea4b71\";\n\n                  const isDashed = edge.type === \"dashed\" || edge.type === \"subpin\";\n\n                  return (\n                    <g key={edge.id}>\n                      {/* Glow backdrop */}\n                      <path\n                        d={pathData}\n                        fill=\"none\"\n                        stroke={strokeColor}\n                        strokeWidth={edge.type === \"main\" ? \"3\" : \"2\"}\n                        strokeOpacity={edge.type === \"main\" ? \"0.6\" : \"0.4\"}\n                        strokeDasharray={isDashed ? \"5,5\" : undefined}\n                      />\n                      {/* Animated running pulse */}\n                      {(isExecutingWorkflow || isAdvancing) && (\n                        <circle r=\"3\" fill=\"#ffffff\">\n                          <animateMotion\n                            path={pathData}\n                            dur=\"2.5s\"\n                            repeatCount=\"indefinite\"\n                          />\n                        </circle>\n                      )}\n                    </g>\n                  );\n                })}\n              </svg>\n\n              {/* Nodes Render Layer with Hover & Tap Interactivity */}\n              {nodes.map(node => {\n                const isCentralAgent = node.category === \"agent\";\n                const isSubAgent = node.category === \"subagent\";\n                const isTrigger = node.category === \"trigger\";\n                const isModel = node.category === \"model\";\n                const isTool = node.category === \"tool\";\n                const isSelected = selectedNode?.id === node.id;\n                const isHovered = hoveredNodeId === node.id;\n\n                return (\n                  <div\n                    key={node.id}\n                    id={`workflow-node-${node.id}`}\n                    onMouseEnter={() => setHoveredNodeId(node.id)}\n                    onMouseLeave={() => setHoveredNodeId(null)}\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      setSelectedNode(node);\n                      setIsBottomDockOpen(true);\n                    }}\n                    className={`n8n-node-card absolute rounded-xl border transition-all duration-150 cursor-pointer shadow-xl flex flex-col justify-between p-3 select-none ${\n                      isSelected\n                        ? \"ring-2 ring-sky-400 border-sky-400 shadow-[0_0_24px_rgba(56,189,248,0.35)]\"\n                        : \"\"\n                    } ${\n                      isCentralAgent\n                        ? \"bg-gradient-to-br from-[#1d1628] to-[#121626] border-purple-500/60 ring-1 ring-purple-500/20 w-[230px] h-[104px] hover:border-purple-400\"\n                        : isSubAgent\n                          ? \"bg-[#141b2b] border-[#293b58] w-[190px] h-[78px] hover:border-sky-400 hover:bg-[#182337]\"\n                          : isModel\n                            ? \"bg-[#131a29] border-[#283854] w-[180px] h-[74px] hover:border-blue-400\"\n                            : isTool\n                              ? \"bg-[#101622] border-[#202c42] w-[200px] h-[76px] hover:border-teal-400\"\n                              : \"bg-[#141b2a] border-[#24334a] w-[190px] h-[76px] hover:border-slate-300\"\n                    }`}\n                    style={{\n                      left: `${node.x}px`,\n                      top: `${node.y}px`\n                    }}\n                  >\n                    {/* Node Header Row */}\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className={`w-6 h-6 rounded-lg flex items-center justify-center ${\n                          isCentralAgent ? \"bg-purple-500/20 border border-purple-500/40 text-purple-300\" :\n                          isSubAgent ? \"bg-sky-500/20 border border-sky-500/40 text-sky-300\" :\n                          isModel ? \"bg-blue-500/20 border border-blue-500/40 text-blue-300\" :\n                          isTool ? \"bg-teal-500/20 border border-teal-500/40 text-teal-300\" :\n                          \"bg-slate-800 border border-slate-700 text-slate-300\"\n                        }`}>\n                          {renderNodeIcon(node.iconName)}\n                        </div>\n                        <span className=\"text-xs font-bold text-white tracking-wide truncate max-w-[120px]\">\n                          {node.label}\n                        </span>\n                      </div>\n\n                      <div className=\"flex items-center gap-1.5\">\n                        {/* Status or Active Badge */}\n                        {node.freeTierInfo?.isConfigured && (\n                          <span className=\"w-2 h-2 rounded-full bg-emerald-400 shadow-sm\" title=\"Active & Configured\" />\n                        )}\n                        <button\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            setInspectedNode(node);\n                          }}\n                          className=\"p-1 rounded text-slate-500 hover:text-white hover:bg-slate-800/80 transition\"\n                          title=\"Open Full Screen Inspector\"\n                        >\n                          <ExternalLink className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n                    </div>\n\n                    {/* Node Subtitle */}\n                    <div className=\"flex items-center justify-between text-[11px] text-slate-400\">\n                      <span className=\"truncate max-w-[130px] font-mono text-[10px]\">\n                        {node.subtitle}\n                      </span>\n                      <span className=\"text-[9px] uppercase font-mono px-1 rounded bg-slate-900/60 text-slate-400 border border-slate-800\">\n                        {node.category}\n                      </span>\n                    </div>\n\n                    {/* Left Input Port Dot */}\n                    {node.inputs && node.inputs.length > 0 && (\n                      <div \n                        className=\"absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-slate-300 border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                        title=\"Input Port\"\n                      />\n                    )}\n\n                    {/* Right Output Port Dot */}\n                    {node.outputs && node.outputs.length > 0 && (\n                      <div \n                        className=\"absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-[#ea4b71] border-2 border-[#10131d] shadow-sm hover:scale-125 transition\"\n                        title=\"Output Port\"\n                      />\n                    )}\n\n                    {/* AI Agent Bottom Sub-Pins (matching screenshot) */}\n                    {isCentralAgent && (\n                      <div className=\"absolute -bottom-3 left-0 right-0 flex items-center justify-around px-2 pointer-events-none\">\n                        <div className=\"flex flex-col items-center\">\n                          <div className=\"w-2.5 h-2.5 rounded-full bg-purple-400 border border-slate-900\" />\n                          <span className=\"text-[8px] font-bold text-purple-300 mt-0.5\">Model</span>\n                        </div>\n                        <div className=\"flex flex-col items-center\">\n                          <div className=\"w-2.5 h-2.5 rounded-full bg-violet-400 border border-slate-900\" />\n                          <span className=\"text-[8px] font-bold text-violet-300 mt-0.5\">Think</span>\n                        </div>\n                        <div className=\"flex flex-col items-center\">\n                          <div className=\"w-2.5 h-2.5 rounded-full bg-sky-400 border border-slate-900\" />\n                          <span className=\"text-[8px] font-bold text-sky-300 mt-0.5\">Memory</span>\n                        </div>\n                        <div className=\"flex flex-col items-center\">\n                          <div className=\"w-2.5 h-2.5 rounded-full bg-teal-400 border border-slate-900\" />\n                          <span className=\"text-[8px] font-bold text-teal-300 mt-0.5\">Tools</span>\n                        </div>\n                      </div>\n                    )}\n\n                    {/* Floating Hover Tooltip Mini-Drawer */}\n                    {isHovered && (\n                      <div className=\"absolute left-1/2 -translate-x-1/2 top-full mt-2.5 z-50 w-64 p-2.5 bg-[#0d121e]/98 border border-[#2a3c5a] rounded-xl shadow-2xl backdrop-blur-xl pointer-events-none animate-in fade-in zoom-in-95 duration-150\">\n                        <div className=\"flex items-center justify-between pb-1.5 border-b border-slate-800\">\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className=\"w-2 h-2 rounded-full bg-emerald-400\" />\n                            <span className=\"text-xs font-bold text-white\">{node.label}</span>\n                          </div>\n                          <span className=\"text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-sky-950/80 text-sky-300 border border-sky-800/50\">\n                            {node.category}\n                          </span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-300 mt-1.5 leading-relaxed\">\n                          {getNodeFunctionalitySummary(node)}\n                        </p>\n                        <div className=\"mt-2 pt-1.5 border-t border-slate-800/80 flex items-center justify-between text-[10px] font-mono\">\n                          <span className=\"text-emerald-400 font-medium\">\n                            {node.freeTierInfo?.quotaLimit || \"Free Tier Ready\"}\n                          </span>\n                          <span className=\"text-slate-400\">Click to inspect</span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* ============================================================ */}\n            {/* FLOATING ZOOM & CANVAS TOOLBAR (Bottom Left)                */}\n            {/* ============================================================ */}\n            <div className=\"absolute bottom-5 left-5 z-20 flex items-center gap-1 p-1 bg-[#10141f]/90 border border-[#222d42] rounded-xl shadow-2xl backdrop-blur-md\">\n              <button\n                onClick={() => {\n                  setZoom(0.72);\n                  setPan({ x: 40, y: 30 });\n                }}\n                className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n                title=\"Fit to Screen\"\n              >\n                <Maximize2 className=\"w-4 h-4\" />\n              </button>\n              <div className=\"w-px h-4 bg-slate-800\" />\n              <button\n                onClick={() => setZoom(prev => Math.max(0.35, prev - 0.1))}\n                className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n                title=\"Zoom Out\"\n              >\n                <Minus className=\"w-4 h-4\" />\n              </button>\n              <span className=\"font-mono text-xs text-slate-300 px-2 font-medium\">\n                {Math.round(zoom * 100)}%\n              </span>\n              <button\n                onClick={() => setZoom(prev => Math.min(1.8, prev + 0.1))}\n                className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n                title=\"Zoom In\"\n              >\n                <Plus className=\"w-4 h-4\" />\n              </button>\n              <div className=\"w-px h-4 bg-slate-800\" />\n              <button\n                onClick={() => {\n                  setZoom(0.85);\n                  setPan({ x: -200, y: -40 });\n                }}\n                className=\"p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer\"\n                title=\"Center AI Agent\"\n              >\n                <Bot className=\"w-4 h-4 text-purple-400\" />\n              </button>\n            </div>\n\n            {/* ============================================================ */}\n            {/* FLOATING PRIMARY EXECUTION BAR (Bottom Center)              */}\n            {/* ============================================================ */}\n            <div className=\"absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 p-1.5 bg-[#10141f]/95 border border-[#243149] rounded-2xl shadow-2xl backdrop-blur-md\">\n              {/* Quick Niche Prompt Input */}\n              <div className=\"flex items-center gap-2 px-3 py-1 bg-[#0b0e17] rounded-xl border border-[#1d273a]\">\n                <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n                <input\n                  type=\"text\"\n                  value={quickPrompt}\n                  onChange={e => setQuickPrompt(e.target.value)}\n                  placeholder=\"Enter Niche (e.g. Stoic Mindset)...\"\n                  className=\"w-48 sm:w-64 bg-transparent text-xs text-white placeholder-slate-500 focus:outline-none\"\n                />\n              </div>\n\n              {/* Big Execute Workflow Button */}\n              <button\n                id=\"execute-workflow-btn\"\n                onClick={() => handleExecuteWorkflow()}\n                disabled={isExecutingWorkflow}\n                className=\"px-5 py-2 rounded-xl bg-gradient-to-r from-[#ea4b71] to-[#d6335a] hover:from-[#f05c80] hover:to-[#e04369] text-white text-xs font-bold shadow-lg transition flex items-center gap-2 cursor-pointer disabled:opacity-50\"\n              >\n                <Play className={`w-3.5 h-3.5 fill-current ${isExecutingWorkflow ? \"animate-pulse\" : \"\"}`} />\n                {isExecutingWorkflow ? \"Executing...\" : \"Execute Workflow\"}\n              </button>\n            </div>\n\n            {/* ============================================================ */}\n            {/* FREE-TIER QUOTA TELEMETRY CHIPS (Top Right)                 */}\n            {/* ============================================================ */}\n            <div className=\"absolute top-4 right-4 z-20 hidden md:flex items-center gap-2 p-2 bg-[#10141f]/90 border border-[#202c42] rounded-xl shadow-xl backdrop-blur-md text-xs\">\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n                <Cpu className=\"w-3.5 h-3.5 text-sky-400\" />\n                Gemini: 15 RPM Free\n              </span>\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n                <Video className=\"w-3.5 h-3.5 text-rose-400\" />\n                YouTube: 10k Units\n              </span>\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#141b2a] border border-[#212f47] text-slate-300 font-mono text-[11px]\">\n                <Volume2 className=\"w-3.5 h-3.5 text-purple-400\" />\n                Edge-TTS: 100% Free\n              </span>\n            </div>\n\n            {/* Status Message Notification Toast */}\n            {executionMessage && (\n              <div className=\"absolute top-4 left-1/2 -translate-x-1/2 z-30 px-4 py-2 rounded-xl bg-emerald-950/90 border border-emerald-500/50 text-emerald-200 text-xs font-medium shadow-2xl flex items-center gap-2 animate-in fade-in\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                {executionMessage}\n              </div>\n            )}\n          </div>\n\n          {/* Under-the-Canvas N8n Bottom Dock for Functionality & Outputs */}\n          <N8nBottomDock\n            selectedNode={selectedNode}\n            allNodes={nodes}\n            onSelectNode={(node) => {\n              setSelectedNode(node);\n              setPan({\n                x: Math.max(-2400, Math.min(200, Math.round(-node.x * zoom + 420))),\n                y: Math.max(-1000, Math.min(200, Math.round(-node.y * zoom + 180)))\n              });\n            }}\n            executionSteps={executionSteps}\n            isExecuting={isExecutingWorkflow}\n            onExecuteWorkflow={handleExecuteWorkflow}\n            isOpen={isBottomDockOpen}\n            onToggleOpen={() => setIsBottomDockOpen(!isBottomDockOpen)}\n            onClose={() => setIsBottomDockOpen(false)}\n            dockHeight={dockHeight}\n            onChangeHeight={setDockHeight}\n          />\n        </div>"
      }
      num_matches: 1
    }
  }
}
