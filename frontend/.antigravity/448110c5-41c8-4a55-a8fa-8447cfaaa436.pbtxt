        lines {
          text: "                            path={pathData}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            dur=\"2.5s\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            repeatCount=\"indefinite\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
