# CONTENT-FACTORY Environment Configuration
# ===========================================
# COPY THIS FILE TO .env AND REPLACE ALL "your_*" VALUES
# ===========================================

# ===========================================
# LLM & Vision (Google AI Studio FREE tier)
# ===========================================
# Get from: https://aistudio.google.com/apikey
# Format: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyB1cD3eF5gH7jK9mN1pQ3rS5tU7vW9xY

# Models (use available free-tier models)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-2.5-pro

# ===========================================
# Images
# ===========================================
# Get from: https://www.pexels.com/api/
# Format: 563492ad6f91700001000001XXXXXXXXXXXXXXXX
PEXELS_API_KEY=563492ad6f91700001000001aBcDeFgHiJkLmNoP

# Optional: Local ComfyUI for image generation
IMAGE_PROVIDER=pexels
COMFYUI_URL=http://127.0.0.1:8188

# ===========================================
# Video
# ===========================================
VIDEO_ENGINE=ffmpeg
FFMPEG_PATH=ffmpeg

# ===========================================
# Voice (Edge-TTS - FREE, no key needed)
# ===========================================
TTS_ENGINE=edge
TTS_VOICE=en-US-AriaNeural

# ===========================================
# Posting (Postiz self-hosted - FREE)
# ===========================================
# After running docker-compose up -d and setting up Postiz at http://localhost:3000
# Go to Settings > API and copy your key
# Format: pz_xxxxxxxxxxxxxxxxxxxxxxxx
POSTIZ_URL=http://localhost:3000
POSTIZ_API_KEY=pz_abcdefghijklmnopqrstuvwxyz123456

# ===========================================
# Telegram Bot (REQUIRED)
# ===========================================
# 1. Message @BotFather on Telegram
# 2. Send /newbot
# 3. Follow prompts, copy the token
# Format: 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Your numeric Telegram user ID
# Get from: @userinfobot on Telegram
# Format: 123456789
TELEGRAM_CHAT_ID=123456789

# Comma-separated list of allowed user IDs
# Format: 123456789,987654321
TELEGRAM_ALLOWED_USERS_RAW=123456789,987654321

# ===========================================
# Database
# ===========================================
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./vault.db

# Optional: PostgreSQL for production
# Format: postgresql+asyncpg://user:password@localhost:5432/dbname
POSTGRES_URL=postgresql+asyncpg://postiz:postiz@localhost:5432/content_factory
USE_POSTGRES=false

# ===========================================
# External APIs for Researcher (Optional but recommended)
# ===========================================

# YouTube Data API v3 (REQUIRED for Researcher)
# Get from: Google Cloud Console > APIs & Services > Credentials
# Format: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_API_KEY=AIzaSyC2dE4fG6hJ8kL0mN2pQ4rS6tU8vW0xY

# Tavily Search API (1000 requests/month free)
# Get from: https://tavily.com/
# Format: tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TAVILY_API_KEY=tvly-abcdefghijklmnopqrstuvwxyz123456

# SerpAPI (100 searches/month free)
# Get from: https://serpapi.com/
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERPAPI_KEY=abcdefghijklmnopqrstuvwxyz123456

# Firecrawl (free tier available)
# Get from: https://firecrawl.dev/
# Format: fc-xxxxxxxxxxxxxxxxxxxxxxxx
FIRECRAWL_API_KEY=fc-abcdefghijklmnopqrstuv

# Jina AI Reader (free, no key needed for basic use)
# Get from: https://jina.ai/reader/
JINA_API_KEY=

# ===========================================
# Scheduler
# ===========================================
DAILY_RESEARCH_HOUR=6
PIPELINE_TICK_INTERVAL_MINUTES=5
ANALYTICS_FETCH_HOUR=2

# ===========================================
# Cost Control
# ===========================================
MAX_COST_PER_VIDEO_USD=2.0
DAILY_BUDGET_USD=10.0
MONTHLY_BUDGET_USD=200.0

# ===========================================
# Approval & Automation
# ===========================================
DEFAULT_APPROVAL_MODE=manual
AUTO_APPROVE_AFTER_N_SUCCESS=3

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_JSON=true